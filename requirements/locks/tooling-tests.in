# Test runner and test-time imports of the tooling suite (ADR-1528):
# scripts/ci/suite_registry.py run tooling. docs/requirements.txt is a second
# input of the same lock, so the documentation tests render and build instead
# of skipping. pre-commit is the hook installer scripts/githooks/tests drive;
# mypy is what scripts/git-hooks/test-pre-push-mypy.py runs.
# clang-format is the pre-commit hook's pin (.pre-commit-config.yaml): the
# API generator's format test compares against that version only.
# uv is the lock generator scripts/ci/check_python_floors.py resolves with;
# it must equal uv_version in requirements/locks/manifest.json (tested by
# scripts/ci/tests/test_check_python_floors.py).
clang-format==23.1.3
mypy==2.4.0
pre-commit==4.7.0
pytest-timeout==2.4.0
pyyaml==6.0.3
reuse==6.2.0
semgrep==1.180.0
uv==0.13.4
