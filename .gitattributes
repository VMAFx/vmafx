# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# The model file parser requires LF line endings
*.pkl text eol=lf
*.model text eol=lf
# VMAFx hashes the model JSON bytes as loaded and embeds the built-in models
# byte for byte, so a CRLF checkout changed every model hash on Windows
# (scripts/ci/tests/test_praetor_hashed_files_lf.py).
model/**/*.json text eol=lf

# Tiny-AI model artefacts — stored as inline binary blobs.
#
# 2026-05-15 — the previous `filter=lfs diff=lfs merge=lfs -text` line was
# load-bearing on intent only: the .onnx blobs were never actually pushed
# to LFS storage, so smudge in fresh worktrees produced 130-byte pointer
# text instead of the real binaries, breaking every agent worktree we
# created. Real LFS migration requires `git lfs migrate import` plus a
# master force-push (blocked by branch protection — ADR-0037), so we drop
# the attribute and keep the blobs inline. Future LFS adoption is a
# separate planned operation; see docs/adr/0451 (proposed).
model/tiny/*.onnx binary -filter -diff -merge
model/tiny/*.onnx.sig binary
model/tiny/*.onnx.cert binary

# Raw video (fixtures, fuzz seeds, golden pairs) is binary. A frame with no NUL
# byte (flat grey, for example) is otherwise auto-detected as text, so `git
# diff` emits raw non-UTF-8 bytes and `text=auto` may rewrite CR/LF bytes
# inside a frame.
*.yuv binary
*.y4m binary

# Ffmpeg patch series — diff-friendly text.
ffmpeg-patches/*.patch text eol=lf

# CSV golden fixtures are byte-for-byte expectations, and Python's csv module
# writes CRLF (its default lineterminator). `* text=auto` above would normalise
# those CRs away on commit, so the committed blob stopped matching what the
# renderer emits — the tests still passed in the authoring worktree, which held
# the pre-normalisation bytes, and failed on any fresh checkout. -text disables
# normalisation so the fixture keeps the bytes it asserts.
pkg/benchmark/testdata/*.csv -text

# Append-only bookkeeping files were union-merged here (ADR-0165 / ADR-0221 /
# ADR-0386) until ADR-2197: CHANGELOG.md, docs/adr/README.md, _order.txt and
# docs/rebase-notes.md. A union merge is a local Git driver, and GitHub does
# not apply it, so a pull request that edited one of them showed "conflicting"
# there and its workflows did not start. Since ADR-2197 a pull request edits
# none of them: it adds a fragment (changelog.d/, docs/adr/_index_fragments/,
# docs/rebase-notes.d/), the rendered files are written when pull requests land
# (`make docs-render`), and `scripts/ci/deliverables-check.sh` refuses a pull
# request that edits one. Nothing here is union-merged any more.
#
# Deliberately NOT union either: docs/state.md. Its rows MOVE between the "Open
# bugs" and "Recently closed" sections, so keeping both sides duplicates a row
# and the bug reads as open forever (PR #1322). state.md conflicts stay manual
# so the mover is forced to think.

# Files praetorctl hashes or compares byte for byte, beside the managed block
# below: the archetype sources whose sha256 .standards.lock pins, the policy
# files the effective-policy digest reads, and the agent context that
# `praetorctl compile-context --verify` checks (AGENTS.md, its six compiled
# targets, the persona sources under .agents/ and their four projections).
# `* text=auto` checks a text file out with core.eol, which defaults to the
# platform's ending, so a Windows checkout gets CRLF here even with
# core.autocrlf=false and both checks fail on files nobody edited
# (T-WINDOWS-CRLF-PRAETOR-HASHED-FILES-2026-10-06).
# scripts/ci/tests/test_praetor_hashed_files_lf.py keeps every such file LF.
AGENTS.md text eol=lf
CLAUDE.md text eol=lf
.windsurfrules text eol=lf
.cursor/rules/*.mdc text eol=lf
.github/copilot-instructions.md text eol=lf
.gemini/GEMINI.md text eol=lf
.codex/rules.md text eol=lf
.agents/** text eol=lf
.claude/agents/** text eol=lf
.github/agents/** text eol=lf
.gemini/agents/** text eol=lf
.codex/agents/** text eol=lf
.config/archetypes/** text eol=lf
.standards.yaml text eol=lf
.standards.lock text eol=lf
.standards-baseline.json text eol=lf

# BEGIN praetor managed attributes (praetorctl adopt)
# praetorctl audit hashes these files; keep their checkout bytes the same on every platform.
.devcontainer/Dockerfile.praetor text eol=lf
tools/figures/** text eol=lf
docs/figures/*.ts text eol=lf
docs/assets/figures/* text eol=lf
tools/figures/third_party/interfig/upstream/** -text
# END praetor managed attributes
