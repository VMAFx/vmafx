package controller

import (
	"context"
	"testing"
	"time"

	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
	"k8s.io/apimachinery/pkg/runtime"
	"k8s.io/apimachinery/pkg/types"
	ctrl "sigs.k8s.io/controller-runtime"
	"sigs.k8s.io/controller-runtime/pkg/client/fake"

	vmafxv1 "github.com/VMAFx/vmafx/api/vmafx/v1"
)

// TestReconcile_@KIND@_StubReturnsRequeue verifies the stub reconciler returns
// success + the configured requeue interval and does not mutate the resource.
func TestReconcile_@KIND@_StubReturnsRequeue(t *testing.T) {
	scheme := runtime.NewScheme()
	if err := vmafxv1.AddToScheme(scheme); err != nil {
		t.Fatalf("failed to register scheme: %v", err)
	}

	resource := &vmafxv1.@KIND@{
		ObjectMeta: metav1.ObjectMeta{Name: "test", Namespace: "default"},
	}
	cli := fake.NewClientBuilder().WithScheme(scheme).WithObjects(resource).Build()
	r := &@KIND@Reconciler{Client: cli, Scheme: scheme}

	res, err := r.Reconcile(context.Background(), ctrl.Request{
		NamespacedName: types.NamespacedName{Name: "test", Namespace: "default"},
	})
	if err != nil {
		t.Fatalf("stub reconcile returned error: %v", err)
	}
	if res.RequeueAfter < 1*time.Second {
		t.Fatalf("stub reconcile did not set RequeueAfter; got %v", res.RequeueAfter)
	}
}
