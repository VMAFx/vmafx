{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VMAFX Helm chart values",
  "description": "JSON Schema for deploy/helm/vmafx/values.yaml. Catches typos and invalid enum values at `helm install` / `helm upgrade` / `helm lint` time before they become silent template-rendering bugs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["workload", "image", "gpu"],
  "properties": {
    "nameOverride": {
      "type": "string",
      "description": "Replaces only the chart-name component of resource names. Default: chart name."
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Replaces the entire resource-name prefix. Default: <release>-<chartName>."
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/$defs/imageSpec" },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "leaderElect": { "type": "boolean" },
        "resources": { "$ref": "#/$defs/resourceSpec" },
        "controllerToken": { "$ref": "#/$defs/tokenSecretSpec" }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "description": "vmafx-controller workload: job queue, node API and auth gateway (ADR-1589). One replica while the queue is SQLite; ADR-2350 moves it to PostgreSQL.",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/$defs/imageSpec" },
        "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "grpcPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string" },
            "storageClass": { "type": "string" },
            "existingClaim": { "type": "string" }
          }
        },
        "resources": { "$ref": "#/$defs/resourceSpec" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "env": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
      }
    },
    "image": { "$ref": "#/$defs/imageSpec" },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" } }
      }
    },
    "workload": {
      "type": "string",
      "enum": ["Deployment", "Job", "StatefulSet"],
      "description": "Selects which workload kind the chart renders. Must be one of Deployment, Job, or StatefulSet."
    },
    "deployment": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "strategy": { "type": "object" }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "command": { "type": "array", "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "completions": { "type": "integer", "minimum": 1 },
        "parallelism": { "type": "integer", "minimum": 1 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 }
      }
    },
    "statefulSet": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "updateStrategy": { "type": "object" },
        "podManagementPolicy": {
          "type": "string",
          "enum": ["OrderedReady", "Parallel"]
        },
        "statePVCSize": {
          "type": "string",
          "description": "Size of the per-replica PersistentVolumeClaim for MCP session state (/var/lib/vmafx). Standard Kubernetes quantity string (e.g. 1Gi, 500Mi).",
          "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E|m)?$"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 65535 },
            { "type": "string" }
          ]
        },
        "extraPorts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "port"],
            "properties": {
              "name": { "type": "string" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "targetPort": {
                "oneOf": [
                  { "type": "integer", "minimum": 1, "maximum": 65535 },
                  { "type": "string" }
                ]
              },
              "protocol": { "type": "string", "enum": ["TCP", "UDP", "SCTP"] }
            }
          },
          "description": "Additional named Service ports beyond the primary HTTP port."
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "vendor": {
          "type": "string",
          "enum": ["nvidia", "amd", "intel", "cpu"],
          "description": "Maps to the matching device-plugin resource name. nvidia → nvidia.com/gpu, amd → amd.com/gpu, intel → gpu.intel.com/<intelDriver>, cpu → no device plugin. gpu.resourceName overrides it. Vulkan removed per ADR-0726."
        },
        "intelDriver": {
          "type": "string",
          "enum": ["i915", "xe"],
          "description": "Kernel driver of the Intel GPUs; the Intel device plugin advertises gpu.intel.com/i915 or gpu.intel.com/xe accordingly. Used only when gpu.vendor is intel."
        },
        "resourceName": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?/[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$",
          "description": "Explicit extended-resource name to request (domain/name), overriding vendor and intelDriver; for GPU sharing or MIG resources. Refused with gpu.vendor cpu."
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of GPU units to request from the device plugin. Must be ≥1 when gpu.enabled is true; requesting 0 is a silent no-op on every vendor device plugin (ADR-1047)."
        }
      }
    },
    "resources": { "$ref": "#/$defs/resourceSpec" },
    "env": { "type": "object" },
    "envFrom": { "type": "array" },
    "config": { "type": "object" },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClass": { "type": "string" },
        "accessMode": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]
        },
        "corpus": { "$ref": "#/$defs/volumeSpec" },
        "output": { "$ref": "#/$defs/volumeSpec" },
        "models": { "$ref": "#/$defs/volumeSpec" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "affinity": { "type": "object" },
    "tolerations": { "type": "array" },
    "nodeSelector": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0,
      "description": "How long Kubernetes waits after SIGTERM before sending SIGKILL. Default 60 s. GPU scoring jobs that cannot checkpoint mid-frame should set 300+ s."
    },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "namespace": { "type": "string" },
            "labels": { "type": "object" },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "path": { "type": "string" },
            "scheme": { "type": "string", "enum": ["http", "https"] },
            "honorLabels": { "type": "boolean" }
          }
        }
      }
    },
    "pushgateway": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["http-serve", "mount", "auto"],
          "description": "How vmafx-node reads rclone-remote sources (VMAFX_STORAGE_MODE, pkg/storage). http-serve streams them from a per-job rclone serve http into the scorer; mount reads them from a per-job rclone FUSE mount (needs FUSE in the pod); auto picks mount when FUSE is usable, else http-serve. Local paths and http(s) URLs need no rclone in any mode."
        },
        "mountRoot": {
          "type": "string",
          "description": "Parent directory of mount mode's per-job mount points (VMAFX_STORAGE_MOUNT_ROOT). Empty: the node's temp dir."
        },
        "rclone": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "config": { "type": "string" }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "strategy": {
          "type": "object",
          "description": "Rolling-update strategy for the node Deployment. Default: maxUnavailable:0, maxSurge:1 (zero-disruption, GPU-safe)."
        },
        "grpcPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "gRPC listen port for the vmafx-node server. Must match VMAFX_GRPC_LISTEN env var (default 50052). Used for tcpSocket liveness/readiness probes and the node ClusterIP Service."
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" }
          }
        },
        "controllerAddr": {
          "type": "string",
          "description": "gRPC host:port of the vmafx-controller, rendered as VMAFX_CONTROLLER_ADDR. Empty: the chart's controller when controller.enabled, else the node stays standalone (direct VmafxScoring only)."
        },
        "controllerToken": { "$ref": "#/$defs/tokenSecretSpec" },
        "metricsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Prometheus scrape port exposed by vmafx-node. Updates the Deployment containerPort, the node-metrics Service port, and the NetworkPolicy allow rule. Default: 9090."
        },
        "resources": { "$ref": "#/$defs/resourceSpec" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "volumes": { "type": "array" },
        "volumeMounts": { "type": "array" },
        "fuse": {
          "type": "object",
          "additionalProperties": false,
          "description": "FUSE in the node pods for storage.mode mount (ADR-1593): a FUSE device plugin's extended resource, SYS_ADMIN and DAC_READ_SEARCH in the capability bounding set for the setuid fusermount3, and an optional AppArmor profile.",
          "properties": {
            "enabled": { "type": "boolean" },
            "resourceName": {
              "type": "string",
              "description": "Extended resource a FUSE device plugin advertises for /dev/fuse (squat/generic-device-plugin default domain: devic.es/fuse). Required with enabled."
            },
            "appArmorProfile": {
              "type": "object",
              "additionalProperties": false,
              "description": "Container AppArmor profile; the runtimes' default denies mount. Empty: the runtime default.",
              "properties": {
                "type": { "type": "string", "enum": ["RuntimeDefault", "Unconfined", "Localhost"] },
                "localhostProfile": { "type": "string" }
              }
            }
          }
        },
        "ebpf": {
          "type": "object",
          "additionalProperties": false,
          "description": "eBPF descriptor tracker (VMAFX_EBPF_BYPASS, ADR-1539, ADR-1593). Needs storage.mode mount and node.fuse.enabled; runs the container as UID 0 with BPF, PERFMON and SYS_ADMIN and mounts /sys/kernel/tracing read-only.",
          "properties": {
            "enabled": { "type": "boolean" },
            "mountPrefix": {
              "type": "string",
              "pattern": "^/",
              "maxLength": 255,
              "description": "VMAFX_EBPF_MOUNT_PREFIX: absolute path whose opens are recorded; storage.mountRoot must lie under it and defaults to it."
            }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "description": "PodDisruptionBudget prevents simultaneous eviction of all pods during voluntary disruptions (ADR-1058). Recommended when replicaCount >= 2.",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "pattern": "^[0-9]+%$" }
          ],
          "description": "Minimum number (or percentage) of pods that must remain available. Mutually exclusive with maxUnavailable."
        },
        "maxUnavailable": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "pattern": "^[0-9]+%$" }
          ],
          "description": "Maximum number (or percentage) of pods that may be unavailable. Mutually exclusive with minAvailable."
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "description": "NetworkPolicy default-deny posture with allow-rules (ADR-0930). See values.yaml for the full allow.* matrix.",
      "properties": {
        "enabled": { "type": "boolean" },
        "allow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "controllerToNode": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "nodePort": { "type": "integer", "minimum": 1, "maximum": 65535, "description": "Node gRPC port the controller may reach; defaults to node.grpcPort." }
              }
            },
            "nodeToController": {
              "type": "object",
              "additionalProperties": false,
              "description": "Egress from vmafx-node to the controller's gRPC port, rendered when the nodes have a controller (node.controllerAddr or controller.enabled).",
              "properties": {
                "enabled": { "type": "boolean" },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "podSelector": { "type": "object", "additionalProperties": true },
                "namespaceSelector": { "type": "object", "additionalProperties": true }
              }
            },
            "controllerIngress": {
              "type": "object",
              "additionalProperties": false,
              "description": "Ingress to the controller's HTTP and gRPC ports (controller.enabled).",
              "properties": {
                "enabled": { "type": "boolean" },
                "fromPodSelector": { "type": "object", "additionalProperties": true }
              }
            },
            "operatorToController": {
              "type": "object",
              "additionalProperties": false,
              "description": "Egress from the operator to the controller (GetJob, /healthz).",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "controllerToIdentityProvider": {
              "type": "object",
              "additionalProperties": false,
              "description": "Egress from the controller to the identity providers' JWKS endpoints while auth is on.",
              "properties": {
                "enabled": { "type": "boolean" },
                "ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
                "cidrs": { "type": "array", "items": { "type": "string" } }
              }
            },
            "nodeEgressObjectStore": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
                "cidrs": { "type": "array", "items": { "type": "string" } },
                "except": { "type": "array", "items": { "type": "string" } }
              }
            },
            "operatorToApiserver": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } }
              }
            },
            "serverToApiserver": {
              "type": "object",
              "additionalProperties": false,
              "description": "Allow the controller to read VmafxTenant resources from the kube-apiserver (ADR-1519).",
              "properties": {
                "enabled": { "type": "boolean" },
                "ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } }
              }
            },
            "nodeMetrics": {
              "type": "object",
              "additionalProperties": false,
              "description": "Allow Prometheus to scrape vmafx-node metrics port 9090 (ADR-1058).",
              "properties": {
                "enabled": { "type": "boolean" },
                "fromPodSelector": { "type": "object", "additionalProperties": true }
              }
            },
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "namespaceSelector": { "type": "object", "additionalProperties": true },
                "podSelector": { "type": "object", "additionalProperties": true }
              }
            }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": true,
      "description": "Multi-tenant JWT/OIDC gateway (ADR-0794). additionalProperties:true to accommodate per-tenant oidc and rbac sub-keys without exhaustive enumeration.",
      "properties": {
        "enabled": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "jwksEndpoint": { "type": "string" },
        "issuer": { "type": "string" },
        "audience": { "type": "string" },
        "tenantClaim": { "type": "string" },
        "rolesClaim": { "type": "string" },
        "scoringRoots": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 },
          "description": "Inputs callers may score without a tenant registry (VMAFX_SCORING_ROOTS, ADR-1577); {tenant} becomes the caller's tenant ID; empty refuses every input."
        },
        "tenantSource": { "type": "string", "enum": ["", "kubernetes"] },
        "tenants": { "type": "array" }
      }
    },
    "otelCollector": {
      "type": "object",
      "additionalProperties": true,
      "description": "OpenTelemetry collector sidecar (ADR-0782). additionalProperties:true to allow arbitrary receiver/exporter config blocks.",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/$defs/imageSpec" },
        "otlpGRPCPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "config": { "type": "string" },
        "resources": { "$ref": "#/$defs/resourceSpec" }
      }
    }
  },
  "$defs": {
    "imageSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "resourceSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [{ "type": "string" }, { "type": "integer" }]
          }
        },
        "requests": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [{ "type": "string" }, { "type": "integer" }]
          }
        }
      }
    },
    "tokenSecretSpec": {
      "type": "object",
      "additionalProperties": false,
      "description": "A Secret key holding a bearer token for the controller, mounted read-only and passed as VMAFX_CONTROLLER_TOKEN_FILE.",
      "properties": {
        "secretName": { "type": "string" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "volumeSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string" },
        "mountPath": { "type": "string" },
        "existingClaim": { "type": "string" }
      }
    }
  }
}
