{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VMAFX Helm chart values",
  "description": "JSON Schema for deploy/helm/vmafx/values.yaml. Catches typos and invalid enum values at `helm install` / `helm upgrade` / `helm lint` time before they become silent template-rendering bugs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["workload", "image", "gpu"],
  "properties": {
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/$defs/imageSpec" },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "leaderElect": { "type": "boolean" },
        "resources": { "$ref": "#/$defs/resourceSpec" }
      }
    },
    "image": { "$ref": "#/$defs/imageSpec" },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" } }
      }
    },
    "workload": {
      "type": "string",
      "enum": ["Deployment", "Job", "StatefulSet"],
      "description": "Selects which workload kind the chart renders. Must be one of Deployment, Job, or StatefulSet."
    },
    "deployment": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "strategy": { "type": "object" }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "command": { "type": "array", "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "completions": { "type": "integer", "minimum": 1 },
        "parallelism": { "type": "integer", "minimum": 1 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 }
      }
    },
    "statefulSet": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "updateStrategy": { "type": "object" },
        "podManagementPolicy": {
          "type": "string",
          "enum": ["OrderedReady", "Parallel"]
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 65535 },
            { "type": "string" }
          ]
        },
        "extraPorts": { "type": "array" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor"],
      "properties": {
        "enabled": { "type": "boolean" },
        "vendor": {
          "type": "string",
          "enum": ["nvidia", "amd", "intel", "cpu"],
          "description": "Maps to the matching device-plugin resource key. nvidia → nvidia.com/gpu, amd → amd.com/gpu, intel → gpu.intel.com/i915, cpu → no device plugin. Vulkan removed per ADR-0726."
        },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "resources": { "$ref": "#/$defs/resourceSpec" },
    "env": { "type": "object" },
    "envFrom": { "type": "array" },
    "config": { "type": "object" },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClass": { "type": "string" },
        "accessMode": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]
        },
        "corpus": { "$ref": "#/$defs/volumeSpec" },
        "output": { "$ref": "#/$defs/volumeSpec" },
        "models": { "$ref": "#/$defs/volumeSpec" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "affinity": { "type": "object" },
    "tolerations": { "type": "array" },
    "nodeSelector": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "namespace": { "type": "string" },
            "labels": { "type": "object" },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "path": { "type": "string" },
            "scheme": { "type": "string", "enum": ["http", "https"] },
            "honorLabels": { "type": "boolean" }
          }
        }
      }
    },
    "pushgateway": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["http-serve", "rclone"],
          "description": "vmafx-node asset-fetch mode. http-serve pulls from the controller endpoint; rclone pulls directly from a remote configured via storage.rclone.config."
        },
        "rclone": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "config": { "type": "string" }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" }
          }
        },
        "controllerAddr": { "type": "string" },
        "resources": { "$ref": "#/$defs/resourceSpec" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "volumes": { "type": "array" },
        "volumeMounts": { "type": "array" }
      }
    }
  },
  "$defs": {
    "imageSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "resourceSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [{ "type": "string" }, { "type": "integer" }]
          }
        },
        "requests": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [{ "type": "string" }, { "type": "integer" }]
          }
        }
      }
    },
    "volumeSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string" },
        "mountPath": { "type": "string" },
        "existingClaim": { "type": "string" }
      }
    }
  }
}
