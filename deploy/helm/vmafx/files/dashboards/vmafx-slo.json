      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "((sum(sum_over_time(vmafx:slo_bad_events:rate5m{job=~\"$job\",instance=~\"$instance\",slo=\"score_latency\"}[1h])) or vector(0)) / sum(sum_over_time(vmafx:slo_events:rate5m{job=~\"$job\",instance=~\"$instance\",slo=\"score_latency\"}[1h]))) / (1 - max(vmafx:slo_objective{job=~\"$job\",instance=~\"$instance\",slo=\"score_latency\"}))",
          "instant": true,
          "legendFormat": "burn rate",
          "range": false
        }
      ],
      "title": "Score latency: burn rate, last hour",
      "description": "How many times faster than the objective allows the last hour spent the budget: 1 spends it exactly over 30 days; the fast burn alert fires at 14.4 by default.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 27
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              },
              {
                "value": 6,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "(sum(sum_over_time(vmafx:slo_bad_events:rate5m{job=~\"$job\",instance=~\"$instance\",slo=\"score_latency\"}[1h])) or vector(0)) / sum(sum_over_time(vmafx:slo_events:rate5m{job=~\"$job\",instance=~\"$instance\",slo=\"score_latency\"}[1h]))",
          "instant": false,
          "legendFormat": "bad events",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "(1 - max(vmafx:slo_objective{job=~\"$job\",instance=~\"$instance\",slo=\"score_latency\"}))",
          "instant": false,
          "legendFormat": "error budget",
          "range": true
        }
      ],
      "title": "Score latency: bad events against the budget",
      "description": "Hourly share of bad events (not Score requests that finish within the latency bound) against the error budget: a curve above the budget line spends it faster than 30 days.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    }
