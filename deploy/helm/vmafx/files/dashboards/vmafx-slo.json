        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "((sum(sum_over_time(vmafx:slo_bad_events:rate5m{job=~\"$job\",instance=~\"$instance\",slo=\"job_success\"}[1h])) or vector(0)) / sum(sum_over_time(vmafx:slo_events:rate5m{job=~\"$job\",instance=~\"$instance\",slo=\"job_success\"}[1h]))) / (1 - max(vmafx:slo_objective{job=~\"$job\",instance=~\"$instance\",slo=\"job_success\"}))",
          "instant": true,
          "legendFormat": "burn rate",
          "range": false
        }
      ],
      "title": "Jobs: burn rate, last hour",
      "description": "How many times faster than the objective allows the last hour spent the budget: 1 spends it exactly over 30 days; the fast burn alert fires at 14.4 by default.",
      "transparent": false,
