{
  "uid": "vmafx-slo",
  "title": "VMAFx SLO report",
  "description": "Compliance with the SLO objectives over the dashboard's time range (30 days by default), the error budget left, and its burn rate. The objectives are the rule settings (monitoring.slo); the events are recorded every 5 minutes (vmafx:slo_events:rate5m, vmafx:slo_bad_events:rate5m). Generated from pkg/observability/metricdef by tools/obsgen.",
  "tags": [
    "vmafx"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "1m",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "title": "Jobs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "1 - (sum(sum_over_time(vmafx:slo_bad_events:rate5m{job=~\"$job\",instance=~\"$instance\",slo=\"job_success\"}[$__range])) or vector(0)) / sum(sum_over_time(vmafx:slo_events:rate5m{job=~\"$job\",instance=~\"$instance\",slo=\"job_success\"}[$__range]))",
          "instant": true,
          "legendFormat": "compliance",
          "range": false
        }
      ],
      "title": "Jobs: compliance",
      "description": "Share of controller jobs that complete rather than fail over the time range. Compare it with the objective next to it.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "max(vmafx:slo_objective{job=~\"$job\",instance=~\"$instance\",slo=\"job_success\"})",
          "instant": true,
          "legendFormat": "objective",
          "range": false
        }
      ],
      "title": "Jobs: objective",
      "description": "The objective of the rule settings: the share of controller jobs that complete rather than fail the SLO promises over 30 days.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "1 - ((sum(sum_over_time(vmafx:slo_bad_events:rate5m{job=~\"$job\",instance=~\"$instance\",slo=\"job_success\"}[$__range])) or vector(0)) / sum(sum_over_time(vmafx:slo_events:rate5m{job=~\"$job\",instance=~\"$instance\",slo=\"job_success\"}[$__range]))) / (1 - max(vmafx:slo_objective{job=~\"$job\",instance=~\"$instance\",slo=\"job_success\"}))",
          "instant": true,
          "legendFormat": "budget left",
          "range": false
        }
      ],
      "title": "Jobs: error budget left",
      "description": "Share of the error budget (1 - objective) the time range has left: 100 % is untouched, 0 % spent, below 0 the objective is missed.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
