{
  "uid": "vmafx-nodes",
  "title": "VMAFx Nodes and devices",
  "description": "Worker nodes: backend and vendor, slot use, job outcomes and run time per node, GPU memory and host resources. GPU utilisation from a vendor exporter is in the exporter dashboards. Generated from pkg/observability/metricdef by tools/obsgen.",
  "tags": [
    "vmafx"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "1m",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "title": "Fleet",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "count by (backend, vendor) (vmafx_node_info{job=~\"$job\",instance=~\"$instance\",backend=~\"$backend\"})",
          "instant": true,
          "legendFormat": "{{backend}} ({{vendor}})",
          "range": false
        }
      ],
      "title": "Nodes by backend",
      "description": "Nodes serving /metrics, per backend and GPU vendor.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum(vmafx_node_jobs_running{job=~\"$job\",instance=~\"$instance\"}) / clamp_min(sum(vmafx_node_slots{job=~\"$job\",instance=~\"$instance\"}), 1)",
          "instant": true,
          "legendFormat": "slots in use",
          "range": false
        }
      ],
      "title": "Slots in use",
      "description": "Running controller jobs over configured slots across the selected nodes.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.8,
                "color": "orange"
              },
              {
                "value": 0.95,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum(rate(vmafx_node_jobs_total{job=~\"$job\",instance=~\"$instance\",backend=~\"$backend\",outcome=\"failed\"}[$__rate_interval])) / clamp_min(sum(rate(vmafx_node_jobs_total{job=~\"$job\",instance=~\"$instance\",backend=~\"$backend\"}[$__rate_interval])), 1e-9)",
          "instant": true,
          "legendFormat": "failed",
          "range": false
        }
      ],
      "title": "Node job failures",
      "description": "Share of controller jobs the selected nodes finished as failed over the window.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.01,
                "color": "orange"
              },
              {
                "value": 0.05,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Jobs per node",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum by (instance) (vmafx_node_jobs_running{job=~\"$job\",instance=~\"$instance\"})",
          "instant": false,
          "legendFormat": "{{instance}} running",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum by (instance) (vmafx_node_slots{job=~\"$job\",instance=~\"$instance\"})",
          "instant": false,
          "legendFormat": "{{instance}} slots",
          "range": true
        }
      ],
      "title": "Running jobs and slots by node",
      "description": "Jobs each node runs now against its slot count. A node at its slots is full; one at zero with a queue waiting cannot take the queued backend.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum by (instance, outcome) (rate(vmafx_node_jobs_total{job=~\"$job\",instance=~\"$instance\",backend=~\"$backend\"}[$__rate_interval])) * 60",
          "instant": false,
          "legendFormat": "{{instance}} {{outcome}}",
          "range": true
        }
      ],
      "title": "Jobs per minute by node and outcome",
      "description": "Controller jobs each node finished per minute, by outcome.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "opm",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (backend, le) (rate(vmafx_node_job_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\",backend=~\"$backend\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p50 {{backend}}",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (backend, le) (rate(vmafx_node_job_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\",backend=~\"$backend\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p95 {{backend}}",
          "range": true
        }
      ],
      "title": "Job run time by backend",
      "description": "Time nodes spent on one job, by backend: median and 95th percentile.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (instance, le) (rate(vmafx_node_job_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\",backend=~\"$backend\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "title": "Job run time p95 by node",
      "description": "95th percentile run time per node. One node far above the others of its backend points at that host or its GPU.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Devices and host",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum by (instance, device) (vmafx_node_device_memory_used_bytes{job=~\"$job\",instance=~\"$instance\"}) / clamp_min(sum by (instance, device) (vmafx_node_device_memory_total_bytes{job=~\"$job\",instance=~\"$instance\"}), 1)",
          "instant": false,
          "legendFormat": "{{instance}} {{device}}",
          "range": true
        }
      ],
      "title": "GPU memory in use",
      "description": "Device memory used per GPU, as a share of the device's memory (nvidia-smi on CUDA nodes, amdgpu sysfs on HIP nodes).",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum by (instance) (rate(vmafx_metrics_read_errors_total{job=~\"$job\",instance=~\"$instance\",source=\"device_memory\"}[$__rate_interval])) * 60",
          "instant": false,
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "title": "Device memory reads failing",
      "description": "Failed reads of the GPU memory per node and minute. A node reporting failures has no nvidia-smi or no readable sysfs files, and shows no GPU memory above.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "opm",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum by (instance) (process_resident_memory_bytes{job=~\"$job\",instance=~\"$instance\"})",
          "instant": false,
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "title": "Node process memory",
      "description": "Resident memory of each node process.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum by (instance) (rate(process_cpu_seconds_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "title": "Node process CPU",
      "description": "CPU seconds per second of each node process (1 = one core), the vmaf subprocesses excluded.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "prometheus_datasource",
        "label": "Prometheus data source",
        "skipUrlSync": false,
        "query": "prometheus",
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      },
      {
        "type": "query",
        "name": "job",
        "label": "Job",
        "skipUrlSync": false,
        "query": "label_values(vmafx_node_info, job)",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "definition": "label_values(vmafx_node_info, job)"
      },
      {
        "type": "query",
        "name": "instance",
        "label": "Instance",
        "skipUrlSync": false,
        "query": "label_values(vmafx_node_info{job=~\"$job\"}, instance)",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "definition": "label_values(vmafx_node_info{job=~\"$job\"}, instance)"
      },
      {
        "type": "query",
        "name": "backend",
        "label": "Backend",
        "skipUrlSync": false,
        "query": "label_values(vmafx_node_info{job=~\"$job\"}, backend)",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "definition": "label_values(vmafx_node_info{job=~\"$job\"}, backend)"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys and restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "builtIn": 0,
        "placement": "inControlsMenu",
        "expr": "max by (job, instance, version) (vmafx_build_info{job=~\"$job\",instance=~\"$instance\"}) and on (job, instance) changes(process_start_time_seconds{job=~\"$job\",instance=~\"$instance\"}[5m]) \u003e 0",
        "textFormat": "{{instance}}",
        "titleFormat": "{{job}} {{version}} started",
        "step": "1m"
      }
    ]
  },
  "links": [
    {
      "title": "VMAFx dashboards",
      "type": "dashboards",
      "icon": "",
      "tooltip": "",
      "tags": [
        "vmafx"
      ],
      "asDropdown": true,
      "placement": "inControlsMenu",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    }
  ]
}
