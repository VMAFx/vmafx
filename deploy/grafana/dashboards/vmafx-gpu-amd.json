{
  "uid": "vmafx-gpu-amd",
  "title": "VMAFx GPUs (AMD device metrics exporter)",
  "description": "AMD GPUs of the cluster from AMD's device-metrics-exporter (series of its grafana/dashboard_gpu.json): graphics activity, VRAM, power.",
  "tags": [
    "vmafx",
    "vmafx-exporter-amd"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "1m",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "title": "GPUs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "gpu_gfx_activity{job=~\"$job\",instance=~\"$instance\"}",
          "instant": false,
          "legendFormat": "{{hostname}}[{{gpu_id}}]",
          "range": true
        }
      ],
      "title": "GPU utilisation",
      "description": "Busy time of each GPU, percent. Low while scoring jobs queue for this backend means the nodes, not the GPUs, are the limit.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "gpu_used_vram{job=~\"$job\",instance=~\"$instance\"} / clamp_min(gpu_total_vram{job=~\"$job\",instance=~\"$instance\"}, 1)",
          "instant": false,
          "legendFormat": "{{hostname}}[{{gpu_id}}]",
          "range": true
        }
      ],
      "title": "GPU memory in use",
      "description": "Device memory in use as a share of the device's memory.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "gpu_package_power{job=~\"$job\",instance=~\"$instance\"}",
          "instant": false,
          "legendFormat": "{{hostname}}[{{gpu_id}}]",
          "range": true
        }
      ],
      "title": "Power draw",
      "description": "Package power per GPU.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "prometheus_datasource",
        "label": "Prometheus data source",
        "skipUrlSync": false,
        "query": "prometheus",
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      },
      {
        "type": "query",
        "name": "job",
        "label": "Job",
        "skipUrlSync": false,
        "query": "label_values(gpu_gfx_activity, job)",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "definition": "label_values(gpu_gfx_activity, job)"
      },
      {
        "type": "query",
        "name": "instance",
        "label": "Instance",
        "skipUrlSync": false,
        "query": "label_values(gpu_gfx_activity{job=~\"$job\"}, instance)",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "definition": "label_values(gpu_gfx_activity{job=~\"$job\"}, instance)"
      }
    ]
  },
  "annotations": {},
  "links": [
    {
      "title": "VMAFx dashboards",
      "type": "dashboards",
      "icon": "",
      "tooltip": "",
      "tags": [
        "vmafx"
      ],
      "asDropdown": true,
      "placement": "inControlsMenu",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    }
  ]
}
