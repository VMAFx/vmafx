{
  "uid": "vmafx-logs",
  "title": "VMAFx Logs",
  "description": "Logs of the VMAFx services in Loki, sent over OTLP by the slog bridge: volume per level, errors, and every line of one trace. Generated by tools/obsgen.",
  "tags": [
    "vmafx"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 0,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "1m",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "title": "Volume",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (service_name, severity_text) (count_over_time({service_name=~\"$service\"} [$__auto]))",
          "legendFormat": "{{service_name}} {{severity_text}}",
          "range": true,
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          }
        }
      ],
      "title": "Log lines per minute by service and level",
      "description": "Lines each service logged per minute, per severity. A jump in WARN or ERROR is the first place to look.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "",
          "sort": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (service_name) (count_over_time({service_name=~\"$service\"} | severity_text=\"ERROR\" [$__auto]))",
          "legendFormat": "{{service_name}}",
          "range": true,
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          }
        }
      ],
      "title": "Errors per minute by service",
      "description": "ERROR lines per minute and service.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "",
          "sort": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Lines",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "logs",
      "targets": [
        {
          "expr": "{service_name=~\"$service\"} | severity_text=~\"WARN|ERROR\"",
          "legendFormat": "",
          "range": true,
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          }
        }
      ],
      "title": "Warnings and errors",
      "description": "WARN and ERROR lines of the selected services. Open a line's trace_id field to jump to its trace.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "repeatDirection": "h",
      "options": {
        "showLabels": false,
        "showCommonLabels": false,
        "showTime": true,
        "showLogContextToggle": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": ""
      }
    },
    {
      "type": "logs",
      "targets": [
        {
          "expr": "{service_name=~\"$service\"} | trace_id=\"$trace_id\"",
          "legendFormat": "",
          "range": true,
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          }
        }
      ],
      "title": "Lines of one trace",
      "description": "Every line any service logged under the trace in the Trace ID box: the log side of one request or job.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "repeatDirection": "h",
      "options": {
        "showLabels": false,
        "showCommonLabels": false,
        "showTime": true,
        "showLogContextToggle": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": ""
      }
    },
    {
      "type": "logs",
      "targets": [
        {
          "expr": "{service_name=~\"$service\"}",
          "legendFormat": "",
          "range": true,
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          }
        }
      ],
      "title": "All lines",
      "description": "Every line of the selected services.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "repeatDirection": "h",
      "options": {
        "showLabels": false,
        "showCommonLabels": false,
        "showTime": true,
        "showLogContextToggle": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": ""
      }
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "loki_datasource",
        "label": "Loki data source",
        "skipUrlSync": false,
        "query": "loki",
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      },
      {
        "type": "query",
        "name": "service",
        "label": "Service",
        "skipUrlSync": false,
        "query": "label_values(service_name)",
        "datasource": {
          "type": "loki",
          "uid": "${loki_datasource}"
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "includeAll": true,
        "allValue": "vmafx-.+",
        "regex": "/^vmafx-.*/",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      },
      {
        "type": "textbox",
        "name": "trace_id",
        "label": "Trace ID",
        "skipUrlSync": false,
        "query": "",
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      }
    ]
  },
  "annotations": {},
  "links": [
    {
      "title": "VMAFx dashboards",
      "type": "dashboards",
      "icon": "",
      "tooltip": "",
      "tags": [
        "vmafx"
      ],
      "asDropdown": true,
      "placement": "inControlsMenu",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    }
  ]
}
