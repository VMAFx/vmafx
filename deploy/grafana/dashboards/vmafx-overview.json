{
  "uid": "vmafx-overview",
  "title": "VMAFx Overview",
  "description": "Platform health at a glance: components, queue, throughput, latency, scores and node load. Generated from pkg/observability/metricdef by tools/obsgen.",
  "tags": [
    "vmafx"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "1m",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "title": "Health and queue",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum by (job) (up{job=~\"$job\",instance=~\"$instance\"})",
          "instant": true,
          "legendFormat": "{{job}}",
          "range": false
        }
      ],
      "title": "Components up",
      "description": "Scrape targets of the selected jobs that answered the last scrape, per job. A job below its replica count has a target down.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "max(vmafx_controller_nodes_live{job=~\"$job\",instance=~\"$instance\"}) or vector(0)",
          "instant": true,
          "legendFormat": "nodes",
          "range": false
        }
      ],
      "title": "Live nodes",
      "description": "Nodes registered with the controller and sending heartbeats. Zero means queued jobs cannot run.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum(vmafx_controller_jobs_pending{job=~\"$job\",instance=~\"$instance\",tenant=~\"$tenant\"}) or vector(0)",
          "instant": true,
          "legendFormat": "pending",
          "range": false
        }
      ],
      "title": "Pending jobs",
      "description": "Jobs waiting in the controller queue for a node.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum(vmafx_controller_jobs_running{job=~\"$job\",instance=~\"$instance\",tenant=~\"$tenant\"}) or vector(0)",
          "instant": true,
          "legendFormat": "running",
          "range": false
        }
      ],
      "title": "Running jobs",
      "description": "Jobs assigned to a node and not finished yet.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "max(vmafx_controller_queue_oldest_job_age_seconds{job=~\"$job\",instance=~\"$instance\",tenant=~\"$tenant\"}) or vector(0)",
          "instant": true,
          "legendFormat": "oldest",
          "range": false
        }
      ],
      "title": "Oldest pending job",
      "description": "Age of the oldest job still waiting for a node. It grows when no node can take the work (none live, no matching backend, all slots busy).",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 300,
                "color": "orange"
              },
              {
                "value": 900,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum(rate(vmafx_server_score_errors_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(vmafx_server_score_requests_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])), 1e-9)",
          "instant": true,
          "legendFormat": "errors",
          "range": false
        }
      ],
      "title": "Score request errors",
      "description": "Share of synchronous Score requests (gRPC and POST /v1/score) that failed over the window.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.01,
                "color": "orange"
              },
              {
                "value": 0.05,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Throughput",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum(rate(vmafx_controller_jobs_submitted_total{job=~\"$job\",instance=~\"$instance\",tenant=~\"$tenant\"}[$__rate_interval])) * 60",
          "instant": false,
          "legendFormat": "submitted",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum(rate(vmafx_controller_jobs_completed_total{job=~\"$job\",instance=~\"$instance\",tenant=~\"$tenant\"}[$__rate_interval])) * 60",
          "instant": false,
          "legendFormat": "completed",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum(rate(vmafx_controller_jobs_failed_total{job=~\"$job\",instance=~\"$instance\",tenant=~\"$tenant\"}[$__rate_interval])) * 60",
          "instant": false,
          "legendFormat": "failed",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum(rate(vmafx_controller_jobs_cancelled_total{job=~\"$job\",instance=~\"$instance\",tenant=~\"$tenant\"}[$__rate_interval])) * 60",
          "instant": false,
          "legendFormat": "cancelled",
          "range": true
        }
      ],
      "title": "Jobs per minute",
      "description": "Jobs submitted to the queue and jobs reaching each terminal state, per minute.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "opm",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum by (tenant) (rate(vmafx_controller_jobs_failed_total{job=~\"$job\",instance=~\"$instance\",tenant=~\"$tenant\"}[$__rate_interval])) / clamp_min(sum by (tenant) (rate(vmafx_controller_jobs_failed_total{job=~\"$job\",instance=~\"$instance\",tenant=~\"$tenant\"}[$__rate_interval])) + sum by (tenant) (rate(vmafx_controller_jobs_completed_total{job=~\"$job\",instance=~\"$instance\",tenant=~\"$tenant\"}[$__rate_interval])), 1e-9)",
          "instant": false,
          "legendFormat": "{{tenant}}",
          "range": true
        }
      ],
      "title": "Job failure ratio by tenant",
      "description": "Failed jobs over finished jobs (completed + failed), per tenant.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum by (reason) (increase(vmafx_controller_jobs_requeued_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{reason}}",
          "range": true
        }
      ],
      "title": "Jobs returned to the queue",
      "description": "Running jobs sent back to the queue, by reason: a lost node, a controller restart, or a failed assignment. Repeated node_lost points at unstable nodes.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum(rate(vmafx_server_score_requests_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "requests",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum(rate(vmafx_server_score_errors_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "errors",
          "range": true
        }
      ],
      "title": "Score requests per second",
      "description": "Synchronous Score requests (gRPC Score and POST /v1/score) and the ones that failed.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Latency",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(vmafx_controller_job_queue_wait_seconds_bucket{job=~\"$job\",instance=~\"$instance\",tenant=~\"$tenant\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p50",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vmafx_controller_job_queue_wait_seconds_bucket{job=~\"$job\",instance=~\"$instance\",tenant=~\"$tenant\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p95",
          "range": true
        }
      ],
      "title": "Queue wait",
      "description": "Time from a job's submission until a node took it: median and 95th percentile.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(vmafx_controller_job_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\",tenant=~\"$tenant\",outcome=\"completed\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p50",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vmafx_controller_job_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\",tenant=~\"$tenant\",outcome=\"completed\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p95",
          "range": true
        }
      ],
      "title": "Time to result",
      "description": "Time from a job's submission until it completed: median and 95th percentile.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(vmafx_server_score_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p50",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(vmafx_server_score_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p99",
          "range": true
        }
      ],
      "title": "Score request latency",
      "description": "Duration of synchronous Score requests: median and 99th percentile.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (backend, le) (rate(vmafx_node_job_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p50 {{backend}}",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (backend, le) (rate(vmafx_node_job_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p95 {{backend}}",
          "range": true
        }
      ],
      "title": "Node job run time",
      "description": "Time nodes spent running one job, by backend: median and 95th percentile.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Scores and nodes",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (model, le) (rate(vmafx_quality_score_bucket{job=~\"$job\",instance=~\"$instance\",tenant=~\"$tenant\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "{{model}}",
          "range": true
        }
      ],
      "title": "Median score by model",
      "description": "Median pooled VMAF score of completed jobs and Score requests, per model. A drop without a change of content points at an encoder or pipeline regression.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "sum(vmafx_node_jobs_running{job=~\"$job\",instance=~\"$instance\"}) / clamp_min(sum(vmafx_node_slots{job=~\"$job\",instance=~\"$instance\"}), 1)",
          "instant": false,
          "legendFormat": "slots in use",
          "range": true
        }
      ],
      "title": "Node slot use",
      "description": "Running jobs over configured slots across the selected nodes. Near 1 the nodes are the bottleneck; low with a growing queue, they cannot take the queued backend.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "prometheus_datasource",
        "label": "Prometheus data source",
        "skipUrlSync": false,
        "query": "prometheus",
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      },
      {
        "type": "query",
        "name": "job",
        "label": "Job",
        "skipUrlSync": false,
        "query": "label_values(vmafx_build_info, job)",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "definition": "label_values(vmafx_build_info, job)"
      },
      {
        "type": "query",
        "name": "instance",
        "label": "Instance",
        "skipUrlSync": false,
        "query": "label_values(vmafx_build_info{job=~\"$job\"}, instance)",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "definition": "label_values(vmafx_build_info{job=~\"$job\"}, instance)"
      },
      {
        "type": "query",
        "name": "tenant",
        "label": "Tenant",
        "skipUrlSync": false,
        "query": "label_values(vmafx_controller_jobs_submitted_total{job=~\"$job\"}, tenant)",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "definition": "label_values(vmafx_controller_jobs_submitted_total{job=~\"$job\"}, tenant)"
      }
    ]
  },
  "annotations": {
