#!/usr/bin/env bash
# Compatibility entry point for existing source links. ADR-1241 installs
# regular dispatchers so removing a worktree cannot remove a live hook.
set -euo pipefail
exec pre-commit hook-impl --config=.pre-commit-config.yaml \
  --hook-type pre-push --hook-dir "$(git rev-parse --git-path hooks)" -- "$@"
