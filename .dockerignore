matlab
workspace
python/.tox
.git
.venv
.venv*/
*.mp4
*.yuv
*.mov

# Local-only state — without this the dev-MCP build context can include
# machine-local evidence, recovery bundles, and scratch output.
.workingdir/
.claude/

# Corpora / training data (can exceed 1 TB on developer hosts)
.corpus/
corpus/

# Large testdata subdirs (bbb BigBuckBunny clips, ~4.7 GB)
testdata/bbb/

# PyTorch / AI training run artefacts
runs/

# Build trees — covers both hyphen and underscore variants.
# core/ is the renamed `libvmaf/` source tree (ADR-0700).
build*/
build-*/
build_*/
# Docker cleans a trailing slash off an ignore pattern, so `build*/` also
# matches the root-level file `build-config.env` and drops it from the build
# context — `COPY build-config.env` then fails with "not found". Negate it
# explicitly; the directory exclusions above are unaffected.
!build-config.env
core/build*/
core/build-*/
core/build_*/

# Python virtual environments
.venv*/
*.venv
venv/
.venv/

# Caches
__pycache__/
*.egg-info/
.tox/
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/

# Backup parquets / bench results that aren't source-of-truth
*.bak
*.bak.parquet
testdata/netflix_benchmark_results.json

# OS junk
.DS_Store
Thumbs.db
