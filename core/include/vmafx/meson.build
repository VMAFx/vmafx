# ADR-1852: the VMAFx API headers. Both are generated from core/api/vmafx.toml
# by scripts/codegen/vmafx-api.py; the Meson test
# test_vmafx_api_generated_current fails when they differ from the definition.
install_headers(['vmafx.h', 'libvmaf_bridge.h'], subdir : 'vmafx')
