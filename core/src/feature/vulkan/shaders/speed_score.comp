 *
 * Vulkan compute shader for speed_chroma and speed_temporal feature
 * extractors (ADR-0567).  Real on-device GPU kernels — no CPU forwarding.
 *
 * Algorithm split (ADR-0567 §GPU/CPU split rationale):
 *   GPU (this shader): tile-parallel work over 28–312 tiles per frame.
 *   CPU (speed_internal.h wrappers): serial 25×25 eigendecomp + QR.
 *   Host reads back 625 cov_mat floats + 25×num_blocks indterm floats
 *   between passes 2 and 4 for the CPU linalg step.
 *
 * Single pipeline, 7 pass variants selected by push constant `pass`:
 *   0 — means:        means[elem × num_blocks]
 *   1 — cov:          cov_mat[25 × 25], one WG per (x,y) entry
 *   2 — indterm_ref:  indterm for the reference plane
 *   3 — indterm_dis:  indterm for the distorted plane
 *   4 — solve_ref:    backward substitution for reference solution
 *   5 — solve_dis:    backward substitution for distorted solution
 *   6 — score:        per-tile entropy + variance proxy
 *
 * Dispatch grid per pass (host responsibility):
 *   pass 0:   ceil(num_blocks / 256) × 1 × 1
 *   pass 1:   25 × 25 × 1  (one WG per cov matrix entry)
 *   pass 2/3: ceil(25*num_blocks / 256) × 1 × 1
 *   pass 4/5: num_blocks × 1 × 1  (one WG = 256 threads per column)
 *   pass 6:   ceil(num_blocks / 256) × 1 × 1
 *
 * Bindings (set 0, all passes share the same descriptor set layout):
 *   0  plane[]       — input float plane
 *   1  means[]       — 25 × num_blocks
 *   2  cov_mat[]     — 25 × 25
 *   3  indterm_ref[] — 25 × num_blocks
 *   4  indterm_dis[] — 25 × num_blocks
 *   5  sol_ref[]     — 25 × num_blocks (written by pass 4)
 *   6  sol_dis[]     — 25 × num_blocks (written by pass 5)
 *   7  R_mat[]       — 25 × 25 upper-triangular R factor (written by host)
 *   8  eigenvals[]   — 25 floats (written by host between passes 2 and 4)
 *   9  ref_ent[]     — num_blocks entropy output
 *   10 ref_var[]     — num_blocks variance proxy output
 *   11 dis_ent[]     — num_blocks entropy output
 *   12 dis_var[]     — num_blocks variance proxy output
 *
 * Push constants (set per dispatch):
 *   uint pass         — which pass to run (0-6)
 *   uint num_blocks   — total tile count
 *   uint num_blocks_h — tiles per row
 *   uint submatrix_w  — subblock width (typically 5)
 *   uint submatrix_h  — subblock height (typically 5)
 *   uint stride_px    — float stride of the plane buffer in pixels
 *   float sigma_nn    — neural noise std-dev (used by pass 6 only)
 *
 * Numerical contract:
 *   Covariance accumulation (pass 1) uses float64 shared memory to
 *   match the double-precision accumulators in the CUDA/SYCL/HIP twins.
 *   GL_EXT_shader_explicit_arithmetic_types_float64 is required.
 *   places=4 vs CPU reference (ADR-0214 / ADR-0567).
 */

#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const uint SP_BLOCK_SIZE = 5u;
const uint SP_ELEMENTS   = 25u;

/* ---- Bindings ---- */
layout(set = 0, binding = 0,  std430) readonly  buffer Plane      { float  v[]; } plane;
layout(set = 0, binding = 1,  std430)           buffer Means      { float  v[]; } means_buf;
layout(set = 0, binding = 2,  std430)           buffer CovMat     { float  v[]; } cov_mat;
layout(set = 0, binding = 3,  std430)           buffer IndtermRef { float  v[]; } indterm_ref;
layout(set = 0, binding = 4,  std430)           buffer IndtermDis { float  v[]; } indterm_dis;
layout(set = 0, binding = 5,  std430)           buffer SolRef     { float  v[]; } sol_ref;
layout(set = 0, binding = 6,  std430)           buffer SolDis     { float  v[]; } sol_dis;
layout(set = 0, binding = 7,  std430) readonly  buffer RMat       { float  v[]; } R_mat;
layout(set = 0, binding = 8,  std430) readonly  buffer Eigenvals  { float  v[]; } eigenvalues;
layout(set = 0, binding = 9,  std430)           buffer RefEnt     { float  v[]; } ref_ent;
layout(set = 0, binding = 10, std430)           buffer RefVar     { float  v[]; } ref_var;
layout(set = 0, binding = 11, std430)           buffer DisEnt     { float  v[]; } dis_ent;
layout(set = 0, binding = 12, std430)           buffer DisVar     { float  v[]; } dis_var;

/* ---- Push constants ---- */
layout(push_constant) uniform Params {
    uint  pass;
    uint  num_blocks;
    uint  num_blocks_h;
    uint  submatrix_w;
    uint  submatrix_h;
    uint  stride_px;
    float sigma_nn;
} pc;

/* ---- Shared memory for pass 1 covariance reduction ---- */
shared float64_t s_cov_partial[256];

/* ====================================================================
 * Pass 0: per-tile means
 *   thread = tile index
 * ==================================================================== */
void pass_means()
{
    uint tile_idx = gl_GlobalInvocationID.x;
    if (tile_idx >= pc.num_blocks)
        return;

    uint tile_x = tile_idx % pc.num_blocks_h;
    uint tile_y = tile_idx / pc.num_blocks_h;

    for (uint elem = 0u; elem < SP_ELEMENTS; ++elem) {
        uint er = elem / SP_BLOCK_SIZE;
        uint ec = elem % SP_BLOCK_SIZE;
        uint sr = tile_y * SP_BLOCK_SIZE + er;
        uint sc = tile_x * SP_BLOCK_SIZE + ec;
        float64_t acc = float64_t(0.0);
        for (uint i = 0u; i < pc.submatrix_h; ++i)
            for (uint j = 0u; j < pc.submatrix_w; ++j)
                acc += float64_t(plane.v[(sr + i) * pc.stride_px + (sc + j)]);
        means_buf.v[elem * pc.num_blocks + tile_idx] =
            float(acc / float64_t(pc.submatrix_w * pc.submatrix_h));
    }
}

/* ====================================================================
 * Pass 1: covariance matrix
 *   workgroup (x_idx, y_idx) → cov_mat[x_idx * 25 + y_idx]
 *   256 threads reduce all tiles; result stored by thread 0
 * ==================================================================== */
void pass_cov()
{
    uint x_index = gl_WorkGroupID.x;   /* 0-24 */
    uint y_index = gl_WorkGroupID.y;   /* 0-24 */
    uint tid     = gl_LocalInvocationID.x;

    s_cov_partial[tid] = float64_t(0.0);
    barrier();

    uint xr = x_index / SP_BLOCK_SIZE;
    uint xc = x_index % SP_BLOCK_SIZE;
    uint yr = y_index / SP_BLOCK_SIZE;
    uint yc = y_index % SP_BLOCK_SIZE;

    float64_t local_sum = float64_t(0.0);
    for (uint tile = tid; tile < pc.num_blocks; tile += 256u) {
        uint tx = tile % pc.num_blocks_h;
        uint ty = tile / pc.num_blocks_h;
        float64_t mx = float64_t(means_buf.v[x_index * pc.num_blocks + tile]);
        float64_t my = float64_t(means_buf.v[y_index * pc.num_blocks + tile]);
        uint srx = ty * SP_BLOCK_SIZE + xr;
        uint scx = tx * SP_BLOCK_SIZE + xc;
        uint sry = ty * SP_BLOCK_SIZE + yr;
        uint scy = tx * SP_BLOCK_SIZE + yc;
        float64_t cov = float64_t(0.0);
        for (uint i = 0u; i < pc.submatrix_h; ++i)
            for (uint j = 0u; j < pc.submatrix_w; ++j) {
                float64_t vx = float64_t(plane.v[(srx + i) * pc.stride_px + (scx + j)]);
                float64_t vy = float64_t(plane.v[(sry + i) * pc.stride_px + (scy + j)]);
                cov += (vx - mx) * (vy - my);
            }
        local_sum += cov / float64_t(pc.submatrix_w * pc.submatrix_h);
    }
    s_cov_partial[tid] = local_sum;
    barrier();

    /* Tree reduction over 256 threads. */
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (tid < s)
            s_cov_partial[tid] += s_cov_partial[tid + s];
        barrier();
    }
    if (tid == 0u)
        cov_mat.v[x_index * SP_ELEMENTS + y_index] = float(s_cov_partial[0u]);
}

/* ====================================================================
 * Pass 2: indterm_ref  (one pixel per element per tile)
 * ==================================================================== */
void pass_indterm_ref()
{
    uint idx   = gl_GlobalInvocationID.x;
    uint total = SP_ELEMENTS * pc.num_blocks;
    if (idx >= total)
        return;

    uint elem     = idx / pc.num_blocks;
    uint tile_idx = idx % pc.num_blocks;
    uint tile_x   = tile_idx % pc.num_blocks_h;
    uint tile_y   = tile_idx / pc.num_blocks_h;
    uint er = elem / SP_BLOCK_SIZE;
    uint ec = elem % SP_BLOCK_SIZE;
    uint pr = tile_y * SP_BLOCK_SIZE + er;
    uint pw = tile_x * SP_BLOCK_SIZE + ec;
    indterm_ref.v[elem * pc.num_blocks + tile_idx] = plane.v[pr * pc.stride_px + pw];
}

/* ====================================================================
 * Pass 3: indterm_dis
 * ==================================================================== */
void pass_indterm_dis()
{
    uint idx   = gl_GlobalInvocationID.x;
    uint total = SP_ELEMENTS * pc.num_blocks;
    if (idx >= total)
        return;

    uint elem     = idx / pc.num_blocks;
    uint tile_idx = idx % pc.num_blocks;
    uint tile_x   = tile_idx % pc.num_blocks_h;
    uint tile_y   = tile_idx / pc.num_blocks_h;
    uint er = elem / SP_BLOCK_SIZE;
    uint ec = elem % SP_BLOCK_SIZE;
    uint pr = tile_y * SP_BLOCK_SIZE + er;
    uint pw = tile_x * SP_BLOCK_SIZE + ec;
    indterm_dis.v[elem * pc.num_blocks + tile_idx] = plane.v[pr * pc.stride_px + pw];
}

/* ====================================================================
 * Pass 4: backward substitution for sol_ref
 *   dispatch: num_blocks × 1 × 1 workgroups, 256 threads each
 *   One workgroup per column; threads 0-24 participate, 25-255 idle.
 *   Serial row dependency enforced via barrier() — each row is written
 *   by exactly one thread, then all threads sync before the next row.
 * ==================================================================== */
void pass_solve_ref()
{
    uint col  = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;

    if (col >= pc.num_blocks)
        return;

    for (int i = int(SP_ELEMENTS) - 1; i >= 0; --i) {
        if (lane == uint(i)) {
            float val   = sol_ref.v[uint(i) * pc.num_blocks + col];
            float denom = R_mat.v[uint(i) * SP_ELEMENTS + uint(i)];
            for (uint k = uint(i) + 1u; k < SP_ELEMENTS; ++k)
                val -= sol_ref.v[k * pc.num_blocks + col] * R_mat.v[uint(i) * SP_ELEMENTS + k];
            sol_ref.v[uint(i) * pc.num_blocks + col] = (abs(denom) > 1e-8) ? val / denom : 0.0;
        }
        barrier();
    }
}

/* ====================================================================
 * Pass 5: backward substitution for sol_dis
 * ==================================================================== */
void pass_solve_dis()
{
    uint col  = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;

    if (col >= pc.num_blocks)
        return;

    for (int i = int(SP_ELEMENTS) - 1; i >= 0; --i) {
        if (lane == uint(i)) {
            float val   = sol_dis.v[uint(i) * pc.num_blocks + col];
            float denom = R_mat.v[uint(i) * SP_ELEMENTS + uint(i)];
            for (uint k = uint(i) + 1u; k < SP_ELEMENTS; ++k)
                val -= sol_dis.v[k * pc.num_blocks + col] * R_mat.v[uint(i) * SP_ELEMENTS + k];
            sol_dis.v[uint(i) * pc.num_blocks + col] = (abs(denom) > 1e-8) ? val / denom : 0.0;
        }
        barrier();
    }
}

/* ====================================================================
 * Pass 6: per-tile entropy + variance proxy (ref and dis)
 * ==================================================================== */
void pass_score()
{
    uint tile = gl_GlobalInvocationID.x;
    if (tile >= pc.num_blocks)
        return;

    const float LOG2_E_2PI = log2(2.0 * 3.14159265358979323846 * 2.71828182845904523536);

    float rv = 0.0;
    float dv = 0.0;
    for (uint elem = 0u; elem < SP_ELEMENTS; ++elem) {
        uint idx = elem * pc.num_blocks + tile;
        rv += sol_ref.v[idx] * indterm_ref.v[idx];
        dv += sol_dis.v[idx] * indterm_dis.v[idx];
    }
    rv /= float(SP_ELEMENTS);
    dv /= float(SP_ELEMENTS);
    ref_var.v[tile] = rv;
    dis_var.v[tile] = dv;

    float re = 0.0;
    float de = 0.0;
    for (uint k = 0u; k < SP_ELEMENTS; ++k) {
        float lk = max(0.0, eigenvalues.v[k]);
        re += log2(lk * rv + pc.sigma_nn) + LOG2_E_2PI;
        de += log2(lk * dv + pc.sigma_nn) + LOG2_E_2PI;
    }
    ref_ent.v[tile] = re;
    dis_ent.v[tile] = de;
}

/* ====================================================================
 * Main dispatch
 * ==================================================================== */
void main()
{
    if (pc.pass == 0u) {
        pass_means();
    } else if (pc.pass == 1u) {
        pass_cov();
    } else if (pc.pass == 2u) {
        pass_indterm_ref();
    } else if (pc.pass == 3u) {
        pass_indterm_dis();
    } else if (pc.pass == 4u) {
        pass_solve_ref();
    } else if (pc.pass == 5u) {
        pass_solve_dis();
    } else if (pc.pass == 6u) {
        pass_score();
    }
}
