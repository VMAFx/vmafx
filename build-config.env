# build-config.env — the one place that defines what VMAFx builds with.
#
# Copyright 2026 Lusoris
# SPDX-License-Identifier: BSD-2-Clause-Patent
#
# Fork the repo, edit this file, run `make base-images-sync`, rebuild. Changing
# the Debian generation, the Go release, or a GPU SDK is a one-line edit here
# instead of a hunt through ten Dockerfiles and twelve workflows.
#
# This covers BOTH container base images and toolchain versions, because the
# same version has to agree in both places and it did not. Before this file
# there were three Level Zero versions in the tree at once, ROCm was 7.2.4 in
# one workflow and 7.2.3 in another, and the dev container's oneAPI had frozen
# two years behind the release images. Every one of those was invisible until
# someone diffed two files that nobody diffs.
#
# GitHub Actions cannot `source` a file at parse time, so workflow `run:` steps
# load it with `scripts/ci/load-build-config.sh`, which exports every knob into
# $GITHUB_ENV. Steps then use ${ONEAPI_VERSION} instead of a literal.
#
# Mechanically: no Dockerfile names a base image directly. Each takes it as a
# build argument whose default mirrors the value below, so a plain
# `docker build` still works with no wrapper and CI can override any base with
# `--build-arg`. `make base-images-sync` rewrites those mirrors from this file;
# the gate below fails if they ever drift.
#
# Before this existed the same base was pinned in a dozen Dockerfiles by hand
# and they drifted. Dockerfile.controller and Dockerfile.operator were still
# building on Debian 12 and shipping on distroless-debian12 after everything
# else had moved to Debian 13, and the golang digest quoted in those files'
# header comments did not even match the digest in their own FROM line.
#
# `scripts/ci/check-base-image-single-source.sh` is what keeps it that way: it
# fails when a Dockerfile hardcodes a base instead of taking the ARG, and when a
# pin below drifts from the version knob it is supposed to track.
#
# ---------------------------------------------------------------------------
# TWO TRACKS
#
#   RELEASE_*  what published artifacts are built from and ship on. Moves only
#              on purpose: it changes what users run.
#   DEV_*      the development and CI container. May move ahead of RELEASE_* to
#              shake out a new base early, and is expected to.
#
# Keep both on the same libc generation unless there is a written reason not
# to. A dev container on a different libc than the release image tests the
# wrong thing.
#
# EVERY ENTRY IS DIGEST-PINNED. A tag alone is not a pin -- it moves under you,
# and reproducing a release build six months from now is the entire point.
# Renovate updates the digests in place; see the `docker` manager in
# renovate.json.
# ---------------------------------------------------------------------------


# ============================================================ version knobs ==
# The human-meaningful part of every pin below. The gate asserts each pinned
# tag actually carries the version named here, so these cannot silently drift
# out of agreement with the digests -- the same authoritative-value-plus-drift-
# check shape that scripts/ci/check-default-model-single-source.sh applies to
# the default model.

RELEASE_DEBIAN="13"             # trixie -- release track distro generation
DEV_UBUNTU="26.04"              # dev container + GPU vendor images
GO_VERSION="1.27"
PYTHON_VERSION="3.14"
# The full patch version CI's setup-python pins. PYTHON_VERSION above is the
# minor series the container image tags use (`python:3.14-slim`); this is the
# exact interpreter CI resolves. Keep the series halves equal.
PYTHON_CI_VERSION="3.14.7"

CUDA_VERSION="13.3.1"
CUDA_APT_PACKAGE="cuda-toolkit-13-3"   # apt name for the same release
# ROCm is installed from digest-pinned images, not the apt repo: AMD ships
# through "TheRock" now and repo.radeon.com/rocm/apt/ tops out at 7.2.4
# (ADR-1225), so there is no apt version left to pin.
ROCM_VERSION="10.0.0"


# ================================================================= release ==
# Build stage for the C/C++ tree: needs a real toolchain, so Debian slim rather
# than distroless.
RELEASE_BUILDER_BASE="debian:13-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132"

# Go toolchain. Keep the Debian generation aligned with the runtime below: a
# binary built against a newer glibc will not start on an older one.
RELEASE_GO_BASE="golang:1.27-trixie@sha256:9baa6b4187bbb98d240372a8a235ac0bb6b5ddd52bba1431dc2f7c0705862728"

# Python layer for the server and tooling images.
RELEASE_PYTHON_BASE="python:3.14-slim@sha256:cad9a2c871761c413caa6fdd6441c783451e740a48aaeba60ae62a8b53525ef6"

# Distroless runtimes. `cc` carries glibc, for the C/C++ binaries and anything
# using cgo; `static` is for pure-Go binaries that need no libc at all.
RELEASE_RUNTIME_CC="gcr.io/distroless/cc-debian13:nonroot@sha256:c31ff9abcb1910f3ab25c7957bdaf0bfe12a01eb546e8df2282f1c8f682b606c"
RELEASE_RUNTIME_STATIC="gcr.io/distroless/static-debian13:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7"


# ===================================================================== dev ==
DEV_BASE="ubuntu:26.04@sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b"
DEV_GO_BASE="golang:1.27-trixie@sha256:9baa6b4187bbb98d240372a8a235ac0bb6b5ddd52bba1431dc2f7c0705862728"


# ============================================================== GPU vendors ==
# These are the vendors' own images. The fork does not get to choose their
# distro, which is why this block is Ubuntu while the release track is Debian.
# All three are on 26.04: no image in this file is still on 24.04.

CUDA_BUILDER="nvidia/cuda:13.3.1-devel-ubuntu26.04@sha256:8cf42b8dc4c34d47fb42ffb0923f8a5e363469a7149181c094da336d311bb466"
CUDA_RUNTIME="nvidia/cuda:13.3.1-runtime-ubuntu26.04@sha256:71b55b93449973f2ee6d8024d6dd34853d338a1f007fe07adaaf9a35fd591794"

# ROCm 10.0.0, as landed by ADR-1225. Still on Ubuntu 24.04: AMD publishes a
# rocm/dev-ubuntu-26.04:10.0.0-full too, and moving to it is a one-line edit
# here, but it is a different base image for a GPU SDK and wants its own
# verification rather than riding along in a config change.
ROCM_BUILDER="rocm/dev-ubuntu-24.04:10.0.0-full@sha256:a90cf047f615abe70fbef83c64def0a2d549ef37a39c8ea545430aba4981b374"
ROCM_RUNTIME="rocm/dev-ubuntu-24.04:10.0.0-full@sha256:a90cf047f615abe70fbef83c64def0a2d549ef37a39c8ea545430aba4981b374"

# --- oneAPI ---------------------------------------------------------------
# PINNED TO 2025 ON PURPOSE, FOR ONE MORE PR. The migration to 2026.1 is a
# restructure, not a pin swap, and it is the immediate follow-up to this file.
# What was measured, so the follow-up does not have to re-derive it:
#
# 1. `intel/oneapi-basekit` is a RETIRED repository whose last tag is 2025.3.2.
#    Intel continued the toolkit image under the plain name `intel/oneapi`,
#    which carries 2026.0.0 and 2026.1.0. Watching the retired name makes the
#    toolchain look two years stale when it is not.
#
# 2. The SYCL soname tracks the major version, and it moved:
#
#       compiled by 2025.3.2 -> DT_NEEDED libsycl.so.8   (measured)
#       runtime     2025.3.1 -> ships     libsycl.so.8
#       runtime     2026.0.0 -> ships     libsycl.so.9   (measured)
#       compiled by 2026.1.1 -> DT_NEEDED libsycl.so.9   (measured)
#
#    A 2025-compiled binary cannot load against a 2026 runtime at all. The
#    soname bump IS the ABI break, and it overrides the usual runtime >=
#    compiler ordering rule, which only holds while the soname is stable. Both
#    sides must cross to 2026 together, which is why this is one change and not
#    two independent bumps.
#
# 3. The 2026 pair cannot come from Intel's images. intel/oneapi ships 2026.1.0
#    but intel/oneapi-runtime stops at 2026.0.0, so the runtime would be OLDER
#    than the compiler -- the ordering violation this is meant to remove. Both
#    images are also Ubuntu-only, and Ubuntu 26.04 carries glibc 2.43 while
#    Debian 13 carries 2.41 (measured), so a binary compiled in Intel's image
#    cannot load on the Debian 13 runtime the rest of the release track ships.
#    Installing both compiler and runtime from Intel's apt repo onto Debian 13
#    fixes all three problems at once: same version on both sides, same libc,
#    same distro. Verified: both packages install on debian:13-slim and agree
#    on libsycl.so.9.
#
# So the follow-up replaces these two image pins with ONEAPI_VERSION +
# ONEAPI_APT_REPO and drops the 24.04 exemption in
# scripts/ci/check-base-image-single-source.sh.
# Level Zero loader. Three different versions were in the tree at once: the CI
# SYCL legs built v1.28.0 from source, dev/Containerfile installed 1.32.0 debs,
# and anything using the distro package got Debian's. The loader is the
# dispatch layer between SYCL and the GPU driver, so a version skew here shows
# up as "no device available" rather than as a build error.
LEVEL_ZERO_VERSION="1.32.0"

ONEAPI_BUILDER="intel/oneapi-basekit:2025.3.2-0-devel-ubuntu24.04@sha256:79a5e333ff6f773793d124b78047001c51cbcd53035e5100313abf2f771af95a"
ONEAPI_RUNTIME="intel/oneapi-runtime:2025.3.1-0-devel-ubuntu24.04@sha256:8942e89b6e6e0cd9a4ca26f12fd4b32a2f0dd1de7e631ea59101a183878d660f"


# =========================================================== not from here ==
# docker/dev/*.Dockerfile pin alpine / arch / fedora on purpose: they exist to
# prove the build survives distros the release track does not use, so unifying
# their bases would defeat them. The gate allowlists that directory.
