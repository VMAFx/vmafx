# build-config.env — the one place that defines what VMAFx builds with.
#
# Copyright 2026 Lusoris
# SPDX-License-Identifier: EUPL-1.2
#
# Fork the repo, edit this file, run `make base-images-sync`, rebuild. Changing
# the Debian generation, the Go release, or a GPU SDK is a one-line edit here
# instead of a hunt through ten Dockerfiles and twelve workflows.
#
# This covers BOTH container base images and toolchain versions, because the
# same version has to agree in both places and it did not. Before this file
# there were three Level Zero versions in the tree at once, ROCm was 7.2.4 in
# one workflow and 7.2.3 in another, and the dev container's oneAPI had frozen
# two years behind the release images. Every one of those was invisible until
# someone diffed two files that nobody diffs.
#
# GitHub Actions cannot `source` a file at parse time, so workflow `run:` steps
# load it with `scripts/ci/load-build-config.sh`, which exports every knob into
# $GITHUB_ENV. Steps then use ${ONEAPI_VERSION} instead of a literal.
#
# Mechanically: no Dockerfile names a base image directly. Each takes it as a
# build argument whose default mirrors the value below, so a plain
# `docker build` still works with no wrapper and CI can override any base with
# `--build-arg`. `make base-images-sync` rewrites those mirrors from this file;
# the gate below fails if they ever drift.
#
# Before this existed the same base was pinned in a dozen Dockerfiles by hand
# and they drifted. Dockerfile.controller and Dockerfile.operator were still
# building on Debian 12 and shipping on distroless-debian12 after everything
# else had moved to Debian 13, and the golang digest quoted in those files'
# header comments did not even match the digest in their own FROM line.
#
# `scripts/ci/check-base-image-single-source.sh` is what keeps it that way: it
# fails when a Dockerfile hardcodes a base instead of taking the ARG, and when a
# pin below drifts from the version knob it is supposed to track.
#
# ---------------------------------------------------------------------------
# TWO TRACKS
#
#   RELEASE_*  what published artifacts are built from and ship on. Moves only
#              on purpose: it changes what users run.
#   DEV_*      the development and CI container. May move ahead of RELEASE_* to
#              shake out a new base early, and is expected to.
#
# Keep both on the same libc generation unless there is a written reason not
# to. A dev container on a different libc than the release image tests the
# wrong thing.
#
# EVERY ENTRY IS DIGEST-PINNED. A tag alone is not a pin -- it moves under you,
# and reproducing a release build six months from now is the entire point.
# Renovate updates the digests in place; see the `docker` manager in
# renovate.json.
# ---------------------------------------------------------------------------


# ============================================================ version knobs ==
# The human-meaningful part of every pin below. The gate asserts each pinned
# tag actually carries the version named here, so these cannot silently drift
# out of agreement with the digests -- the same authoritative-value-plus-drift-
# check shape that scripts/ci/check-default-model-single-source.sh applies to
# the default model.

RELEASE_DEBIAN="13"             # trixie -- release track distro generation
DEV_UBUNTU="26.04"              # dev container + GPU vendor images
GO_VERSION="1.27"
PYTHON_VERSION="3.14"
# The full patch version CI's setup-python pins. PYTHON_VERSION above is the
# minor series the container image tags use (`python:3.14-slim`); this is the
# exact interpreter CI resolves. Keep the series halves equal.
PYTHON_CI_VERSION="3.14.8"

# Shared envtest installer and test-control-plane generation (ADR-1231).
# Both Make and Go CI call scripts/ci/setup-envtest.sh; no @latest consumer.
SETUP_ENVTEST_VERSION="v0.25.2"
ENVTEST_K8S_VERSION="1.31"

# govulncheck release of the Go vulnerability gate (scripts/ci/govulncheck-gate.py,
# `make govulncheck`, the go-ci workflow). Symbol-level scan; findings that are
# not called need an OpenVEX statement in security/vex/go.openvex.json.
GOVULNCHECK_VERSION="v1.8.0"

# Product release version (release-please owned). Matches core/meson.build,
# compat/python-vmaf/__init__.py, ai/, dev-llm/, mcp-server/, and Helm appVersion.
VMAFX_VERSION="1.0.0-rc.3"           # x-release-please-version

# Scientific Python floors remain owned by each package's pyproject.toml.
# Native ONNX Runtime lanes also retain their own archive/runtime contracts.
# Add central knobs only with real consumers or executable drift checks;
# see docs/development/base-images.md for the current ownership boundaries.

CUDA_VERSION="13.4.2"
CUDA_APT_PACKAGE="cuda-toolkit-13-4"   # apt name for the same release
# Exact NVIDIA apt metadata for CUDA_VERSION. The release-to-component mapping
# is not derivable: CUDA 13.4.1 shipped nvcc 13.4.59 and cudart 13.4.49, while
# 13.4.2 ships both at 13.4.92. Refresh these three values from NVIDIA's live
# ubuntu2604 Packages index and redist manifest whenever CUDA_VERSION moves;
# refresh the release lock together with these three versions.
# CUDA_APT_LOCK_RELEASE deliberately repeats the release as a fail-closed latch:
# Renovate updates CUDA_VERSION only, so its PR cannot pass until a maintainer
# reviews and records the matching package metadata.
CUDA_APT_LOCK_RELEASE="13.4.2"
CUDA_APT_TOOLKIT_VERSION="13.4.2-1"
CUDA_APT_NVCC_VERSION="13.4.92-1"
CUDA_APT_CUDART_VERSION="13.4.92-1"
# ROCm is installed from digest-pinned images, not the apt repo: AMD ships
# through "TheRock" now and repo.radeon.com/rocm/apt/ tops out at 7.2.4
# (ADR-1225), so there is no apt version left to pin.
ROCM_VERSION="10.1.0"


# ================================================================= release ==
# Build stage for the C/C++ tree: needs a real toolchain, so Debian slim rather
# than distroless. The docker/ release builders use it, and so does the
# `release-build` stage of dev/Containerfile, where the native Linux release
# bundle compiles (ADR-1354).
RELEASE_BUILDER_BASE="debian:13-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f"

# Go toolchain. Keep the Debian generation aligned with the runtime below: a
# binary built against a newer glibc will not start on an older one.
RELEASE_GO_BASE="golang:1.27-trixie@sha256:8f58fd67ea075142d947a60e0caa4317746a55118d312f027793d382c7741734"

# rclone for the node image's remote-storage inputs (pkg/storage runs the
# `rclone` binary; ADR-0719). docker/Dockerfile.node builds this release from
# its module source (`go install github.com/rclone/rclone@<version>`, static,
# runs on distroless), so the image's -source companion holds the exact source
# its LGPL-3.0 and MPL-2.0 modules require (ADR-1513); the official image's
# binary reports vcs.modified=true. Mirrored by Dockerfile.node's ARG default.
RCLONE_VERSION="v1.75.1"

# The vmafx-node eBPF object (ADR-1622). cmd/vmafx-node/bpf/rclone_bypass.bpf.c
# is compiled at build time, in every place the node is built, by
# scripts/dev/gen-node-bpf.sh: no object is committed (Scorecard's
# Binary-Artifacts check flags a committed ELF). BPF_CLANG_VERSION is the exact
# `clang --version` of Debian 13's clang-19 (the release builders' package);
# BPF_OBJECT_SHA256 is the sha256 of rclonebypass_bpfel.o that this clang, the
# libbpf-dev headers of the same Debian release and the flags of
# cmd/vmafx-node/bpf/gen.go produce. `gen-node-bpf.sh --require-pin` (CI, the
# container build, the release path) refuses another clang and another digest;
# a change to the C source, vmlinux.h or the flags changes the digest, so
# re-record it in the same PR (the script prints it). bpf2go is not pinned
# here: it is the github.com/cilium/ebpf module version in go.mod, which the
# loader links, so generator and runtime cannot disagree.
BPF_CLANG_VERSION="19.1.7"
BPF_OBJECT_SHA256="a8079aa4e539dc30e5f275a424f1831d911fb0ef72e579c5c8527b8de2415ca0"

# Python layer for the server and tooling images.
RELEASE_PYTHON_BASE="python:3.14-slim@sha256:f85c5697265c178cc6887276c55fe16cf3d14ca35c3df6a5eab3b360534a55d2"

# Distroless runtimes. `cc` carries glibc, for the C/C++ binaries and anything
# using cgo; `static` is for pure-Go binaries that need no libc at all.
RELEASE_RUNTIME_CC="gcr.io/distroless/cc-debian13:nonroot@sha256:e792ab3d241a468a4fd7519ddbbebe66b49b5f365771716ea688ad40b6c6f1c2"
RELEASE_RUNTIME_STATIC="gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3"


# ===================================================================== dev ==
DEV_BASE="ubuntu:26.04@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7"
DEV_GO_BASE="golang:1.27-trixie@sha256:8f58fd67ea075142d947a60e0caa4317746a55118d312f027793d382c7741734"


# ============================================================== GPU vendors ==
# CUDA builders and runtimes build FROM digest-pinned Ubuntu 26.04 and install
# the toolkit via scripts/ci/install-cuda-toolkit.sh (ADR-1306), replacing the
# upstream nvidia/cuda base images whose release lag blocked pinning newer CUDA
# releases. oneAPI builds and runs on the release track's Debian 13 with
# Intel's apt packages (ADR-1368, below). ROCm retains its vendor image.
CUDA_BUILDER="ubuntu:26.04@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7"
CUDA_RUNTIME="ubuntu:26.04@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7"

# ROCm 10.1.0 on Ubuntu 26.04. ADR-1225 landed 10.0.0 on the 24.04 variant;
# moving to 26.04 was verified rather than assumed, because these libraries are
# COPIED out of this image into a Debian 13 runtime and a libc mismatch there
# would not fail the build, only the load:
#
#   /opt/rocm/core-10.0/lib layout   identical in both variants
#   max GLIBC symbol required        2.28 in both (AMD builds to an old floor)
#   Debian 13 runtime provides       2.41
#
# Re-measured for 10.1.0: the tree moved to /opt/rocm/core-10.1 (dev/Containerfile
# and docker/Dockerfile.node name that directory), and the runtime closure the
# images copy still requires GLIBC 2.28 at most.
#
# So the 26.04 variant is a drop-in. Note this is the OPPOSITE of the oneAPI
# case, where Intel's Ubuntu 26.04 image needs glibc 2.43 and genuinely cannot
# be copied onto Debian 13 -- the question has to be asked per vendor.
ROCM_BUILDER="rocm/dev-ubuntu-26.04:10.1.0-full@sha256:4f5ed1bf6532a4b9920400401b0ad0f706af356dae61e40afefbfd6c8073f0ce"
ROCM_RUNTIME="rocm/dev-ubuntu-26.04:10.1.0-full@sha256:4f5ed1bf6532a4b9920400401b0ad0f706af356dae61e40afefbfd6c8073f0ce"

# --- oneAPI ---------------------------------------------------------------
# ONEAPI_APT_PACKAGE is the single source for the Linux SYCL toolchain. Three
# workflows used to spell `intel-oneapi-compiler-dpcpp-cpp-2025.3` inline; they
# now source this file and install ${ONEAPI_APT_PACKAGE}, so the version moves
# in one place. What was measured:
#
# 1. `intel/oneapi-basekit` is a RETIRED repository whose last tag is 2025.3.2.
#    Intel continued the toolkit image under the plain name `intel/oneapi`,
#    which carries 2026.0.0 and 2026.1.0. Watching the retired name makes the
#    toolchain look two years stale when it is not.
#
# 2. The SYCL soname tracks the major version, and it moved:
#
#       compiled by 2025.3.2 -> DT_NEEDED libsycl.so.8   (measured)
#       runtime     2025.3.1 -> ships     libsycl.so.8
#       runtime     2026.0.0 -> ships     libsycl.so.9   (measured)
#       compiled by 2026.1.1 -> DT_NEEDED libsycl.so.9   (measured)
#
#    A 2025-compiled binary cannot load against a 2026 runtime at all. The
#    soname bump IS the ABI break, and it overrides the usual runtime >=
#    compiler ordering rule, which only holds while the soname is stable. Both
#    sides must cross to 2026 together, which is why this is one change and not
#    two independent bumps.
#
# 3. The 2026 pair cannot come from Intel's images. intel/oneapi ships 2026.1.0
#    but intel/oneapi-runtime stops at 2026.0.0, so the runtime would be OLDER
#    than the compiler -- the ordering violation this is meant to remove. Both
#    images are also Ubuntu-only, and Ubuntu 26.04 carries glibc 2.43 while
#    Debian 13 carries 2.41 (measured), so a binary compiled in Intel's image
#    cannot load on the Debian 13 runtime the rest of the release track ships.
#    Installing both compiler and runtime from Intel's apt repo onto Debian 13
#    fixes all three problems at once: same version on both sides, same libc,
#    same distro. Verified: both packages install on debian:13-slim and agree
#    on libsycl.so.9.
#
# Hence: install compiler AND runtime from Intel's apt repo onto Debian 13,
# both at ONEAPI_VERSION, rather than pinning two Intel images that disagree.
# intel-oneapi-runtime-dpcpp-cpp does NOT depend on intel-oneapi-umf, so
# libumf.so.1 goes missing and the adapter fails to load, presenting as
# "No device of requested type available" -- install umf explicitly.
#
# The oneAPI release image does exactly this (ADR-1368): its builder and its
# final stage both start from RELEASE_BUILDER_BASE and run
# scripts/ci/install-intel-oneapi.sh, which installs these packages at the exact
# Intel builds below and trusts only the repository key pinned here.
ONEAPI_VERSION="2026.1"
# The exact Intel apt build of ONEAPI_VERSION the release image installs. It
# repeats the release on purpose: moving ONEAPI_VERSION alone fails the
# installer until the build of the new release is recorded here. Every
# intel-oneapi package Intel built for the release carries this version.
ONEAPI_APT_VERSION="2026.1.1-325"
ONEAPI_APT_PACKAGE="intel-oneapi-compiler-dpcpp-cpp-${ONEAPI_VERSION}"
ONEAPI_RUNTIME_APT_PACKAGES="intel-oneapi-runtime-dpcpp-cpp intel-oneapi-umf"
# UMF has its own version line: 2026.x packages need intel-oneapi-umf-1.1.
ONEAPI_UMF_APT_VERSION="1.1.0-340"
# Fingerprint of the key that signs apt.repos.intel.com/oneapi (valid until
# 2027-08). Intel's key file also carries four expired keys; the installer puts
# only this one into the keyring apt trusts for the repository.
INTEL_ONEAPI_APT_SIGNER_FINGERPRINT="E9BF0AFC46D6E8B7DA5882F1BAC6F0C353D04109"

# Windows takes an offline installer whose URL carries an opaque per-build
# GUID that cannot be derived from the version, so it is pinned separately and
# lags. Tracked as T-ONEAPI-WINDOWS-CI-LAG-2026-09-07; the Linux legs are the
# ones that gate SYCL correctness.
ONEAPI_WINDOWS_VERSION="2025.3.0.372"
# That release's offline installer, which the Windows SYCL tester zip installs
# after checking its size and SHA-256 (measured 2026-10-04, ADR-1566). The
# `Windows MSVC+SYCL` lane spells the same URL inline because it runs under cmd.
INTEL_BASEKIT_WINDOWS_URL="https://registrationcenter-download.intel.com/akdlm/IRC_NAS/1f18901e-877d-469d-a41a-a10f11b39336/intel-oneapi-base-toolkit-2025.3.0.372_offline.exe"
INTEL_BASEKIT_WINDOWS_SIZE="2691346600"
INTEL_BASEKIT_WINDOWS_SHA256="f4dde6e5ea732b1624f0a50df546401712bccdf45766c9a23b0865f95863f541"
# Level Zero loader. Three different versions were in the tree at once: the CI
# SYCL legs built v1.28.0 from source, dev/Containerfile installed 1.32.0 debs,
# and anything using the distro package got Debian's. The loader is the
# dispatch layer between SYCL and the GPU driver, so a version skew here shows
# up as "no device available" rather than as a build error.
LEVEL_ZERO_VERSION="1.34.0"
# Intel compute-runtime (NEO) release tag. dev/Containerfile and the oneAPI
# release image install their GPU runtime from this release (ADR-0541,
# ADR-1145, ADR-1368), and every host that builds the SYCL backend installs the
# release's ocloc offline compiler with scripts/ci/install-intel-ocloc.sh: icpx
# hands spir64_gen ahead-of-time compilation to ocloc, which oneAPI ships only
# on Windows (ADR-1360). One tag, so the ocloc that compiles the images matches
# the IGC that runs them. The GPU runtime is not optional in the release image:
# the 25.18 runtime Intel's oneapi-runtime:2025.3.1 image carried crashed every
# SYCL run on an Arc B580, and this release runs the same binary (ADR-1368).
INTEL_NEO_VERSION="26.35.39758.10"

# The oneAPI release image's builder and runtime bases. Both equal
# RELEASE_BUILDER_BASE (the gate enforces it): Intel's images cannot provide a
# matching 2026 compiler and runtime on Debian 13's glibc (point 3 above), so
# the SDK comes from Intel's apt repo on the release track's own base instead.
ONEAPI_BUILDER="debian:13-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f"
ONEAPI_RUNTIME="debian:13-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f"


# =========================================================== not from here ==
# docker/dev/*.Dockerfile pin alpine / arch / fedora on purpose: they exist to
# prove the build survives distros the release track does not use, so unifying
# their bases would defeat them. The gate allowlists that directory.

# FFmpeg patch baseline: scheduled refresh selects stable released tags only.
FFMPEG_REMOTE="https://github.com/FFmpeg/FFmpeg.git"
FFMPEG_TAG="n9.0.2"
