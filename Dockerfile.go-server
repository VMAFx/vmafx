# syntax=docker/dockerfile:1.27@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# SPDX-License-Identifier: EUPL-1.2
# Copyright 2026 Lusoris
#
# Dockerfile.go-server — multi-stage build for the vmafx-server Go binary.
#
# Stages:
#   vmaf-builder: compiles libvmaf + vmaf CLI on Debian 13
#   go-builder  : compiles cmd/vmafx-server against that exact libvmaf build,
#                 and collects the licence texts of every module it links
#   go-server   : distroless Debian 13 runtime carrying both binaries and its
#                 notices; it copies the receipt of `licence-check` (ADR-1513)
#   source-export: the corresponding source of the copyleft parts (Debian
#                 packages of the base, MPL-2.0 and EUPL-1.2 Go modules),
#                 published as <tag>-source
#
# Build:
#   docker build -f Dockerfile.go-server -t ghcr.io/vmafx/vmafx-server:dev .
#
# Run:
#   docker run --rm \
#     -e VMAFX_VMAF_BINARY=/usr/local/bin/vmaf \
#     -e VMAFX_MODEL_DIR=/usr/local/share/vmafx/model \
#     -p 8080:8080 -p 9090:9090 \
#     ghcr.io/vmafx/vmafx-server:dev
#
# The release workflow passes VMAFX_VERSION=vX.Y.Z. The image's non-blocking
# `--version` path prints that exact value without starting fx or binding ports.
#
# Environment variables (golusoris fx framework config, ADR-1119; full listen
# addresses, not bare ports):
#   VMAFX_HTTP_ADDR    HTTP listen address (default :8080; golusoris http.addr)
#   VMAFX_GRPC_LISTEN  gRPC listen address (default :9090; golusoris grpc.listen)
#   VMAFX_LOG_LEVEL    slog level (default INFO)
#   VMAFX_VMAF_BINARY  path to vmaf CLI binary
#   VMAFX_MODEL_DIR    directory containing VMAF .json model files
#
# Note: replaces the pre-fx VMAFX_PORT / VMAFX_GRPC_PORT (bare ports). The gRPC
# default address moved from :50051 to golusoris' :9090.
#
# ADR-0703: vmafx-server Go gRPC + HTTP service.
# ADR-1119: golusoris fx framework adoption.
# ADR-1129: release container runtime alignment.

ARG VMAFX_VERSION=dev

# ---------------------------------------------------------------------------
# Stage 1 — vmaf-builder: compile libvmaf + vmaf CLI from core/
# ---------------------------------------------------------------------------
# Base images come from build-config.env -- the single source of truth for
# every container base in this repository. These defaults are mirrors kept in
# sync by scripts/ci/check-base-image-single-source.sh; edit the config, not
# these lines, then run that script with --write.
ARG RELEASE_BUILDER_BASE="debian:13-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a"
ARG RELEASE_GO_BASE="golang:1.27-trixie@sha256:3b77fc618ec235a1ab412de7737f120dd507c57e8d87de4cbb7994fb94275ed5"
ARG RELEASE_RUNTIME_CC="gcr.io/distroless/cc-debian13:nonroot@sha256:e792ab3d241a468a4fd7519ddbbebe66b49b5f365771716ea688ad40b6c6f1c2"
ARG RELEASE_PYTHON_BASE="python:3.14-slim@sha256:c3e521df8b2b498a7a682e7e18676771cb80c6b75b8699af886b2d554ce40151"

FROM ${RELEASE_BUILDER_BASE} AS vmaf-builder

ARG VMAF_BUILD_JOBS=4
ARG DEBIAN_FRONTEND=noninteractive

# Keep the build and runtime on one Debian 13 ABI. The release workflow builds
# this stage natively for each target platform (QEMU supplies arm64 execution).
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        make \
        meson \
        ninja-build \
        nasm \
        pkg-config \
        xxd \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY core/ core/
COPY model/ model/
# core/test/meson.build resolves this guard at configure time. The release
# build context must include it even though this stage compiles only tools/vmaf.
COPY scripts/ci/check-msvc-clz-shim.sh scripts/ci/check-msvc-clz-shim.sh

RUN meson setup /build core \
        --buildtype=release \
        --strip \
        -Denable_cuda=false \
        -Denable_sycl=false \
        -Denable_dnn=disabled \
        -Denable_avx512=true \
    && ninja -C /build -j"${VMAF_BUILD_JOBS}" tools/vmaf

# The SONAME chain only: the glob would also take Meson's object directory
# libvmaf.so.3.0.0.p/.
RUN mkdir -p /dist/lib/pkgconfig /dist/bin /dist/model \
    && find /build/src -maxdepth 1 \( -name 'libvmaf.so*' -o -name 'libvmafx.so*' \) \
        \( -type f -o -type l \) -exec cp -a {} /dist/lib/ \; \
    && cp /build/meson-private/libvmaf.pc /dist/lib/pkgconfig/libvmaf.pc \
    && cp /build/meson-private/libvmafx.pc /dist/lib/pkgconfig/libvmafx.pc \
    && cp /build/tools/vmaf /dist/bin/ \
    && ln -s vmaf /dist/bin/vmafx \
    && cp -r model/. /dist/model/

# The licence and copyright of every repository file the build compiled
# (ADR-1503 rule 2); bind mounts keep the build layer above independent of them.
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/src/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/src/REUSE.toml \
    mkdir /licence-inputs \
    && python3 tools/rc1-tester/image/licensing.py scan-build --build /build --repo /src \
        --out /licence-inputs/vmafx-sources.json

# ---------------------------------------------------------------------------
# Stage 2 — go-builder: compile the Go server against the staged libvmaf
# ---------------------------------------------------------------------------
FROM ${RELEASE_GO_BASE} AS go-builder

ARG CGO_ENABLED=1
ARG DEBIAN_FRONTEND=noninteractive
ARG VMAFX_VERSION

# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY --from=vmaf-builder /dist/lib/ /usr/local/lib/

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# CGO is required by pkg/libvmaf. Link to the exact fork build staged above;
# never use a distro libvmaf-dev package or an architecture-specific lib path.
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    CGO_ENABLED=${CGO_ENABLED} \
    CGO_LDFLAGS="-L/usr/local/lib -lvmaf -lvmafx -lm" \
    go build \
        -trimpath \
        -ldflags "-s -w -X github.com/VMAFx/vmafx/pkg/version.version=${VMAFX_VERSION}" \
        -o /out/vmafx-server \
        ./cmd/vmafx-server \
    && LD_LIBRARY_PATH=/usr/local/lib ldd /out/vmafx-server > /tmp/vmafx-server-ldd.txt \
    && if grep -q 'not found' /tmp/vmafx-server-ldd.txt; then \
        cat /tmp/vmafx-server-ldd.txt >&2; \
        exit 1; \
    fi

# The licences of the program (ADR-1513): our own Go files merged into the C
# library's scan, and the licence and notice files of every module the binary
# links, read from its build information.
COPY --from=vmaf-builder /licence-inputs/vmafx-sources.json /tmp/vmaf-sources.json
# hadolint ignore=DL3008
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && apt-get clean \
    && mkdir /licence-inputs \
    && python3 tools/rc1-tester/image/licensing.py scan-go --repo /src \
        --package ./cmd/vmafx-server --merge /tmp/vmaf-sources.json \
        --out /licence-inputs/vmafx-sources.json \
    && python3 tools/rc1-tester/image/licensing.py go-licences \
        --binary /out/vmafx-server --out /licence-inputs/go

# ---------------------------------------------------------------------------
# Stage 3 — go-server-assembled: distroless runtime (glibc, no shell)
# ---------------------------------------------------------------------------
FROM ${RELEASE_RUNTIME_CC} AS go-server-assembled

LABEL org.opencontainers.image.title="vmafx-server"
LABEL org.opencontainers.image.description="VMAFX scoring server — Go gRPC + HTTP, backed by libvmaf. Licences: /usr/local/share/vmafx/licenses/THIRD_PARTY_NOTICES.txt"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"
LABEL org.opencontainers.image.licenses="EUPL-1.2 AND BSD-2-Clause-Patent AND BSD-3-Clause AND BSD-2-Clause AND ISC AND MIT AND Unlicense AND LicenseRef-LIVE-BRISQUE"
LABEL org.opencontainers.image.vendor="Lusoris"

# Copy libvmaf.so* and the vmaf CLI from the vmaf-builder stage.
COPY --from=vmaf-builder /dist/lib/   /usr/local/lib/
COPY --from=vmaf-builder /dist/bin/   /usr/local/bin/
COPY --from=vmaf-builder /dist/model/ /usr/local/share/vmafx/model/

# Copy the Go server binary.
COPY --from=go-builder /out/vmafx-server /usr/local/bin/vmafx-server

# ---------------------------------------------------------------------------
# notices: written on a copy of the distroless tree, which has no interpreter
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS notices
COPY --from=go-server-assembled / /rootfs
ARG VMAFX_SOURCE_COMMIT=unknown
ARG VMAFX_IMAGE_TAG=unknown
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=go-builder,source=/licence-inputs,target=/licence-inputs \
    mkdir /texts \
    && python3 /repo/tools/rc1-tester/image/licensing.py notices --artifact production-go-server-image \
        --root /rootfs --repo /repo --build-scan /licence-inputs/vmafx-sources.json --texts /texts \
        --go-licences /licence-inputs/go \
        --source-commit "${VMAFX_SOURCE_COMMIT}" --tag "${VMAFX_IMAGE_TAG}"

FROM go-server-assembled AS go-server-with-notices
COPY --from=notices /rootfs/usr/local/share/vmafx/licenses /usr/local/share/vmafx/licenses

# ---------------------------------------------------------------------------
# licence-check: every file of the image has a recorded licence (ADR-1503
# rule 3); `go-server` copies its receipt, so it cannot be built without it
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS licence-check
RUN --mount=type=bind,from=go-server-with-notices,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=go-builder,source=/licence-inputs,target=/licence-inputs \
    mkdir /out \
    && python3 /repo/tools/rc1-tester/image/licensing.py check --artifact production-go-server-image \
        --root /rootfs --repo /repo --build-scan /licence-inputs/vmafx-sources.json \
        --python-version none --receipt /out/licence-check.json

# ---------------------------------------------------------------------------
# source-export: Debian sources of the base's packages and the module zips of
# the copyleft Go modules, published as <tag>-source (ADR-1503 rule 5)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS source-fetch
# Only /sources leaves this stage, so its package lists need no cleanup.
# hadolint ignore=DL3009
RUN --mount=type=bind,from=go-server-with-notices,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && python3 /repo/tools/rc1-tester/image/licensing.py sources --artifact production-go-server-image \
        --root /rootfs --repo /repo --out /sources.list \
    && python3 /repo/tools/rc1-tester/image/licensing.py fetch-sources --list /sources.list \
        --out /sources

FROM scratch AS source-export
COPY --from=source-fetch /sources /sources

# ---------------------------------------------------------------------------
# go-server: the published image
# ---------------------------------------------------------------------------
FROM go-server-with-notices AS go-server

COPY --from=licence-check /out/licence-check.json /usr/local/share/vmafx/licence-check.json

ENV LD_LIBRARY_PATH="/usr/local/lib"
ENV VMAFX_VMAF_BINARY="/usr/local/bin/vmaf"
ENV VMAFX_MODEL_DIR="/usr/local/share/vmafx/model"

EXPOSE 8080
EXPOSE 9090

# Distroless nonroot is UID:GID 65532:65532. Keep the numeric identity stable
# for Kubernetes securityContext and image-inspection release smokes.
USER 65532:65532

ENTRYPOINT ["/usr/local/bin/vmafx-server"]
