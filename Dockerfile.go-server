# Copyright 2026 Lusoris
#
# Dockerfile.go-server — multi-stage build for the vmafx-server Go binary.
#
# Stages:
#   go-builder  : compiles cmd/vmafx-server using golang:1.23-bookworm
#   vmaf-builder: compiles libvmaf + vmaf CLI (mirrors docker/Dockerfile.production)
#   go-server   : distroless runtime carrying both the Go binary and libvmaf.so
#
# Build:
#   docker build -f Dockerfile.go-server -t ghcr.io/vmafx/vmafx-server:dev .
#
# Run:
#   docker run --rm \
#     -e VMAFX_VMAF_BINARY=/usr/local/bin/vmaf \
#     -e VMAFX_MODEL_DIR=/usr/local/share/vmafx/model \
#     -p 8080:8080 -p 50051:50051 \
#     ghcr.io/vmafx/vmafx-server:dev
#
# Environment variables:
#   VMAFX_PORT        HTTP listen port (default 8080)
#   VMAFX_GRPC_PORT   gRPC listen port (default 50051)
#   VMAFX_LOG_LEVEL   slog level (default INFO)
#   VMAFX_VMAF_BINARY path to vmaf CLI binary
#   VMAFX_MODEL_DIR   directory containing VMAF .json model files
#
# ADR-0703: vmafx-server Go gRPC + HTTP service.

# ---------------------------------------------------------------------------
# Stage 1 — go-builder: compile the Go server
# ---------------------------------------------------------------------------
FROM golang:1.23-bookworm@sha256:167053a2bb901972bf2c1611f8f52c44d5fe7e762e5cab213708d82c421614db AS go-builder

ARG CGO_ENABLED=1
ARG DEBIAN_FRONTEND=noninteractive

# Install libvmaf headers + library for cgo linking.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        pkg-config \
        libvmaf-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# Download module dependencies.
RUN go mod download

# Build the static-ish binary.  CGO_ENABLED=1 is required for cgo linkage to
# libvmaf.  We use -trimpath and strip debug info to shrink the binary.
RUN CGO_ENABLED=${CGO_ENABLED} \
    CGO_LDFLAGS="-L/usr/lib/x86_64-linux-gnu -lvmaf" \
    go build \
        -trimpath \
        -ldflags "-s -w -X main.buildVersion=$(git describe --tags --always --dirty 2>/dev/null || echo dev)" \
        -o /out/vmafx-server \
        ./cmd/vmafx-server

# ---------------------------------------------------------------------------
# Stage 2 — vmaf-builder: compile libvmaf + vmaf CLI
# ---------------------------------------------------------------------------
# Reuses the same setup as docker/Dockerfile.production stage 1.
FROM debian:12-slim@sha256:0104b334637a5f19aa9c983a91b54c89887c0984081f2068983107a6f6c21eeb AS vmaf-builder

ARG VMAF_BUILD_JOBS=4
ARG DEBIAN_FRONTEND=noninteractive

# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        meson \
        ninja-build \
        nasm \
        pkg-config \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

RUN meson setup /build core \
        --buildtype=release \
        --strip \
        -Denable_cuda=false \
        -Denable_sycl=false \
        -Denable_dnn=disabled \
        -Denable_avx512=true \
    && ninja -C /build -j"${VMAF_BUILD_JOBS}"

RUN mkdir -p /dist/lib /dist/bin /dist/model \
    && find /build/src -maxdepth 1 -name 'libvmaf.so*' -not -type d -exec cp {} /dist/lib/ \; \
    && cp /build/tools/vmaf /dist/bin/ \
    && cp -r model/ /dist/model/

# ---------------------------------------------------------------------------
# Stage 3 — go-server: distroless runtime (glibc, no shell)
# ---------------------------------------------------------------------------
FROM gcr.io/distroless/cc-debian12@sha256:aa0b7af67fa8211751ea6e00baa8373ba56cc1417ffc986ec9619bd0e1556b56 AS go-server

LABEL org.opencontainers.image.title="vmafx-server"
LABEL org.opencontainers.image.description="VMAFX scoring server — Go gRPC + HTTP, backed by libvmaf"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"
LABEL org.opencontainers.image.licenses="BSD-3-Clause-Plus-Patent"
LABEL org.opencontainers.image.vendor="Lusoris"

# Copy libvmaf.so* and the vmaf CLI from the vmaf-builder stage.
COPY --from=vmaf-builder /dist/lib/   /usr/local/lib/
COPY --from=vmaf-builder /dist/bin/vmaf /usr/local/bin/vmaf
COPY --from=vmaf-builder /dist/model/   /usr/local/share/vmafx/model/

# Copy the Go server binary.
COPY --from=go-builder /out/vmafx-server /usr/local/bin/vmafx-server

ENV LD_LIBRARY_PATH="/usr/local/lib"
ENV VMAFX_VMAF_BINARY="/usr/local/bin/vmaf"
ENV VMAFX_MODEL_DIR="/usr/local/share/vmafx/model"

EXPOSE 8080
EXPOSE 50051

ENTRYPOINT ["/usr/local/bin/vmafx-server"]
