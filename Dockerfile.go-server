# syntax=docker/dockerfile:1.25@sha256:0adf442eae370b6087e08edc7c50b552d80ddf261576f4ebd6421006b2461f12
# SPDX-License-Identifier: BSD-3-Clause-Plus-Patent
# Copyright 2026 Lusoris
#
# Dockerfile.go-server — multi-stage build for the vmafx-server Go binary.
#
# Stages:
#   go-builder  : compiles cmd/vmafx-server using golang:1.26-bookworm@sha256:5f68ec6805843bd3981a951ffada82a26a0bd2631045c8f7dba483fa868f5ec5
#   vmaf-builder: compiles libvmaf + vmaf CLI (mirrors docker/Dockerfile.production)
#   go-server   : distroless runtime carrying both the Go binary and libvmaf.so
#
# Build:
#   docker build -f Dockerfile.go-server -t ghcr.io/vmafx/vmafx-server:dev .
#
# Run:
#   docker run --rm \
#     -e VMAFX_VMAF_BINARY=/usr/local/bin/vmaf \
#     -e VMAFX_MODEL_DIR=/usr/local/share/vmafx/model \
#     -p 8080:8080 -p 9090:9090 \
#     ghcr.io/vmafx/vmafx-server:dev
#
# Environment variables (golusoris fx framework config, ADR-1119; full listen
# addresses, not bare ports):
#   VMAFX_HTTP_ADDR    HTTP listen address (default :8080; golusoris http.addr)
#   VMAFX_GRPC_LISTEN  gRPC listen address (default :9090; golusoris grpc.listen)
#   VMAFX_LOG_LEVEL    slog level (default INFO)
#   VMAFX_VMAF_BINARY  path to vmaf CLI binary
#   VMAFX_MODEL_DIR    directory containing VMAF .json model files
#
# Note: replaces the pre-fx VMAFX_PORT / VMAFX_GRPC_PORT (bare ports). The gRPC
# default address moved from :50051 to golusoris' :9090.
#
# ADR-0703: vmafx-server Go gRPC + HTTP service.
# ADR-1119: golusoris fx framework adoption.

# ---------------------------------------------------------------------------
# Stage 1 — go-builder: compile the Go server
# ---------------------------------------------------------------------------
FROM golang:1.26-bookworm@sha256:e8c859f5632dcfde7b32d2012b4351728f6437930887c2f6a91ea242459e5514 AS go-builder

ARG CGO_ENABLED=1
ARG DEBIAN_FRONTEND=noninteractive

# Install libvmaf headers + library for cgo linking.
# hadolint ignore=DL3008,DL3009
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        pkg-config \
        libvmaf-dev

WORKDIR /src
COPY . .

# Download module dependencies. The Go module cache + build cache live at
# /go/pkg/mod and /root/.cache/go-build respectively; BuildKit cache mounts
# preserve them across builds so incremental rebuilds skip the network fetch
# and reuse compiled package archives.
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    go mod download

# Build the static-ish binary.  CGO_ENABLED=1 is required for cgo linkage to
# libvmaf.  We use -trimpath and strip debug info to shrink the binary.
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    CGO_ENABLED=${CGO_ENABLED} \
    CGO_LDFLAGS="-L/usr/lib/x86_64-linux-gnu -lvmaf" \
    go build \
        -trimpath \
        -ldflags "-s -w -X main.buildVersion=$(git describe --tags --always --dirty 2>/dev/null || echo dev)" \
        -o /out/vmafx-server \
        ./cmd/vmafx-server

# ---------------------------------------------------------------------------
# Stage 2 — vmaf-builder: compile libvmaf + vmaf CLI
# ---------------------------------------------------------------------------
# Reuses the same setup as docker/Dockerfile.production stage 1.
FROM debian:13-slim@sha256:28de0877c2189802884ccd20f15ee41c203573bd87bb6b883f5f46362d24c5c2 AS vmaf-builder

ARG VMAF_BUILD_JOBS=4
ARG DEBIAN_FRONTEND=noninteractive

# hadolint ignore=DL3008,DL3009
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        ccache \
        gcc \
        g++ \
        meson \
        ninja-build \
        nasm \
        pkg-config \
        ca-certificates

WORKDIR /src
COPY . .

# ccache cache mount accelerates incremental libvmaf rebuilds; meson auto-
# detects ccache when it's on PATH.
RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked,id=ccache-go-server-vmaf \
    CCACHE_DIR=/root/.cache/ccache \
    meson setup /build core \
        --buildtype=release \
        --strip \
        -Denable_cuda=false \
        -Denable_sycl=false \
        -Denable_dnn=disabled \
        -Denable_avx512=true \
    && ninja -C /build -j"${VMAF_BUILD_JOBS}"

RUN mkdir -p /dist/lib /dist/bin /dist/model \
    && find /build/src -maxdepth 1 -name 'libvmaf.so*' -not -type d -exec cp {} /dist/lib/ \; \
    && cp /build/tools/vmaf /dist/bin/ \
    && cp -r model/ /dist/model/

# ---------------------------------------------------------------------------
# Stage 3 — go-server: distroless runtime (glibc, no shell)
# ---------------------------------------------------------------------------
FROM gcr.io/distroless/cc-debian12@sha256:d703b626ba455c4e6c6fbe5f36e6f427c85d51445598d564652a2f334179f96e AS go-server

LABEL org.opencontainers.image.title="vmafx-server"
LABEL org.opencontainers.image.description="VMAFX scoring server — Go gRPC + HTTP, backed by libvmaf"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"
LABEL org.opencontainers.image.licenses="BSD-3-Clause-Plus-Patent"
LABEL org.opencontainers.image.vendor="Lusoris"

# Copy libvmaf.so* and the vmaf CLI from the vmaf-builder stage.
COPY --from=vmaf-builder /dist/lib/   /usr/local/lib/
COPY --from=vmaf-builder /dist/bin/vmaf /usr/local/bin/vmaf
COPY --from=vmaf-builder /dist/model/   /usr/local/share/vmafx/model/

# Copy the Go server binary.
COPY --from=go-builder /out/vmafx-server /usr/local/bin/vmafx-server

ENV LD_LIBRARY_PATH="/usr/local/lib"
ENV VMAFX_VMAF_BINARY="/usr/local/bin/vmaf"
ENV VMAFX_MODEL_DIR="/usr/local/share/vmafx/model"

EXPOSE 8080
EXPOSE 9090

# Run as non-root user; distroless provides nonroot (uid 65532).
USER nonroot

ENTRYPOINT ["/usr/local/bin/vmafx-server"]
