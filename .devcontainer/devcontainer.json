{
  "name": "vmafx/vmafx",
  "build": {
    "dockerfile": "Dockerfile.praetor",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/nix:1": {},
    "ghcr.io/devcontainers/features/rust:1": {}
  },
  "customizations": {
    "praetor": {
      "bootstrap": {
        "version": 1,
        "state": "source-bundle",
        "builderImage": "docker.io/library/golang@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414",
        "baseImage": "ghcr.io/vmafx/vmafx-dev-mcp@sha256:3956ebc9342a75cc0120804cee37144fff402dc1bab83849c68bf73a2cd6c9cc",
        "sourceSHA256": "sha256:b93911d9a060e7795256a312c3cdaac24b01741184a87a01121c4607b3496bcb",
        "archiveSHA256": "sha256:928049a1d8adc990faa5ba5a48723dd629acfbac45e71fba971cca70e0d66296",
        "archiveParts": 6,
        "dockerfileSHA256": "sha256:83d058468fe4c86b42936c61a5d5b3c4cf0ee207167ee6a59f018dca93c47719"
      }
    },
    "vscode": {
      "extensions": [
        "GitHub.vscode-pull-request-github",
        "aquasecurity.trivy-vulnerability-scanner",
        "davidanson.vscode-markdownlint",
        "eamodio.gitlens",
        "github.copilot",
        "llvm-vs-code-extensions.vscode-clangd",
        "mesonbuild.mesonbuild",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-vscode.cmake-tools",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "clangd.arguments": [
          "--header-insertion=never"
        ],
        "clangd.path": "clangd",
        "editor.formatOnSave": true,
        "security.workspace.trust.enabled": true
      }
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "export PATH=\"/usr/local/bin:$PATH\"; /usr/local/bin/praetorctl compile-context && /usr/bin/make verify-all"
}
