From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lusoris <lusoris@pm.me>
Date: Tue, 6 Oct 2026 20:41:25 +0200
Subject: [PATCH] fftools: decode on the GPU in a loopback decoder

-hwaccel, -hwaccel_device and -hwaccel_output_format may precede -dec and
set up the loopback decoder's hardware decoding as they do for an input
stream (fftools/ffmpeg_dec_hwaccel.c). Without them an encoder's output
always came back through system memory, so a pipeline that encodes and
scores on the GPU (VMAFx #2138) round-tripped every frame over the bus.

Carried by the VMAFx fork only (decision Q-048): this patch is refreshed
with every FFmpeg release and is not submitted upstream.
---
 doc/ffmpeg.texi              |   6 ++
 fftools/Makefile             |   1 +
 fftools/ffmpeg.h             |  12 ++++
 fftools/ffmpeg_dec.c         |   7 +++
 fftools/ffmpeg_dec_hwaccel.c | 106 +++++++++++++++++++++++++++++++++++
 fftools/ffmpeg_opt.c         |   6 +-
 6 files changed, 135 insertions(+), 3 deletions(-)
 create mode 100644 fftools/ffmpeg_dec_hwaccel.c

diff --git a/doc/ffmpeg.texi b/doc/ffmpeg.texi
index 882503142e22895cda9dd818ea67a0ba9a582130..931cc02a8082912a852b2246a090dc381c33c2bd 100644
--- a/doc/ffmpeg.texi
+++ b/doc/ffmpeg.texi
@@ -499,6 +499,12 @@ documentation for @option{-filter_complex}.
 Decoding AVOptions can be passed to loopback decoders by placing them before
 @code{-dec}, analogously to input/output options.
 
+So can @option{-hwaccel}, @option{-hwaccel_device} and
+@option{-hwaccel_output_format}, which then decode the encoder's output on
+the GPU as they do for an input stream; with
+@code{-hwaccel_output_format cuda}, for example, the loopback decoder's frames
+stay in device memory.
+
 E.g. the following example:
 
 @example
diff --git a/fftools/Makefile b/fftools/Makefile
index 01b16fa8f480efff337f1e2303f901913263f444..96cf291ce0f79201647727167ddd42df063f0334 100644
--- a/fftools/Makefile
+++ b/fftools/Makefile
@@ -13,6 +13,7 @@ include $(SRC_PATH)/fftools/resources/Makefile
 
 OBJS-ffmpeg +=                  \
     fftools/ffmpeg_dec.o        \
+    fftools/ffmpeg_dec_hwaccel.o \
     fftools/ffmpeg_demux.o      \
     fftools/ffmpeg_enc.o        \
     fftools/ffmpeg_filter.o     \
diff --git a/fftools/ffmpeg.h b/fftools/ffmpeg.h
index c44aaf6032f91aa3365199d187d695371e33af58..92afbc67b7635edb54c035b332c6bc2ea3dfda20 100644
--- a/fftools/ffmpeg.h
+++ b/fftools/ffmpeg.h
@@ -444,6 +444,15 @@ typedef struct DecoderOpts {
     AVRational                  framerate;
 } DecoderOpts;
 
+/* -hwaccel, -hwaccel_device and -hwaccel_output_format of a loopback
+ * decoder (ffmpeg_dec_hwaccel.c). */
+typedef struct DecoderHwaccelOpts {
+    enum HWAccelID              hwaccel_id;
+    enum AVHWDeviceType         hwaccel_device_type;
+    char                       *hwaccel_device;
+    enum AVPixelFormat          hwaccel_output_format;
+} DecoderHwaccelOpts;
+
 typedef struct Decoder {
     const AVClass   *class;
 
@@ -847,6 +856,9 @@ AVBufferRef *hw_device_for_filter(void);
  * Create a standalone decoder.
  */
 int dec_create(const OptionsContext *o, const char *arg, Scheduler *sch);
+int  dec_hwaccel_opts_parse(void *logctx, const OptionsContext *o, DecoderHwaccelOpts *hw);
+void dec_hwaccel_opts_apply(const DecoderHwaccelOpts *hw, DecoderOpts *o);
+void dec_hwaccel_opts_free(DecoderHwaccelOpts *hw);
 
 /**
  * @param dec_opts Dictionary filled with decoder options. Its ownership
diff --git a/fftools/ffmpeg_dec.c b/fftools/ffmpeg_dec.c
index 1b37d39e6dcb606e81bc694df6c058414af8c713..e9b8a05e0d8748782b3ee14b580ca2a98febad3b 100644
--- a/fftools/ffmpeg_dec.c
+++ b/fftools/ffmpeg_dec.c
@@ -101,6 +101,7 @@ typedef struct DecoderPriv {
     struct {
         AVDictionary       *opts;
         const AVCodec      *codec;
+        DecoderHwaccelOpts  hw;
     } standalone_init;
 } DecoderPriv;
 
@@ -131,6 +132,7 @@ void dec_free(Decoder **pdec)
     av_packet_free(&dp->pkt);
 
     av_dict_free(&dp->standalone_init.opts);
+    dec_hwaccel_opts_free(&dp->standalone_init.hw);
 
     for (int i = 0; i < FF_ARRAY_ELEMS(dp->sub_prev); i++)
         av_frame_free(&dp->sub_prev[i]);
@@ -860,6 +862,7 @@ static int dec_standalone_open(DecoderPriv *dp, const AVPacket *pkt)
 
     snprintf(name, sizeof(name), "dec%d", dp->index);
     o.name = name;
+    dec_hwaccel_opts_apply(&dp->standalone_init.hw, &o);
 
     return dec_open(dp, &dp->standalone_init.opts, &o, NULL);
 }
@@ -1744,6 +1747,10 @@ int dec_create(const OptionsContext *o, const char *arg, Scheduler *sch)
 
     multiview_check_manual(dp, dp->standalone_init.opts);
 
+    ret = dec_hwaccel_opts_parse(dp, o, &dp->standalone_init.hw);
+    if (ret < 0)
+        return ret;
+
     if (o->codec_names.nb_opt) {
         const char *name = o->codec_names.opt[o->codec_names.nb_opt - 1].u.str;
         dp->standalone_init.codec = avcodec_find_decoder_by_name(name);
diff --git a/fftools/ffmpeg_dec_hwaccel.c b/fftools/ffmpeg_dec_hwaccel.c
new file mode 100644
index 0000000000000000000000000000000000000000..d58fe0359e6dcff9cf2bff3aa08da94effabc3d2
--- /dev/null
+++ b/fftools/ffmpeg_dec_hwaccel.c
@@ -0,0 +1,106 @@
