From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lusoris <lusoris@pm.me>
Date: Tue, 6 Oct 2026 18:22:26 +0200
Subject: [PATCH] libvmaf: declare the input colorimetry from the AVFrame
 properties

On the first frame pair the libvmaf filter (and the software path of
libvmaf_sycl) hands the colour range, primaries, transfer characteristic
and matrix of the reference and the distorted frames to libvmaf with
vmaf_set_input_colorimetry(), so a model that declares a conversion_target
can convert HDR input. An input whose four attributes are not all ones
libvmaf names (range limited or full; primaries bt709, bt2020 or smpte432;
transfer bt709 or smpte2084; matrix bt709, bt2020nc or ictcp) is left
unspecified, so a model without a conversion_target, and any input without
colour tags, scores exactly as before.
---
 libavfilter/vf_libvmaf.c | 63 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 63 insertions(+)

diff --git a/libavfilter/vf_libvmaf.c b/libavfilter/vf_libvmaf.c
index ca69ca411510571d5d90a6dfc68e5cb9f692bd1b..9655e2b47245bc09df44d3f68f9826917565475d 100644
--- a/libavfilter/vf_libvmaf.c
+++ b/libavfilter/vf_libvmaf.c
@@ -149,6 +149,7 @@ typedef struct LIBVMAFContext {
     unsigned model_cnt;
     unsigned frame_cnt;
     unsigned bpc;
+    int color_set;           /* input colorimetry handed to libvmaf (ADR-2093) */
 #if CONFIG_LIBVMAF_CUDA_FILTER
     VmafCudaState *cu_state;
     AVBufferRef *cuda_hw_frames_ref;
@@ -329,6 +330,62 @@ static int stop_on_frame(AVFilterContext *ctx, LIBVMAFContext *s, AVFrame **dist
     return ret;
 }
 
+/* Colorimetry of one input from the AVFrame properties (ADR-2093). Returns 1
+ * and fills *out when range, primaries, transfer and matrix are all ones libvmaf
+ * names, 0 otherwise (the input is then left unspecified and a model without a
+ * conversion_target scores exactly as before). */
+static int vmaf_color_from_frame(const AVFrame *f, VmafColor *out)
+{
+    VmafColor c = {0};
+    switch (f->color_range) {
+    case AVCOL_RANGE_MPEG: c.range = VMAF_COLOR_RANGE_LIMITED; break;
+    case AVCOL_RANGE_JPEG: c.range = VMAF_COLOR_RANGE_FULL; break;
+    default: break;
+    }
+    switch (f->color_primaries) {
+    case AVCOL_PRI_BT709:    c.primaries = VMAF_COLOR_PRIMARIES_BT709; break;
+    case AVCOL_PRI_BT2020:   c.primaries = VMAF_COLOR_PRIMARIES_BT2020; break;
+    case AVCOL_PRI_SMPTE432: c.primaries = VMAF_COLOR_PRIMARIES_SMPTE432; break;
+    default: break;
+    }
+    switch (f->color_trc) {
+    case AVCOL_TRC_BT709:     c.trc = VMAF_COLOR_TRC_BT709; break;
+    case AVCOL_TRC_SMPTE2084: c.trc = VMAF_COLOR_TRC_SMPTE2084; break;
+    default: break;
+    }
+    switch (f->colorspace) {
+    case AVCOL_SPC_BT709:      c.matrix = VMAF_COLOR_MATRIX_BT709; break;
+    case AVCOL_SPC_BT2020_NCL: c.matrix = VMAF_COLOR_MATRIX_BT2020_NCL; break;
+    case AVCOL_SPC_ICTCP:      c.matrix = VMAF_COLOR_MATRIX_ICTCP; break;
+    default: break;
+    }
+    if (!c.range || !c.primaries || !c.trc || !c.matrix)
+        return 0;
+    *out = c;
+    return 1;
+}
+
+/* Once, on the first frame pair, before anything is read: declare the colour of
+ * the reference and distorted input to libvmaf for a model's conversion_target. */
+static int vmaf_declare_input_color(AVFilterContext *ctx, LIBVMAFContext *s,
+                                    const AVFrame *ref, const AVFrame *dist)
+{
+    VmafColor ref_color, dist_color;
+    int err;
+
+    if (s->color_set)
+        return 0;
+    err = vmaf_set_input_colorimetry(s->vmaf,
+                                     vmaf_color_from_frame(ref, &ref_color) ? &ref_color : NULL,
+                                     vmaf_color_from_frame(dist, &dist_color) ? &dist_color : NULL);
+    if (err) {
+        av_log(ctx, AV_LOG_ERROR, "vmaf_set_input_colorimetry failed: %d\n", err);
+        return AVERROR(EINVAL);
+    }
+    s->color_set = 1;
+    return 0;
+}
+
 static int do_vmaf(FFFrameSync *fs)
 {
     AVFilterContext *ctx = fs->parent;
@@ -346,6 +403,10 @@ static int do_vmaf(FFFrameSync *fs)
         av_frame_free(&dist);
         return AVERROR(EINVAL);
     }
+    if ((ret = vmaf_declare_input_color(ctx, s, ref, dist)) < 0) {
+        av_frame_free(&dist);
+        return ret;
+    }
 
     if (dist->color_range != ref->color_range) {
         av_log(ctx, AV_LOG_WARNING, "distorted and reference "
@@ -1567,6 +1628,8 @@ static int do_vmaf_sycl(FFFrameSync *fs)
         s->frame_cnt++;
     } else {
         // Software path: YUV420P / YUV420P10LE frames — copy via vmaf_picture_alloc.
+        if ((ret = vmaf_declare_input_color(ctx, s, ref, dist)) < 0)
+            return ret;
         VmafPicture ref_pic = {0}, dist_pic = {0};
         ret = vmaf_picture_alloc(&ref_pic, VMAF_PIX_FMT_YUV420P,
                                   s->bpc, ref->width, ref->height);
