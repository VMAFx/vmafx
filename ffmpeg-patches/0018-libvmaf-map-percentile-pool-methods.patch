From f0c60e8f88e5f0104fea0bbdb2307191e1d61a25 Mon Sep 17 00:00:00 2001
From: Lusoris <lusoris@pm.me>
Date: Tue, 8 Sep 2026 17:13:10 +0200
Subject: [PATCH] libvmaf: guard and document percentile pool methods

Patch 0005 already maps max and the percentile strings in the shared
pool_method_map. Extend that cumulative state instead of adding those
same mappings again: the duplicate hunk prevented patch 0018 from
applying after patches 0001-0017 on FFmpeg n9.0.1.

Guard the percentile mappings with VMAF_HAVE_PERCENTILE_POOLING so
libvmaf builds without that feature retain the mean fallback. Document
the feature macro rather than tying availability to a fork version.
---
 doc/filters.texi         | 6 +++++-
 libavfilter/vf_libvmaf.c | 2 ++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/doc/filters.texi b/doc/filters.texi
index 3534c87..f313182 100644
--- a/doc/filters.texi
+++ b/doc/filters.texi
@@ -17470,7 +17470,11 @@ Set the format of the log file (xml, json, csv, or sub).
 
 @item pool
 Set the pool method to be used for computing vmaf.
-Options are @code{min}, @code{harmonic_mean} or @code{mean} (default).
+Options are @code{min}, @code{max}, @code{harmonic_mean} or @code{mean}
+(default). When built against a libvmaf that defines
+@code{VMAF_HAVE_PERCENTILE_POOLING}, @code{median}, @code{perc5},
+@code{perc10} and @code{perc20} select the corresponding percentile of the
+per-frame scores, interpolated linearly between ranks.
 
 @item n_threads
 Set number of threads to be used when initializing libvmaf.
diff --git a/libavfilter/vf_libvmaf.c b/libavfilter/vf_libvmaf.c
index 7ff3ee5..74a41bf 100644
--- a/libavfilter/vf_libvmaf.c
+++ b/libavfilter/vf_libvmaf.c
@@ -949,6 +949,7 @@ static enum VmafPoolingMethod pool_method_map(const char *pool_method)
             return VMAF_POOL_METHOD_MEAN;
         if (!strcmp(pool_method, "harmonic_mean"))
             return VMAF_POOL_METHOD_HARMONIC_MEAN;
+#ifdef VMAF_HAVE_PERCENTILE_POOLING
         if (!strcmp(pool_method, "median"))
             return VMAF_POOL_METHOD_MEDIAN;
         if (!strcmp(pool_method, "perc5"))
@@ -957,6 +958,7 @@ static enum VmafPoolingMethod pool_method_map(const char *pool_method)
             return VMAF_POOL_METHOD_PERC10;
         if (!strcmp(pool_method, "perc20"))
             return VMAF_POOL_METHOD_PERC20;
+#endif
     }
 
     return VMAF_POOL_METHOD_MEAN;
-- 
