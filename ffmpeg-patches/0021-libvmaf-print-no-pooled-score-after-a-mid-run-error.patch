From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lusoris <lusoris@pm.me>
Date: Mon, 5 Oct 2026 13:54:19 +0200
Subject: [PATCH] libvmaf: print no pooled score after a mid-run error

A frame the libvmaf or libvmaf_cuda filter cannot score (a failed
picture copy or vmaf_read_pictures()) now stops the filter with one
error that names the frame and the error, and frees the frame. The
shared uninit() then prints no pooled score and writes no log: either
would cover fewer frames than were decoded. Upstream FFmpeg pools the
frames read before the error and prints their score.

uninit() also prints no score after a failed flush, and no score line
for a model whose pooled score failed (upstream printed an
uninitialised value there), and writes no log when any model failed.

This divergence from upstream is deliberate (VMAFx ADR-1768) and is
kept on every series refresh. The libvmaf_sycl and libvmaf_metal
filters follow the same rule (VMAFx ADR-1761).
---
 libavfilter/vf_libvmaf.c | 92 +++++++++++++++++++++++++++-------------
 1 file changed, 62 insertions(+), 30 deletions(-)

diff --git a/libavfilter/vf_libvmaf.c b/libavfilter/vf_libvmaf.c
index fc4c9a4ae3c659c33c5214b0e3612560a7a4df4b..a74f4122c29dd2e761d4d1371070199d98b328ae 100644
--- a/libavfilter/vf_libvmaf.c
+++ b/libavfilter/vf_libvmaf.c
@@ -313,6 +313,21 @@ static int copy_picture_data(LIBVMAFContext *s, AVFrame *src, VmafPicture *dst,
     return 0;
 }
 
+/* VMAFx ADR-1768: a frame the libvmaf or libvmaf_cuda filter cannot score
+ * stops the filter. The error is logged once, naming the frame; the shared
+ * uninit() then prints no pooled score and writes no log, since either
+ * would cover fewer frames than were decoded. Upstream FFmpeg pools and
+ * prints the frames read before the error; this divergence is deliberate. */
+static int stop_on_frame(AVFilterContext *ctx, LIBVMAFContext *s, AVFrame **dist,
+                         const char *what, int err, int ret)
+{
+    av_log(ctx, AV_LOG_ERROR, "%s: %s of frame %u failed (%s); the filter stops\n",
+           ctx->filter->name, what, s->frame_cnt, av_err2str(err));
+    s->stopped = 1;
+    av_frame_free(dist);
+    return ret;
+}
+
 static int do_vmaf(FFFrameSync *fs)
 {
     AVFilterContext *ctx = fs->parent;
@@ -326,6 +341,10 @@ static int do_vmaf(FFFrameSync *fs)
         return ret;
     if (ctx->is_disabled || !ref)
         return ff_filter_frame(ctx->outputs[0], dist);
+    if (s->stopped) {
+        av_frame_free(&dist);
+        return AVERROR(EINVAL);
+    }
 
     if (dist->color_range != ref->color_range) {
         av_log(ctx, AV_LOG_WARNING, "distorted and reference "
@@ -335,16 +354,15 @@ static int do_vmaf(FFFrameSync *fs)
     }
 
     err = copy_picture_data(s, ref, &pic_ref, s->bpc);
-    if (err) {
-        av_log(ctx, AV_LOG_ERROR, "problem during vmaf_picture_alloc.\n");
-        return AVERROR(ENOMEM);
-    }
+    if (err)
+        return stop_on_frame(ctx, s, &dist, "copying the reference picture",
+                             err, AVERROR(ENOMEM));
 
     err = copy_picture_data(s, dist, &pic_dist, s->bpc);
     if (err) {
-        av_log(ctx, AV_LOG_ERROR, "problem during vmaf_picture_alloc.\n");
         vmaf_picture_unref(&pic_ref);
-        return AVERROR(ENOMEM);
+        return stop_on_frame(ctx, s, &dist, "copying the distorted picture",
+                             err, AVERROR(ENOMEM));
     }
 
     /* Pelorus perceptual weighting (libvmaf ADR-1118): when the operator
@@ -394,11 +412,10 @@ static int do_vmaf(FFFrameSync *fs)
         }
     }
 
-    err = vmaf_read_pictures(s->vmaf, &pic_ref, &pic_dist, s->frame_cnt++);
-    if (err) {
-        av_log(ctx, AV_LOG_ERROR, "problem during vmaf_read_pictures.\n");
-        return AVERROR(EINVAL);
-    }
+    err = vmaf_read_pictures(s->vmaf, &pic_ref, &pic_dist, s->frame_cnt);
+    if (err)
+        return stop_on_frame(ctx, s, &dist, "vmaf_read_pictures", err, AVERROR(EINVAL));
+    s->frame_cnt++;
 
     return ff_filter_frame(ctx->outputs[0], dist);
 }
@@ -1020,20 +1037,34 @@ static av_cold void uninit(AVFilterContext *ctx)
 
     if (!s->frame_cnt)
         goto clean_up;
+    /* VMAFx ADR-1768: no pooled score and no log after an error (see
+     * stop_on_frame()). Upstream pools the frames read before it. */
+    if (s->stopped) {
+        av_log(ctx, AV_LOG_ERROR,
+               "%s: no pooled score: the filter stopped on the error above\n",
+               ctx->filter->name);
+        goto clean_up;
+    }
 
     err = vmaf_read_pictures(s->vmaf, NULL, NULL, 0);
     if (err) {
         av_log(ctx, AV_LOG_ERROR,
-               "problem flushing libvmaf context.\n");
+               "%s: flushing libvmaf after frame %u failed (%s); no pooled score\n",
+               ctx->filter->name, s->frame_cnt - 1, av_err2str(err));
+        goto clean_up;
     }
 
     for (unsigned i = 0; i < s->model_cnt; i++) {
-        double vmaf_score;
-        err = vmaf_score_pooled(s->vmaf, s->model[i], pool_method_map(s->pool),
-                                &vmaf_score, 0, s->frame_cnt - 1);
-        if (err) {
+        double vmaf_score = 0.0;
+        int pool_err = vmaf_score_pooled(s->vmaf, s->model[i],
+                                         pool_method_map(s->pool),
+                                         &vmaf_score, 0, s->frame_cnt - 1);
+        if (pool_err) {
+            /* No score line: a value printed after a failure reads as a result. */
             av_log(ctx, AV_LOG_ERROR,
-                   "problem getting pooled vmaf score.\n");
+                   "problem getting pooled vmaf score (%s).\n", av_err2str(pool_err));
+            err = pool_err;
+            continue;
         }
 
         av_log(ctx, AV_LOG_INFO, "VMAF score: %f\n", vmaf_score);
@@ -1283,26 +1314,27 @@ static int do_vmaf_cuda(FFFrameSync* fs)
         return err;
     if (ctx->is_disabled || !ref)
         return ff_filter_frame(ctx->outputs[0], dist);
+    if (s->stopped) {
+        av_frame_free(&dist);
+        return AVERROR(EINVAL);
+    }
 
     err = copy_picture_data_cuda(s->vmaf, device_hwctx, ref, &pic_ref,
                                  frames_ctx->sw_format);
-    if (err) {
-        av_log(ctx, AV_LOG_ERROR, "problem during copy_picture_data_cuda.\n");
-        return AVERROR(ENOMEM);
-    }
+    if (err)
+        return stop_on_frame(ctx, s, &dist, "copy_picture_data_cuda (reference)",
+                             err, AVERROR(ENOMEM));
 
     err = copy_picture_data_cuda(s->vmaf, device_hwctx, dist, &pic_dist,
                                  frames_ctx->sw_format);
-    if (err) {
-        av_log(ctx, AV_LOG_ERROR, "problem during copy_picture_data_cuda.\n");
-        return AVERROR(ENOMEM);
-    }
+    if (err)
+        return stop_on_frame(ctx, s, &dist, "copy_picture_data_cuda (distorted)",
+                             err, AVERROR(ENOMEM));
 
-    err = vmaf_read_pictures(s->vmaf, &pic_ref, &pic_dist, s->frame_cnt++);
-    if (err) {
-        av_log(ctx, AV_LOG_ERROR, "problem during vmaf_read_pictures.\n");
-        return AVERROR(EINVAL);
-    }
+    err = vmaf_read_pictures(s->vmaf, &pic_ref, &pic_dist, s->frame_cnt);
+    if (err)
+        return stop_on_frame(ctx, s, &dist, "vmaf_read_pictures", err, AVERROR(EINVAL));
+    s->frame_cnt++;
 
     return ff_filter_frame(ctx->outputs[0], dist);
 }
