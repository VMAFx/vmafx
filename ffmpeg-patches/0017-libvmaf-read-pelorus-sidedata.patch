From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lusoris <lusoris@pm.me>
Date: Sun, 14 Jun 2026 12:00:00 +0200
Subject: [PATCH] libvmaf: read Pelorus side-data and drive perceptual
 weighting

Wire the `libvmaf` filter's per-frame callback to read a Pelorus
side-data blob off the distorted AVFrame (AV_FRAME_DATA_SEI_UNREGISTERED,
UUID-routed, written by the upstream vf_pelorus_* filters) and hand it to
libvmaf via vmaf_set_perceptual_sidedata(). A new boolean AVOption
`perceptual_weight` (default 0 = OFF) gates the feature.

GOLDEN-GATE ISOLATION: when `perceptual_weight=0` (the default) the filter
never enables weighting, so scoring is byte-identical to upstream. When
`perceptual_weight=1` the weighting still only engages for frames that
actually carry a valid Pelorus blob; frames without one (and the Netflix
golden pairs, which have no side-data) are scored unweighted. A buffer
that is not a Pelorus blob is cleanly ignored: vmaf_set_perceptual_sidedata
rejects it (returns -ENOENT) without touching the score.

A frame can carry several SEI-unregistered entries, and Pelorus 1.5 writes
its blob in either the plain form or the COBS carrier form. The filter
offers every entry to vmaf_set_perceptual_sidedata, newest first as
Pelorus's own reader does, and stops at the first one accepted; an entry
refused for another reason than -ENOENT is logged at debug level.

The frame index passed to vmaf_set_perceptual_sidedata is s->frame_cnt,
matching the index handed to vmaf_read_pictures on the same call.

Companion to libvmaf ADR-1118 (perceptual spatial-pooling weighting) and
ADR-1113 (vendored Pelorus interop ABI). CI validates this patch by
replaying the full series against a clean n8.1 checkout
(git am --3way), not standalone git apply.
---
 libavfilter/vf_libvmaf.c | 52 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 52 insertions(+)

diff --git a/libavfilter/vf_libvmaf.c b/libavfilter/vf_libvmaf.c
index 3d1f93285a80e2dd0bbae688a55630113426603f..c383b444b44d7ba0d0bdcef62497336f886943ea 100644
--- a/libavfilter/vf_libvmaf.c
+++ b/libavfilter/vf_libvmaf.c
@@ -29,6 +29,9 @@
 #include <libvmaf.h>
 #include <libvmaf/dnn.h>
 
+#include <libvmaf/perceptual_weight.h>
+#include "libavutil/frame.h"
+
 #include "libavutil/avstring.h"
 #include "libavutil/mem.h"
 #include "libavutil/opt.h"
@@ -139,6 +142,7 @@ typedef struct LIBVMAFContext {
     int64_t cpumask;
     int64_t gpumask;
 
+    int   perceptual_weight;  /* Pelorus side-data perceptual weighting (ADR-1118) */
     VmafContext *vmaf;
     VmafModel **model;
     unsigned model_cnt;
@@ -173,6 +177,7 @@ static const AVOption libvmaf_options[] = {
     {"cpumask",      "Bitmask to disable SIMD ISAs (1=SSE2/NEON 2=SSE3 4=SSE4.1 8=AVX2 16=AVX512 32=AVX512ICL; 0=all enabled).", OFFSET(cpumask), AV_OPT_TYPE_INT64, {.i64=0}, 0, INT64_MAX, FLAGS},
     {"gpumask",      "Bitmask to disable GPU dispatch (1=disable CUDA; 0=all enabled).", OFFSET(gpumask),  AV_OPT_TYPE_INT64, {.i64=0}, 0, INT64_MAX, FLAGS},
     {"score_fmt",    "printf format for score values in log file (NULL=%.6f default; use %.17g for lossless).", OFFSET(score_fmt), AV_OPT_TYPE_STRING, {.str=NULL}, 0, 0, FLAGS},
+    {"perceptual_weight", "Perceptually re-weight VMAF pooling using Pelorus side-data (banding/variance maps). OFF by default; inert unless Pelorus side-data is present on the frame.", OFFSET(perceptual_weight), AV_OPT_TYPE_BOOL, {.i64=0}, 0, 1, FLAGS},
     { NULL }
 };
 
@@ -316,6 +321,53 @@ static int do_vmaf(FFFrameSync *fs)
         return AVERROR(ENOMEM);
     }
 
+    /* Pelorus perceptual weighting (libvmaf ADR-1118): when the operator
+     * opted in, enable weighting (idempotent — a plain bool set on the
+     * libvmaf context) and read any Pelorus side-data riding the distorted
+     * frame, registering it for this picture index. The blob is UUID-routed
+     * as an unregistered SEI; a foreign SEI (or no side-data at all) is
+     * cleanly ignored by vmaf_set_perceptual_sidedata, leaving the frame
+     * unweighted.
+     *
+     * GOLDEN-GATE ISOLATION: with perceptual_weight=0 (the default) this whole
+     * block is skipped, so scoring is byte-identical to upstream — and even
+     * when enabled, only frames that actually carry a valid Pelorus blob are
+     * re-weighted. The Netflix golden pairs have no side-data, so they score
+     * bit-exact regardless of this option. */
+    if (s->perceptual_weight) {
+        int i;
+
+        /* Idempotent: flips a bool on the libvmaf context. Re-asserting it per
+         * frame avoids a separate init-path hunk and is harmless. */
+        (void)vmaf_set_perceptual_weight_enabled(s->vmaf, 1);
+
+        /* A frame may carry several unregistered SEIs: one per Pelorus
+         * producer, in the blob or the zero-free carrier form (Pelorus
+         * interop ABI 1.5), and foreign ones. Scan them newest first, as
+         * Pelorus's own reader does, and register the first one libvmaf
+         * accepts; -ENOENT means "not Pelorus side data", keep looking. */
+        for (i = dist->nb_side_data - 1; i >= 0; i--) {
+            const AVFrameSideData *sd = dist->side_data[i];
+            int pw_err;
+
+            if (sd->type != AV_FRAME_DATA_SEI_UNREGISTERED || !sd->data || !sd->size)
+                continue;
+            pw_err = vmaf_set_perceptual_sidedata(s->vmaf, sd->data, sd->size,
+                                                  s->frame_cnt);
+            if (!pw_err)
+                break;
+            if (pw_err != AVERROR(ENOENT)) {
+                /* -EPROTO (corrupt carrier, ABI mismatch) and other soft
+                 * failures are non-fatal: log at debug level and try an
+                 * older entry; with none left the frame is scored
+                 * unweighted rather than failing the whole graph. */
+                av_log(ctx, AV_LOG_DEBUG,
+                       "perceptual_weight: side-data entry %d for frame %u not "
+                       "usable (%d).\n", i, s->frame_cnt, pw_err);
+            }
+        }
+    }
+
     err = vmaf_read_pictures(s->vmaf, &pic_ref, &pic_dist, s->frame_cnt++);
     if (err) {
         av_log(ctx, AV_LOG_ERROR, "problem during vmaf_read_pictures.\n");
