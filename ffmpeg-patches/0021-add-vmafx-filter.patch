 doc/filters.texi               |  151 ++++
 libavfilter/Makefile           |    2 +
 libavfilter/allfilters.c       |    2 +
 libavfilter/vf_vmafx.c         | 1498 ++++++++++++++++++++++++++++++++
 libavfilter/vf_vmafx_options.h |  152 ++++
 6 files changed, 1810 insertions(+)
 create mode 100644 libavfilter/vf_vmafx.c
 create mode 100644 libavfilter/vf_vmafx_options.h

