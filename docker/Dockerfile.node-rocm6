# docker/Dockerfile.node-rocm6 — vmafx-node with ROCm 6 runtime.
# Convenience wrapper around Dockerfile.node with GPU_RUNTIME=rocm6.
#
# ADR-0713: vmafx-node Go worker binary.

FROM docker/Dockerfile.node AS node-rocm6
ARG GPU_RUNTIME=rocm6
