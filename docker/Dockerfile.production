# SPDX-License-Identifier: EUPL-1.2
# Copyright 2026 Lusoris
#
# docker/Dockerfile.production — VMAFX production runtime image
#
# Multi-stage build producing two targets:
#   --target cli     : vmaf CLI + libvmaf.so  (ENTRYPOINT = vmaf binary)
#   --target server  : vmaf-mcp JSON-RPC server (ENTRYPOINT = vmaf-mcp --transport http)
# and the corresponding source of their copyleft parts (ADR-1503, ADR-1513):
#   --target cli-source-export, --target server-source-export
#
# Licences (ADR-1513): each target carries /usr/local/share/vmafx/licenses/
# (THIRD_PARTY_NOTICES.txt and every licence text, written by
# tools/rc1-tester/image/licensing.py from tools/rc1-tester/image/licensing.json)
# and cannot be built without passing the licence check of its artifact kind
# (production-cli-image, production-server-image).
#
# Base: gcr.io/distroless/cc-debian13 for the CLI; python:3.14-slim for the
# server so its interpreter and native wheels stay on one Debian 13 ABI.
# ADR-0698: vmafx-production-dockerfile
# ADR-1129: release-container-runtime-alignment
#
# Build args (all optional):
#   VMAF_BUILD_JOBS     — ninja parallelism (default: 4)
#   VMAFX_SOURCE_COMMIT — commit the notices name as the VMAFx source (EUPL-1.2 Art. 5)
#   VMAFX_IMAGE_TAG     — tag the notices and the source offer name

# ---------------------------------------------------------------------------
# Stage 1 — builder: compile libvmaf + vmaf CLI
# ---------------------------------------------------------------------------
# Debian 13 is the oldest supported production build ABI. The CLI runtime below
# is the matching distroless Debian 13 image; do not move it back to Debian 12.
# Base images come from build-config.env -- the single source of truth for
# every container base in this repository. These defaults are mirrors kept in
# sync by scripts/ci/check-base-image-single-source.sh; edit the config, not
# these lines, then run that script with --write.
ARG RELEASE_BUILDER_BASE="debian:13-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f"
ARG RELEASE_PYTHON_BASE="python:3.14-slim@sha256:f85c5697265c178cc6887276c55fe16cf3d14ca35c3df6a5eab3b360534a55d2"
ARG RELEASE_RUNTIME_CC="gcr.io/distroless/cc-debian13:nonroot@sha256:e792ab3d241a468a4fd7519ddbbebe66b49b5f365771716ea688ad40b6c6f1c2"

FROM ${RELEASE_BUILDER_BASE} AS builder

ARG VMAF_BUILD_JOBS=4
ARG DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.title="vmafx-builder"
LABEL org.opencontainers.image.description="Build stage: libvmaf + vmaf CLI (release/stripped)"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"

# Install only build-time deps; nothing carried into the runtime stage
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        meson \
        ninja-build \
        nasm \
        pkg-config \
        ca-certificates \
        xxd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# Build release + strip; CPU-only (no CUDA/SYCL/HIP in production
# default image). ONNX Runtime DNN is disabled to remove the onnxruntime.so
# dependency from the runtime image — users who need tiny-AI scoring should
# run the server variant where the Python venv carries onnxruntime.
RUN meson setup /build core \
        --buildtype=release \
        --strip \
        -Denable_cuda=false \
        -Denable_sycl=false \
        -Denable_dnn=disabled \
        -Denable_avx512=true \
        -Denable_tests=false \
    && ninja -C /build -j"${VMAF_BUILD_JOBS}"

# Collect outputs under /dist so the COPY step in the runtime stage is simple
RUN mkdir -p /dist/lib /dist/bin /dist/model \
    && find /build/src -maxdepth 1 \( -name 'libvmaf.so*' -o -name 'libvmafx.so*' \) -not -type d \
        -exec cp {} /dist/lib/ \; \
    && cp /build/tools/vmaf /dist/bin/ \
    && cp -r model/. /dist/model/

# The licence and copyright of every repository file the build compiled, read
# from `ninja -t deps` and the files' SPDX headers (ADR-1503 rule 2).
RUN mkdir /licence-inputs \
    && python3 tools/rc1-tester/image/licensing.py scan-build --build /build --repo /src \
        --out /licence-inputs/vmafx-sources.json

# ---------------------------------------------------------------------------
# Stage 2 — python-deps: install vmaf-mcp + vmaf-tune into a virtualenv
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS python-deps

ARG DEBIAN_FRONTEND=noninteractive

# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY mcp-server/vmaf-mcp /build/vmaf-mcp
COPY tools/vmaf-tune      /build/vmaf-tune
COPY requirements/locks/package-build.txt /build/requirements/package-build.txt

# Build the two local projects without an isolated resolver in a build-only
# venv, so the build tools never reach the image (ADR-1503 rule 1), then
# install only hash-locked external dependencies plus the locally built wheels
# into the relocatable runtime venv at /venv.
RUN python3 -m venv /build-venv \
    && /build-venv/bin/pip install --no-cache-dir --require-hashes \
        -r /build/requirements/package-build.txt \
    && mkdir -p /wheels \
    && /build-venv/bin/python -m build --no-isolation --wheel --outdir /wheels /build/vmaf-mcp \
    && /build-venv/bin/python -m build --no-isolation --wheel --outdir /wheels /build/vmaf-tune \
    && python3 -m venv /venv \
    && /venv/bin/pip install --no-cache-dir --require-hashes \
        -r /build/vmaf-mcp/requirements-production-lock.txt \
    && /venv/bin/pip install --no-cache-dir --no-deps /wheels/*.whl

# ---------------------------------------------------------------------------
# licence-texts: the recorded licence texts that are not in the repository
# (CPython's Doc/license.rst and the pinned `fetched_texts`), by SHA-256
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS licence-texts
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/licensing \
    python3 /licensing/licensing.py fetch-texts --artifact production-server-image \
        --python-version "$(python3 -c 'import platform; print(platform.python_version())')" \
        --out /texts

# ---------------------------------------------------------------------------
# Stage 3 — runtime-base: CLI runtime layer (no shell, distroless)
# ---------------------------------------------------------------------------
FROM ${RELEASE_RUNTIME_CC} AS runtime-base

# OCI image labels — version baked in at build time via CI; left as
# placeholders here so local builds still produce labelled images. The
# licence expression is that of the VMAFx files (ADR-1250); every component's
# terms are in /usr/local/share/vmafx/licenses/THIRD_PARTY_NOTICES.txt.
LABEL org.opencontainers.image.title="vmafx"
LABEL org.opencontainers.image.description="VMAFX production runtime — libvmaf + vmaf CLI / MCP server. Licences: /usr/local/share/vmafx/licenses/THIRD_PARTY_NOTICES.txt"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"
LABEL org.opencontainers.image.licenses="EUPL-1.2 AND BSD-2-Clause-Patent AND BSD-3-Clause AND BSD-2-Clause AND ISC AND MIT AND Unlicense AND LicenseRef-LIVE-BRISQUE"
LABEL org.opencontainers.image.vendor="Lusoris"

# Copy libvmaf.so* into /usr/local/lib and set up symlinks
COPY --from=builder /dist/lib/ /usr/local/lib/
COPY --from=builder /dist/model/ /usr/local/share/vmafx/model/

ENV LD_LIBRARY_PATH="/usr/local/lib"
ENV VMAF_MODEL_PATH="/usr/local/share/vmafx/model"

# ---------------------------------------------------------------------------
# cli-assembled: the CLI image's content before its notices
# ---------------------------------------------------------------------------
FROM runtime-base AS cli-assembled

COPY --from=builder /dist/bin/vmaf /usr/local/bin/vmaf

# ---------------------------------------------------------------------------
# cli-notices: the distroless image has no interpreter, so its notices and
# licence texts are written on a copy of its tree (ADR-1503 rule 4)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS cli-notices
COPY --from=cli-assembled / /rootfs
ARG VMAFX_SOURCE_COMMIT=unknown
ARG VMAFX_IMAGE_TAG=unknown
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=builder,source=/licence-inputs,target=/licence-inputs \
    --mount=type=bind,from=licence-texts,source=/texts,target=/texts \
    python3 /repo/tools/rc1-tester/image/licensing.py notices --artifact production-cli-image \
        --root /rootfs --repo /repo --build-scan /licence-inputs/vmafx-sources.json \
        --texts /texts --source-commit "${VMAFX_SOURCE_COMMIT}" --tag "${VMAFX_IMAGE_TAG}"

FROM cli-assembled AS cli-with-notices
COPY --from=cli-notices /rootfs/usr/local/share/vmafx/licenses /usr/local/share/vmafx/licenses

# ---------------------------------------------------------------------------
# cli-licence-check: every file of the CLI image has a recorded licence
# (ADR-1503 rule 3); `cli` copies its receipt, so it cannot be built without it
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS cli-licence-check
RUN --mount=type=bind,from=cli-with-notices,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=builder,source=/licence-inputs,target=/licence-inputs \
    mkdir /out \
    && python3 /repo/tools/rc1-tester/image/licensing.py check --artifact production-cli-image \
        --root /rootfs --repo /repo --build-scan /licence-inputs/vmafx-sources.json \
        --python-version none --receipt /out/licence-check.json

# ---------------------------------------------------------------------------
# cli-source-export: the corresponding source of the CLI image's copyleft
# parts (glibc, the GCC runtime), published as <tag>-source (ADR-1503 rule 5)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS cli-source-fetch
# Only /sources leaves this stage, so its package lists need no cleanup.
# hadolint ignore=DL3009
RUN --mount=type=bind,from=cli-with-notices,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && python3 /repo/tools/rc1-tester/image/licensing.py sources --artifact production-cli-image \
        --root /rootfs --repo /repo --out /sources.list \
    && python3 /repo/tools/rc1-tester/image/licensing.py fetch-sources --list /sources.list \
        --out /sources

FROM scratch AS cli-source-export
COPY --from=cli-source-fetch /sources /sources

# ---------------------------------------------------------------------------
# Stage 4 (target: cli) — CLI-only image
# Entrypoint: vmaf binary
# ---------------------------------------------------------------------------
FROM cli-with-notices AS cli

COPY --from=cli-licence-check /out/licence-check.json /usr/local/share/vmafx/licence-check.json

# Drop privileges — distroless cc-debian13 ships a `nonroot` user at
# UID:GID 65532:65532. Trivy DS-0002 / CIS-Docker 4.1.
USER nonroot:nonroot

ENTRYPOINT ["/usr/local/bin/vmaf"]

# ---------------------------------------------------------------------------
# server-assembled: the MCP server image's content and its notices
# The vmaf binary is also present so the MCP server can shell out to it.
# ---------------------------------------------------------------------------
# A CPython virtualenv is not self-contained: its `python` entry is a symlink
# to the base interpreter. Use the exact same pinned Python 3.14 image as the
# dependency stage so the interpreter, stdlib, native wheels, and OS ABI match.
FROM ${RELEASE_PYTHON_BASE} AS server-assembled

LABEL org.opencontainers.image.title="vmafx-server"
LABEL org.opencontainers.image.description="VMAFX MCP server — libvmaf + vmaf CLI + Python 3.14. Licences: /usr/local/share/vmafx/licenses/THIRD_PARTY_NOTICES.txt"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"
LABEL org.opencontainers.image.licenses="EUPL-1.2 AND BSD-2-Clause-Patent AND BSD-3-Clause AND BSD-2-Clause AND ISC AND MIT AND Unlicense AND LicenseRef-LIVE-BRISQUE"
LABEL org.opencontainers.image.vendor="Lusoris"

COPY --from=builder /dist/lib/ /usr/local/lib/
COPY --from=builder /dist/model/ /usr/local/share/vmafx/model/
COPY --from=builder /dist/bin/vmaf /usr/local/bin/vmaf

# Virtualenv with vmaf-mcp + vmaf-tune installed
COPY --from=python-deps /venv /venv

# The notices and licence texts (ADR-1503 rule 4). The repository inputs are
# bind mounts, so nothing but /usr/local/share/vmafx/licenses stays.
ARG VMAFX_SOURCE_COMMIT=unknown
ARG VMAFX_IMAGE_TAG=unknown
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=builder,source=/licence-inputs,target=/licence-inputs \
    --mount=type=bind,from=licence-texts,source=/texts,target=/texts \
    python3 /repo/tools/rc1-tester/image/licensing.py notices --artifact production-server-image \
        --root / --repo /repo --build-scan /licence-inputs/vmafx-sources.json \
        --texts /texts --source-commit "${VMAFX_SOURCE_COMMIT}" --tag "${VMAFX_IMAGE_TAG}"

# ---------------------------------------------------------------------------
# server-licence-check: every file of the server image has a recorded licence
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS server-licence-check
RUN --mount=type=bind,from=server-assembled,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=builder,source=/licence-inputs,target=/licence-inputs \
    mkdir /out \
    && python3 /repo/tools/rc1-tester/image/licensing.py check --artifact production-server-image \
        --root /rootfs --repo /repo --build-scan /licence-inputs/vmafx-sources.json \
        --python-version "$(python3 -c 'import platform; print(platform.python_version())')" \
        --receipt /out/licence-check.json

# ---------------------------------------------------------------------------
# server-source-export: Debian sources of every installed package and the
# source RPMs of the GCC runtimes grafted into the numpy and scipy wheels,
# published as <tag>-server-source (ADR-1503 rule 5)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS server-source-fetch
# Only /sources leaves this stage, so its package lists need no cleanup.
# hadolint ignore=DL3009
RUN --mount=type=bind,from=server-assembled,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && python3 /repo/tools/rc1-tester/image/licensing.py sources --artifact production-server-image \
        --root /rootfs --repo /repo --out /sources.list \
    && python3 /repo/tools/rc1-tester/image/licensing.py fetch-sources --list /sources.list \
        --out /sources

FROM scratch AS server-source-export
COPY --from=server-source-fetch /sources /sources

# ---------------------------------------------------------------------------
# Stage 5 (target: server) — MCP server image
# Entrypoint: vmaf-mcp --transport http
# ---------------------------------------------------------------------------
FROM server-assembled AS server

COPY --from=server-licence-check /out/licence-check.json /usr/local/share/vmafx/licence-check.json

ENV PATH="/venv/bin:/usr/local/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/lib"
ENV VMAF_MODEL_PATH="/usr/local/share/vmafx/model"
ENV VMAF_BINARY="/usr/local/bin/vmaf"
# The Python HTTP transport defaults to loopback for host installs. A container
# port is unreachable unless the image explicitly opts into all-interface bind.
ENV VMAFX_MCP_HTTP_BIND="0.0.0.0"

EXPOSE 8080

# Drop privileges with the same UID:GID as the distroless CLI image. The MCP
# server binds 8080 (>1024, unprivileged); a passwd entry is not required.
# Trivy DS-0002 / CIS-Docker 4.1.
USER 65532:65532

ENTRYPOINT ["/venv/bin/vmaf-mcp", "--transport", "http"]
