# SPDX-License-Identifier: EUPL-1.2
# Copyright 2026 Lusoris
#
# docker/Dockerfile.node — vmafx-node worker image
#
# Multi-stage build producing four targets:
#   --target node-cpu    : CPU-only node worker (explicit target; smallest image)
#   --target node-cuda   : CUDA 13 node worker (NVENC + GPU scoring)
#   --target node-rocm   : ROCm 10 node worker (AMF + HIP scoring)
#   --target node-sycl   : Intel oneAPI 2026 node worker (QSV + SYCL scoring)
#
# Every target includes:
#   - vmafx-node Go binary (cmd/vmafx-node)
#   - libvmaf.so (built from core/)
#   - ffmpeg n9.0.2 with the fork's ffmpeg-patches/ applied
#   - Full soft-codec inventory: libx264, libx265, libvpx, libsvtav1, libdav1d
#   - libvmaf filter + fork-specific VMAF filters compiled in
#   - rclone, and for its mount mode the setuid FUSE helper fusermount3 with the
#     util-linux mount and umount it runs (ADR-1593)
#
# Licences (ADR-1513): node-cpu carries /usr/local/share/vmafx/licenses/
# (THIRD_PARTY_NOTICES.txt and every licence text, written by
# tools/rc1-tester/image/licensing.py, artifact production-node-image) and
# copies the receipt of `node-licence-check`; `node-source-export` holds the
# corresponding source (FFmpeg as built, the Debian sources of every library
# copied out of a package, the Go modules of rclone and the copyleft modules of
# vmafx-node), published as <tag>-source. FFmpeg is GPL-3.0-or-later
# (--enable-gpl --enable-version3); never --enable-nonfree, which makes the
# result unredistributable. rclone is built from its release's module source
# so that its corresponding source is exact (the official image's binary
# reports vcs.modified=true).
#
# FFmpeg version policy (ADR-0717):
#   Pinned to the latest stable tagged release at image-build time.
#   The reviewed stable tag is owned by build-config.env and mirrored below.
#   Option A (pin to latest tag) was chosen over Option B (rolling
#   release/8.x branch) to maintain reproducible builds.
#
# Build args (all optional):
#   VMAF_BUILD_JOBS  — ninja / make parallelism (default: 4)
#   FFMPEG_TAG       — FFmpeg release tag to pin (default: n9.0.2)
#   SVTAV1_VERSION   — SVT-AV1 release tag (default: 4.2.0)
#
# ADR-0709: vmafx-phase4b-distributed-platform (Phase 4b umbrella)
# ADR-0717: vmafx-node-ffmpeg-latest (this Dockerfile + version policy)
# ADR-1129: release-container-runtime-alignment

# Overridden at build time by the publish workflows (--build-arg
# VMAFX_VERSION=<PUBLISH_TAG>). Kept at `dev` like Dockerfile.operator and
# Dockerfile.go-server: a baked release number here would be a coordinated
# version marker nothing in the release path ever reads. See ADR-1151.
ARG VMAFX_VERSION=dev

# ---------------------------------------------------------------------------
# Stage 1 — vmaf-builder: compile libvmaf + vmaf CLI from core/
# ---------------------------------------------------------------------------
# Base images come from build-config.env -- the single source of truth for
# every container base in this repository. These defaults are mirrors kept in
# sync by scripts/ci/check-base-image-single-source.sh; edit the config, not
# these lines, then run `make base-images-sync`.
ARG RELEASE_BUILDER_BASE="debian:13-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a"
ARG RELEASE_GO_BASE="golang:1.27-trixie@sha256:3b77fc618ec235a1ab412de7737f120dd507c57e8d87de4cbb7994fb94275ed5"
ARG RELEASE_PYTHON_BASE="python:3.14-slim@sha256:c3e521df8b2b498a7a682e7e18676771cb80c6b75b8699af886b2d554ce40151"
ARG RELEASE_RUNTIME_CC="gcr.io/distroless/cc-debian13:nonroot@sha256:e792ab3d241a468a4fd7519ddbbebe66b49b5f365771716ea688ad40b6c6f1c2"
ARG CUDA_RUNTIME="ubuntu:26.04@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7"
ARG ROCM_RUNTIME="rocm/dev-ubuntu-26.04:10.0.0-full@sha256:8ebc02ee1aefb6b7c0e952b4088542133bad8805d19730db92cc61be673421d1"
ARG ONEAPI_RUNTIME="debian:13-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a"

# Vendor runtime libraries as named stages: a digest-pinned
# `COPY --from=<image>` is a base-image pin that no FROM-oriented search
# finds. BuildKit prunes whichever the selected target does not use.
FROM ${CUDA_RUNTIME} AS cuda-runtime-libs
COPY build-config.env scripts/ci/install-cuda-toolkit.sh /tmp/
RUN /tmp/install-cuda-toolkit.sh --mode=runtime /tmp \
    && rm -rf /tmp/install-cuda-toolkit.sh /tmp/build-config.env /var/lib/apt/lists/*
FROM ${ROCM_RUNTIME} AS rocm-runtime-libs
# ONEAPI_RUNTIME is the release track's Debian 13; Intel's SYCL runtime comes
# from its apt repository at the build-config.env pin (ADR-1368), the same
# installer the oneAPI production image's final stage runs.
FROM ${ONEAPI_RUNTIME} AS oneapi-runtime-libs
COPY build-config.env /tmp/vmafx/build-config.env
COPY scripts/ci/install-intel-oneapi.sh /tmp/vmafx/scripts/ci/install-intel-oneapi.sh
RUN bash /tmp/vmafx/scripts/ci/install-intel-oneapi.sh --mode=runtime /tmp/vmafx \
    && rm -rf /tmp/vmafx /var/lib/apt/lists/*
# rclone (ADR-0719) from its release's module source: `go install` verifies
# every module against the checksum database, so the -source image can hold the
# exact source the binary was built from (LGPL-3.0 cloudsoda/sddl, MPL-2.0
# modules). RCLONE_VERSION mirrors build-config.env; rclone reads RCLONE_*
# variables as flags, so the smoke run drops it from the environment.
FROM ${RELEASE_GO_BASE} AS rclone-bin
ARG RCLONE_VERSION=v1.75.1
RUN CGO_ENABLED=0 GOFLAGS=-mod=mod go install -trimpath \
        -ldflags "-s -X github.com/rclone/rclone/fs.Version=${RCLONE_VERSION}" \
        "github.com/rclone/rclone@${RCLONE_VERSION}" \
    && install -D -m 0755 /go/bin/rclone /usr/local/bin/rclone \
    && env -u RCLONE_VERSION /usr/local/bin/rclone version

# fuse-tools: what `rclone mount` needs in the distroless image (ADR-1593).
# rclone mounts through the setuid helper fusermount3 (Debian fuse3), and
# fusermount3 runs /bin/mount and /bin/umount (util-linux) to record a mount
# whenever /etc/mtab exists, which Docker creates in every container. The
# three programs and the libraries they link keep their Debian paths:
# fusermount3 starts them as root with an empty environment, so
# LD_LIBRARY_PATH would not reach them. mount and umount lose their setuid bit
# (only fusermount3 runs them, already as root). record-copied-debian-libs
# records their packages for the licence gate, as it does FFmpeg's libraries.
FROM ${RELEASE_BUILDER_BASE} AS fuse-tools
ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends fuse3 mount \
    && rm -rf /var/lib/apt/lists/*
COPY --chmod=0755 scripts/ci/record-copied-debian-libs.sh /usr/local/bin/record-copied-debian-libs
RUN programs="/usr/bin/fusermount3 /usr/bin/mount /usr/bin/umount" \
    && for program in ${programs}; do printf '%s /usr/bin\n' "${program}" >> /tmp/fuse-origins.txt; done \
    && ldd ${programs} > /tmp/fuse-ldd.txt \
    && if grep -q 'not found' /tmp/fuse-ldd.txt; then cat /tmp/fuse-ldd.txt >&2; exit 1; fi \
    && awk '/=> \// { print $3 }' /tmp/fuse-ldd.txt | sort -u \
        | while IFS= read -r library; do \
            case "$(basename "${library}")" in \
                ld-linux-*|libc.so.*|libdl.so.*|libgcc_s.so.*|libm.so.*|libpthread.so.*|librt.so.*|libstdc++.so.*) \
                    continue \
                    ;; \
            esac; \
            real="$(realpath "${library}")"; \
            dir="$(dirname "${real}")"; \
            install -D -m 0644 "${real}" "/fuse-tools/root${dir}/$(basename "${library}")" || exit 1; \
            printf '%s %s\n' "${library}" "${dir}" >> /tmp/fuse-origins.txt; \
        done \
    && install -D -m 4755 /usr/bin/fusermount3 /fuse-tools/root/usr/bin/fusermount3 \
    && install -m 0755 /usr/bin/mount /usr/bin/umount /fuse-tools/root/usr/bin/ \
    && record-copied-debian-libs /tmp/fuse-origins.txt /fuse-tools/copied-packages /usr/bin \
    && test "$(wc -l < /fuse-tools/copied-packages/packages.list)" -eq "$(wc -l < /tmp/fuse-origins.txt)"

FROM ${RELEASE_BUILDER_BASE} AS vmaf-builder

ARG VMAF_BUILD_JOBS=4
ARG DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.title="vmafx-node-vmaf-builder"
LABEL org.opencontainers.image.description="Build stage: libvmaf + vmaf CLI (release/stripped)"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"

# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        make \
        meson \
        ninja-build \
        nasm \
        pkg-config \
        xxd \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
# Keep the expensive C/C++ layer independent of Go, workflow, and docs edits.
COPY core/ core/
COPY model/ model/
# core/test/meson.build registers this source guard during configure, even
# when the image only needs release binaries. Keep the partial build context
# closed over every configure-time input rather than disabling the test.
COPY scripts/ci/check-msvc-clz-shim.sh scripts/ci/check-msvc-clz-shim.sh

RUN meson setup /build core \
        --buildtype=release \
        --strip \
        -Denable_cuda=false \
        -Denable_sycl=false \
        -Denable_dnn=disabled \
        -Denable_avx512=true \
        -Denable_tests=false \
    && ninja -C /build -j"${VMAF_BUILD_JOBS}"

# The SONAME chain only: the glob would also take Meson's object directory
# libvmaf.so.3.0.0.p/.
RUN mkdir -p /dist/lib/pkgconfig /dist/bin /dist/model \
    && find /build/src -maxdepth 1 \( -name 'libvmaf.so*' -o -name 'libvmafx.so*' \) \
        \( -type f -o -type l \) -exec cp -a {} /dist/lib/ \; \
    && cp /build/meson-private/libvmaf.pc /dist/lib/pkgconfig/libvmaf.pc \
    && cp /build/meson-private/libvmafx.pc /dist/lib/pkgconfig/libvmafx.pc \
    && cp /build/tools/vmaf /dist/bin/ \
    && cp -r model/. /dist/model/ \
    && test -f /dist/model/vmaf_v0.6.1.json

# The licence and copyright of every repository file the build compiled
# (ADR-1503 rule 2); bind mounts keep the build layer above independent of them.
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/src/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/src/REUSE.toml \
    mkdir /licence-inputs \
    && python3 tools/rc1-tester/image/licensing.py scan-build --build /build --repo /src \
        --out /licence-inputs/vmafx-sources.json

# ---------------------------------------------------------------------------
# Stage 2 — ffmpeg-builder: build ffmpeg n9.0.2 with ffmpeg-patches/ applied
# ---------------------------------------------------------------------------
# Shared across all node variants (cpu/cuda/rocm/sycl). The CUDA/ROCm/SYCL
# variants add HW encoder support on top of this common base.
#
# libaom is intentionally excluded — see dev/Containerfile §"NOTE: libaom"
# for the detailed rationale. The core issue: ffmpeg-patches/0007 references
# aom_roi_map_t fields not present in any released libaom version.
# SVT-AV1 (libsvtav1) covers the AV1 production lane.
FROM ${RELEASE_BUILDER_BASE} AS ffmpeg-deps-base

ARG DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        make \
        cmake \
        git \
        nasm \
        yasm \
        pkg-config \
        ca-certificates \
        libx264-dev \
        libx265-dev \
        libvpx-dev \
        libdav1d-dev \
        libmp3lame-dev \
        libopus-dev \
        libvorbis-dev \
        libass-dev \
        libfreetype-dev \
        libfontconfig-dev \
        libfribidi-dev \
        libva-dev \
        libvdpau-dev \
    && rm -rf /var/lib/apt/lists/*

# ---- libvmaf headers + library for --enable-libvmaf configure probe --------
COPY --from=vmaf-builder /dist/lib/ /usr/local/lib/
# Copy public headers from source tree (pkg-config consumers need them).
COPY core/include/libvmaf/ /usr/local/include/libvmaf/
# Meson generated this file from vmaf_soname_version, the authoritative
# interface version consumed by FFmpeg's pkg-config range probe.
RUN ldconfig

# ---- SVT-AV1 source build --------------------------------------------------
# Ubuntu's libsvtav1-dev omits SvtAv1Enc.pc. Build from source so
# FFmpeg's --enable-libsvtav1 configure probe resolves correctly.
ARG SVTAV1_VERSION=4.2.0
RUN git clone --depth=1 --branch "v${SVTAV1_VERSION}" \
        https://gitlab.com/AOMediaCodec/SVT-AV1.git /tmp/SVT-AV1 \
    && cmake -S /tmp/SVT-AV1 -B /tmp/SVT-AV1/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_APPS=OFF \
        -DBUILD_TESTING=OFF \
    && cmake --build /tmp/SVT-AV1/build -j"$(nproc)" \
    && cmake --install /tmp/SVT-AV1/build \
    && ldconfig \
    && install -D -m 0644 -t /usr/local/share/vmafx/svt-av1 \
        /tmp/SVT-AV1/LICENSE.md /tmp/SVT-AV1/PATENTS.md \
    && rm -rf /tmp/SVT-AV1

# ---------------------------------------------------------------------------
# Stage 3 — ffmpeg-builder-cpu: build ffmpeg with CPU-only vmaf integration
# ---------------------------------------------------------------------------
FROM ffmpeg-deps-base AS ffmpeg-builder-cpu

ARG FFMPEG_TAG=n9.0.2
ARG FFMPEG_REMOTE=https://github.com/FFmpeg/FFmpeg.git

# Restate the shell in this named stage so static Dockerfile linters can prove
# that the dependency-closure pipeline below fails on any producer error.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY ffmpeg-patches/ /src/ffmpeg-patches/
COPY scripts/ci/checkout-annotated-tag.sh /usr/local/bin/checkout-annotated-tag

RUN checkout-annotated-tag "${FFMPEG_REMOTE}" "${FFMPEG_TAG}" /src/ffmpeg

WORKDIR /src/ffmpeg

# Apply the fork's patch series in order.
# See ffmpeg-patches/README.md for the apply invariants.
RUN git config user.email "vmafx-node-builder@localhost" \
    && git config user.name "vmafx-node builder" \
    && while IFS= read -r patch_name; do \
        case "${patch_name}" in \
            ""|"#"*) continue ;; \
        esac ; \
        echo "applying ffmpeg-patches/${patch_name}" ; \
        git am --3way "/src/ffmpeg-patches/${patch_name}" \
            || (echo "FATAL: patch ${patch_name} did not apply against ${FFMPEG_TAG}" && exit 1) ; \
    done < /src/ffmpeg-patches/series.txt

RUN multiarch="$(gcc -print-multiarch)" \
    && PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:/usr/local/lib/${multiarch}/pkgconfig:/usr/lib/${multiarch}/pkgconfig:/usr/lib/pkgconfig" \
    ./configure \
        --fatal-warnings \
        --prefix=/ffmpeg-install \
        --enable-gpl --enable-version3 \
        --enable-libvmaf \
        --enable-libx264 --enable-libx265 \
        --enable-libvpx --enable-libdav1d \
        --enable-libsvtav1 \
        --enable-libmp3lame --enable-libopus --enable-libvorbis \
        --enable-libass --enable-libfreetype --enable-libfontconfig --enable-libfribidi \
        --extra-cflags="-I/usr/local/include" \
        --extra-ldflags="-L/usr/local/lib" \
    && make -j"$(nproc)" 2>&1 | tee /tmp/ffmpeg-build.log \
    && awk '/^\+\+\+ b\//{sub(/^\+\+\+ b\//,""); print}' \
        /src/ffmpeg-patches/*.patch | sort -u > /tmp/ffmpeg-patched-files.txt \
    && if [ ! -s /tmp/ffmpeg-patched-files.txt ]; then \
        echo "FATAL: derived no patched-file list; the warning gate would pass vacuously" >&2; \
        exit 1; \
    fi \
    && if grep -Ei '(^|[[:space:]])warning([[:space:]#:])' /tmp/ffmpeg-build.log \
        | grep -Ff /tmp/ffmpeg-patched-files.txt; then \
        echo "FATAL: a file this fork patches emitted compiler warnings" >&2; \
        exit 1; \
    fi \
    && rm /tmp/ffmpeg-build.log \
    && make install

# The corresponding source of the GPL-3.0-or-later build (ADR-1513): the patched
# tree exactly as compiled (`git am` committed the series, gzip at level 9 per
# ADR-1591), the configure line, and FFmpeg's own licence files for the image.
RUN mkdir -p /ffmpeg-source /ffmpeg-install/licenses \
    && git archive --format=tar.gz -9 --prefix="ffmpeg-${FFMPEG_TAG}-vmafx/" \
        -o "/ffmpeg-source/ffmpeg-${FFMPEG_TAG}-vmafx.tar.gz" HEAD \
    && sed -n 's/^FFMPEG_CONFIGURATION=//p' ffbuild/config.mak > /ffmpeg-source/CONFIGURE.txt \
    && test -s /ffmpeg-source/CONFIGURE.txt \
    && cp -r /src/ffmpeg-patches /ffmpeg-source/ffmpeg-patches \
    && cp LICENSE.md COPYING.GPLv2 COPYING.GPLv3 COPYING.LGPLv2.1 COPYING.LGPLv3 \
        /ffmpeg-install/licenses/

# Stage the complete non-glibc dependency closure for ffmpeg/ffprobe. `ldd`
# resolves the native Debian multiarch directory on both amd64 and arm64, so
# the final image never hard-codes `/usr/lib/x86_64-linux-gnu`. The distroless
# Debian 13 base supplies the excluded core C/C++ runtime libraries.
RUN mkdir -p /ffmpeg-install/runtime-libs \
    && LD_LIBRARY_PATH=/ffmpeg-install/lib:/usr/local/lib \
        ldd /ffmpeg-install/bin/ffmpeg /ffmpeg-install/bin/ffprobe > /tmp/ffmpeg-ldd.txt \
    && if grep -q 'not found' /tmp/ffmpeg-ldd.txt; then \
        cat /tmp/ffmpeg-ldd.txt >&2; \
        exit 1; \
    fi \
    && awk '/=> \// { print $3 } /^\// && $1 !~ /:$/ { print $1 }' /tmp/ffmpeg-ldd.txt \
        | sort -u \
        | while IFS= read -r library; do \
            case "$(basename "${library}")" in \
                ld-linux-*|libc.so.*|libdl.so.*|libgcc_s.so.*|libm.so.*|libpthread.so.*|librt.so.*|libstdc++.so.*) \
                    continue \
                    ;; \
            esac; \
            cp -L "${library}" /ffmpeg-install/runtime-libs/ || exit 1; \
            printf '%s\n' "${library}" >> /tmp/ffmpeg-origins.txt; \
        done \
    && test -n "$(find /ffmpeg-install/runtime-libs -maxdepth 1 -type f -print -quit)" \
    && rm /tmp/ffmpeg-ldd.txt

# Which Debian package each copied library comes from, with its copyright file
# (the `dpkg-copied` component of the licence record, ADR-1513).
COPY --chmod=0755 scripts/ci/record-copied-debian-libs.sh /usr/local/bin/record-copied-debian-libs
RUN record-copied-debian-libs /tmp/ffmpeg-origins.txt /ffmpeg-install/copied-packages /usr/local/lib

# ---------------------------------------------------------------------------
# Stage 4 — go-builder: compile the vmafx-node Go binary
# ---------------------------------------------------------------------------
FROM ${RELEASE_GO_BASE} AS go-builder

ARG CGO_ENABLED=1
ARG DEBIAN_FRONTEND=noninteractive

# clang (BPF target), llvm-strip and the libbpf headers compile the node's eBPF
# object (ADR-1622): that object is generated here and committed nowhere.
# gen-node-bpf.sh --require-pin below fails unless clang is BPF_CLANG_VERSION of
# build-config.env and the object's sha256 is BPF_OBJECT_SHA256.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        clang-19 \
        gcc \
        libbpf-dev \
        llvm-19 \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copy libvmaf headers + library for cgo build
COPY --from=vmaf-builder /dist/lib/ /usr/local/lib/
COPY core/include/libvmaf/ /usr/local/include/libvmaf/
ARG VMAFX_VERSION
RUN ldconfig

WORKDIR /src
COPY . .

RUN go mod download

# The eBPF object and its bpf2go binding (cmd/vmafx-node/bpf) are generated, not
# committed: the build would fail on a missing embed without them (ADR-1622).
RUN ./scripts/dev/gen-node-bpf.sh --require-pin

# Keep module download independently cacheable from source compilation.
# hadolint ignore=DL3059
RUN CGO_ENABLED=${CGO_ENABLED} \
    CGO_LDFLAGS="-L/usr/local/lib -lvmaf -lvmafx -lm" \
    go build \
        -trimpath \
        -ldflags "-s -w -X github.com/VMAFx/vmafx/pkg/version.version=${VMAFX_VERSION}" \
        -o /out/vmafx-node \
        ./cmd/vmafx-node

# The licences of the Go programs (ADR-1513): our own Go files merged into the
# C library's scan, and the licence and notice files of every module vmafx-node
# and rclone link, read from their build information.
COPY --from=rclone-bin /usr/local/bin/rclone /out/rclone
COPY --from=vmaf-builder /licence-inputs/vmafx-sources.json /tmp/vmaf-sources.json
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && apt-get clean \
    && mkdir /licence-inputs \
    && python3 tools/rc1-tester/image/licensing.py scan-go --repo /src \
        --package ./cmd/vmafx-node --merge /tmp/vmaf-sources.json \
        --out /licence-inputs/vmafx-sources.json \
    && python3 tools/rc1-tester/image/licensing.py go-licences \
        --binary /out/vmafx-node --binary /out/rclone --out /licence-inputs/go

# ---------------------------------------------------------------------------
# Stage 5 — runtime-base: Debian 13 glibc runtime foundation
# ---------------------------------------------------------------------------
FROM ${RELEASE_RUNTIME_CC} AS runtime-base

LABEL org.opencontainers.image.title="vmafx-node"
LABEL org.opencontainers.image.description="VMAFX worker node — FFmpeg + libvmaf + vmafx-node gRPC service. Licences: /usr/local/share/vmafx/licenses/THIRD_PARTY_NOTICES.txt"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"
LABEL org.opencontainers.image.licenses="EUPL-1.2 AND BSD-2-Clause-Patent AND BSD-3-Clause AND BSD-2-Clause AND ISC AND MIT AND Unlicense AND LicenseRef-LIVE-BRISQUE AND GPL-3.0-or-later AND GPL-2.0-only AND GPL-2.0-or-later AND LGPL-2.1-or-later"
LABEL org.opencontainers.image.vendor="Lusoris"

ENV LD_LIBRARY_PATH="/usr/local/lib"
ENV VMAFX_MODEL_DIR="/usr/local/share/vmafx/model"
# Canonical ffmpeg path consumed by the node binary and its encoder probe.
ENV VMAFX_FFMPEG_BIN="/usr/local/bin/ffmpeg"

# Copy libvmaf.so* and models
COPY --from=vmaf-builder /dist/lib/    /usr/local/lib/
COPY --from=vmaf-builder /dist/model/  /usr/local/share/vmafx/model/
COPY --from=vmaf-builder /dist/bin/vmaf /usr/local/bin/vmaf
# pkg/storage resolves s3://, gs://, rclone:// and remote:path inputs by
# running rclone (ADR-0719); the v1.0.0-rc.1 image shipped without it.
COPY --from=rclone-bin /usr/local/bin/rclone /usr/local/bin/rclone
# rclone's mount mode (storage.mode=mount): the setuid fusermount3, the
# util-linux mount and umount it runs, their libraries at their Debian paths,
# and the record of the packages they come from (ADR-1593).
COPY --from=fuse-tools /fuse-tools/root/ /
COPY --from=fuse-tools /fuse-tools/copied-packages/ /usr/local/share/vmafx/fuse-tools/

# ---------------------------------------------------------------------------
# Stage 6 — node-assembled: the CPU-only node worker's content
# ---------------------------------------------------------------------------
FROM runtime-base AS node-assembled

# ffmpeg binary + libav*.so*
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/bin/ffmpeg   /usr/local/bin/ffmpeg
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/bin/ffprobe  /usr/local/bin/ffprobe
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/lib/libav*.so*  /usr/local/lib/
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/lib/libsw*.so*  /usr/local/lib/

# Architecture-native codec/font/VA dependency closure collected by ldd, the
# record of the Debian packages it came from with their copyright files, and
# the licence files of FFmpeg and SVT-AV1 (ADR-1513).
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/runtime-libs/ /usr/local/lib/
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/copied-packages/ /usr/local/share/vmafx/copied-packages/
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/licenses/ /usr/local/share/vmafx/ffmpeg/
COPY --from=ffmpeg-deps-base /usr/local/share/vmafx/svt-av1/ /usr/local/share/vmafx/svt-av1/

COPY --from=go-builder /out/vmafx-node /usr/local/bin/vmafx-node

# ---------------------------------------------------------------------------
# node-notices: written on a copy of the distroless tree, which has no
# interpreter (ADR-1503 rule 4)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS node-notices
COPY --from=node-assembled / /rootfs
ARG VMAFX_SOURCE_COMMIT=unknown
ARG VMAFX_IMAGE_TAG=unknown
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=go-builder,source=/licence-inputs,target=/licence-inputs \
    mkdir /texts \
    && python3 /repo/tools/rc1-tester/image/licensing.py notices --artifact production-node-image \
        --root /rootfs --repo /repo --build-scan /licence-inputs/vmafx-sources.json --texts /texts \
        --go-licences /licence-inputs/go \
        --source-commit "${VMAFX_SOURCE_COMMIT}" --tag "${VMAFX_IMAGE_TAG}"

FROM node-assembled AS node-with-notices
COPY --from=node-notices /rootfs/usr/local/share/vmafx/licenses /usr/local/share/vmafx/licenses

# ---------------------------------------------------------------------------
# node-licence-check: every file of the image has a recorded licence
# (ADR-1503 rule 3); `node-cpu` copies its receipt, so it cannot be built
# without it
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS node-licence-check
RUN --mount=type=bind,from=node-with-notices,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=go-builder,source=/licence-inputs,target=/licence-inputs \
    mkdir /out \
    && python3 /repo/tools/rc1-tester/image/licensing.py check --artifact production-node-image \
        --root /rootfs --repo /repo --build-scan /licence-inputs/vmafx-sources.json \
        --python-version none --receipt /out/licence-check.json

# ---------------------------------------------------------------------------
# node-source-export: the corresponding source, published as <tag>-source
# (ADR-1503 rule 5): FFmpeg as compiled with its configure line and patch
# series, the Debian sources of the base's packages and of every copied
# library, and the module zips of rclone (it links an LGPL-3.0 module) and of
# vmafx-node's copyleft modules
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS node-source-fetch
# Only /sources leaves this stage, so its package lists need no cleanup.
# hadolint ignore=DL3009
RUN --mount=type=bind,from=node-with-notices,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && python3 /repo/tools/rc1-tester/image/licensing.py sources --artifact production-node-image \
        --root /rootfs --repo /repo --out /sources.list \
    && python3 /repo/tools/rc1-tester/image/licensing.py fetch-sources --list /sources.list \
        --out /sources
COPY --from=ffmpeg-builder-cpu /ffmpeg-source/ /sources/ffmpeg/

FROM scratch AS node-source-export
COPY --from=node-source-fetch /sources /sources

# ---------------------------------------------------------------------------
# Stage 6 (target: node-cpu) — CPU-only node worker
# ---------------------------------------------------------------------------
FROM node-with-notices AS node-cpu

COPY --from=node-licence-check /out/licence-check.json /usr/local/share/vmafx/licence-check.json

EXPOSE 50052

USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/vmafx-node"]

# ---------------------------------------------------------------------------
# Stage 7 (target: node-cuda) — CUDA 13 node worker
# Same software-only ffmpeg binary as node-cpu; CUDA accelerates VMAF scoring.
# ---------------------------------------------------------------------------
FROM runtime-base AS node-cuda

COPY --from=ffmpeg-builder-cpu /ffmpeg-install/bin/ffmpeg   /usr/local/bin/ffmpeg
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/bin/ffprobe  /usr/local/bin/ffprobe
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/lib/libav*.so*  /usr/local/lib/
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/lib/libsw*.so*  /usr/local/lib/
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/runtime-libs/ /usr/local/lib/

# CUDA runtime libs — provided by host via nvidia-container-toolkit
# The CUDA runtime is sourced from the digest-pinned CUDA_RUNTIME image
# (build-config.env), which is an Ubuntu 26.04 base, not 24.04.
# Mismatching major versions (12.x runtime vs 13.x build) causes symbol-resolution failures.
COPY --from=cuda-runtime-libs /usr/local/cuda/lib64/libcudart.so* /usr/local/lib/

COPY --from=go-builder /out/vmafx-node /usr/local/bin/vmafx-node

ENV VMAFX_BACKEND=cuda

EXPOSE 50052

USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/vmafx-node"]

# ---------------------------------------------------------------------------
# Stage 8 (target: node-rocm) — ROCm 10 node worker
# ---------------------------------------------------------------------------
FROM runtime-base AS node-rocm

COPY --from=ffmpeg-builder-cpu /ffmpeg-install/bin/ffmpeg   /usr/local/bin/ffmpeg
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/bin/ffprobe  /usr/local/bin/ffprobe
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/lib/libav*.so*  /usr/local/lib/
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/lib/libsw*.so*  /usr/local/lib/
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/runtime-libs/ /usr/local/lib/

# ROCm 10.0.0 HIP runtime libs (ADR-1225).
#
# Two things changed versus the flat `libamdhip64.so* + libhsa-runtime64.so*`
# copy this stage used under ROCm 7:
#
#  1. **The closure is wider.** ROCm 10's `libamdhip64.so` links
#     `librocprofiler-register`, `librocm_kpack`, `libamd_comgr` and the
#     bundled `libLLVM` / `libclang-cpp`, plus a `rocm_sysdeps` bundle of
#     vendored zlib/zstd/elf/drm/numa. Copying only the two old libraries
#     produces an image whose every HIP binary dies at load with "cannot
#     open shared object file". The full transitive closure is 19 libraries
#     totalling 234 MB — small enough to ship whole.
#  2. **Layout matters.** Those libraries resolve each other through
#     `$ORIGIN`-relative RPATHs (`$ORIGIN`, `$ORIGIN/llvm/lib`,
#     `$ORIGIN/rocm_sysdeps/lib`), so they must keep their directory
#     structure rather than being flattened into /usr/local/lib.
#
# Source paths use the real `/opt/rocm/core-10.0/` prefix rather than
# `/opt/rocm/`: ROCm 10 makes `/opt/rocm/lib` a Debian-alternatives symlink,
# and BuildKit resolves a `COPY --from` source against the source image's
# filesystem without following that indirection reliably.
COPY --from=rocm-runtime-libs \
     /opt/rocm/core-10.0/lib/libamdhip64.so*            /opt/rocm/lib/
COPY --from=rocm-runtime-libs \
     /opt/rocm/core-10.0/lib/libhsa-runtime64.so*       /opt/rocm/lib/
COPY --from=rocm-runtime-libs \
     /opt/rocm/core-10.0/lib/libamd_comgr.so*           /opt/rocm/lib/
COPY --from=rocm-runtime-libs \
     /opt/rocm/core-10.0/lib/librocm_kpack.so*          /opt/rocm/lib/
COPY --from=rocm-runtime-libs \
     /opt/rocm/core-10.0/lib/librocprofiler-register.so* /opt/rocm/lib/
COPY --from=rocm-runtime-libs \
     /opt/rocm/core-10.0/lib/rocm_sysdeps/lib/          /opt/rocm/lib/rocm_sysdeps/lib/
COPY --from=rocm-runtime-libs \
     /opt/rocm/core-10.0/lib/llvm/lib/libLLVM.so.*      /opt/rocm/lib/llvm/lib/
COPY --from=rocm-runtime-libs \
     /opt/rocm/core-10.0/lib/llvm/lib/libclang-cpp.so.* /opt/rocm/lib/llvm/lib/

ENV LD_LIBRARY_PATH="/usr/local/lib:/opt/rocm/lib"

COPY --from=go-builder /out/vmafx-node /usr/local/bin/vmafx-node

ENV VMAFX_BACKEND=hip

EXPOSE 50052

USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/vmafx-node"]

# ---------------------------------------------------------------------------
# Stage 9 (target: node-sycl) — Intel oneAPI 2026 node worker (SYCL scoring)
# ---------------------------------------------------------------------------
FROM runtime-base AS node-sycl

COPY --from=ffmpeg-builder-cpu /ffmpeg-install/bin/ffmpeg   /usr/local/bin/ffmpeg
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/bin/ffprobe  /usr/local/bin/ffprobe
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/lib/libav*.so*  /usr/local/lib/
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/lib/libsw*.so*  /usr/local/lib/
COPY --from=ffmpeg-builder-cpu /ffmpeg-install/runtime-libs/ /usr/local/lib/

# Intel oneAPI SYCL + Level Zero runtime
COPY --from=oneapi-runtime-libs /opt/intel/oneapi/redist/lib/libsycl.so*   /usr/local/lib/
COPY --from=oneapi-runtime-libs /opt/intel/oneapi/redist/lib/libOpenCL.so* /usr/local/lib/

COPY --from=go-builder /out/vmafx-node /usr/local/bin/vmafx-node

ENV VMAFX_BACKEND=sycl

EXPOSE 50052

USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/vmafx-node"]
