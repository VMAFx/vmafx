# SPDX-License-Identifier: EUPL-1.2
# Copyright 2026 Lusoris
#
# docker/Dockerfile.operator — multi-stage build for the vmafx-operator Go binary.
#
# Stages:
#   go-builder : compiles cmd/vmafx-operator using ${RELEASE_GO_BASE}, and
#                collects the licence texts of every module it links
#   operator   : ${RELEASE_RUNTIME_STATIC} runtime (no libc needed;
#                pure-Go binary, no cgo), with its notices; it copies the
#                receipt of `licence-check` (ADR-1513)
#   source-export : the corresponding source of the copyleft parts (Debian
#                packages of the base, MPL-2.0 and EUPL-1.2 Go modules),
#                published as <tag>-source
#
# The operator has no libvmaf dependency — it drives Kubernetes CRD reconciliation
# (VmafxJob / VmafxNode / VmafxModelTraining) and never calls the VMAF scoring
# library directly.  A pure-Go / CGO_ENABLED=0 build is therefore safe and produces
# a smaller, more portable image.
#
# Multi-arch: amd64 + arm64 via BuildKit cross-compilation (no QEMU emulation
# needed for pure-Go binaries — GOARCH is set at build time and the result is
# a native static binary).
#
# Build:
#   docker build -f docker/Dockerfile.operator \
#     -t ghcr.io/vmafx/vmafx-operator:dev \
#     --platform linux/amd64,linux/arm64 .
#
# Run:
#   docker run --rm \
#     -e VMAFX_OPERATOR_METRICS_ADDR=:8080 \
#     -e VMAFX_OPERATOR_HEALTH_PROBE_ADDR=:8081 \
#     -e VMAFX_OPERATOR_LEADER_ELECTION=false \
#     ghcr.io/vmafx/vmafx-operator:dev
#
# Environment variables (all optional; `--version` is the only CLI switch):
#   VMAFX_OPERATOR_METRICS_ADDR   Prometheus metrics bind address (default ":8080")
#   VMAFX_OPERATOR_HEALTH_PROBE_ADDR  Health probe bind address (default ":8081")
#   VMAFX_OPERATOR_LEADER_ELECTION Enable leader election ("true"/"false", default "false")
#   VMAFX_LOG_LEVEL               slog level string (default "info")
#
# ADR-0786 (operator reconciler scope), ADR-0714 (operator skeleton),
# ADR-0698 (distroless policy), ADR-0815 (this Dockerfile).
# ADR-1129 (release container runtime alignment).
# See docs/backends/operator.md for operator runbook.

ARG VMAFX_VERSION=dev

# ---------------------------------------------------------------------------
# Stage 1 — go-builder: compile the vmafx-operator binary (CGO_ENABLED=0)
# ---------------------------------------------------------------------------
# Base images come from build-config.env -- the single source of truth for
# every container base in this repository. These defaults are mirrors kept in
# sync by scripts/ci/check-base-image-single-source.sh; edit the config, not
# these lines, then run that script with --write.
ARG RELEASE_GO_BASE="golang:1.27-trixie@sha256:2f84bc93ecfb2689f782b153fdcd368b5a7ab96c1386c65cdaccf35e726d6a44"
ARG RELEASE_RUNTIME_STATIC="gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3"
ARG RELEASE_PYTHON_BASE="python:3.14-slim@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170"

FROM ${RELEASE_GO_BASE} AS go-builder

# CGO_ENABLED=0: the operator is pure-Go (controller-runtime + k8s client-go).
# No libvmaf linkage is required.
ARG CGO_ENABLED=0
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VMAFX_VERSION

WORKDIR /src
COPY go.mod go.sum ./

# Download dependencies before copying source for better layer caching.
RUN go mod download

COPY . .

RUN CGO_ENABLED=${CGO_ENABLED} \
    GOOS=${TARGETOS} \
    GOARCH=${TARGETARCH} \
    go build \
        -trimpath \
        -ldflags "-s -w -X github.com/VMAFx/vmafx/pkg/version.version=${VMAFX_VERSION}" \
        -o /out/vmafx-operator \
        ./cmd/vmafx-operator

# The licences of the program (ADR-1513): those of our own Go files from their
# SPDX headers (`go list -deps`), and the licence and notice files of every
# module the binary links, read from its build information.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && apt-get clean \
    && mkdir /licence-inputs \
    && python3 tools/rc1-tester/image/licensing.py scan-go --repo /src \
        --package ./cmd/vmafx-operator --out /licence-inputs/vmafx-sources.json \
    && python3 tools/rc1-tester/image/licensing.py go-licences \
        --binary /out/vmafx-operator --out /licence-inputs/go

# ---------------------------------------------------------------------------
# Stage 2 — operator-assembled: distroless static runtime (no libc, no shell)
# ---------------------------------------------------------------------------
# gcr.io/distroless/static-debian13 is appropriate for CGO_ENABLED=0 binaries.
# It contains only the CA bundle and timezone data — no libc, no shell.
# This is 2 MB smaller than distroless/cc and has a smaller attack surface.
FROM ${RELEASE_RUNTIME_STATIC} AS operator-assembled

LABEL org.opencontainers.image.title="vmafx-operator"
LABEL org.opencontainers.image.description="VMAFX Kubernetes operator — CRD reconciliation for VmafxJob / VmafxNode / VmafxModelTraining. Licences: /usr/local/share/vmafx/licenses/THIRD_PARTY_NOTICES.txt"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"
LABEL org.opencontainers.image.licenses="EUPL-1.2"
LABEL org.opencontainers.image.vendor="Lusoris"

COPY --from=go-builder /out/vmafx-operator /usr/local/bin/vmafx-operator

# ---------------------------------------------------------------------------
# notices: written on a copy of the distroless tree, which has no interpreter
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS notices
COPY --from=operator-assembled / /rootfs
ARG VMAFX_SOURCE_COMMIT=unknown
ARG VMAFX_IMAGE_TAG=unknown
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,from=go-builder,source=/licence-inputs,target=/licence-inputs \
    mkdir /texts \
    && python3 /repo/tools/rc1-tester/image/licensing.py notices --artifact production-operator-image \
        --root /rootfs --repo /repo --build-scan /licence-inputs/vmafx-sources.json --texts /texts \
        --go-licences /licence-inputs/go \
        --source-commit "${VMAFX_SOURCE_COMMIT}" --tag "${VMAFX_IMAGE_TAG}"

FROM operator-assembled AS operator-with-notices
COPY --from=notices /rootfs/usr/local/share/vmafx/licenses /usr/local/share/vmafx/licenses

# ---------------------------------------------------------------------------
# licence-check: every file of the image has a recorded licence (ADR-1503
# rule 3); `operator` copies its receipt, so it cannot be built without it
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS licence-check
RUN --mount=type=bind,from=operator-with-notices,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,from=go-builder,source=/licence-inputs,target=/licence-inputs \
    mkdir /out \
    && python3 /repo/tools/rc1-tester/image/licensing.py check --artifact production-operator-image \
        --root /rootfs --repo /repo --build-scan /licence-inputs/vmafx-sources.json \
        --python-version none --receipt /out/licence-check.json

# ---------------------------------------------------------------------------
# source-export: Debian sources of the base's packages and the module zips of
# the copyleft Go modules, published as <tag>-source (ADR-1503 rule 5)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS source-fetch
# Only /sources leaves this stage, so its package lists need no cleanup.
# hadolint ignore=DL3009
RUN --mount=type=bind,from=operator-with-notices,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && python3 /repo/tools/rc1-tester/image/licensing.py sources --artifact production-operator-image \
        --root /rootfs --repo /repo --out /sources.list \
    && python3 /repo/tools/rc1-tester/image/licensing.py fetch-sources --list /sources.list \
        --out /sources

FROM scratch AS source-export
COPY --from=source-fetch /sources /sources

# ---------------------------------------------------------------------------
# operator: the published image
# ---------------------------------------------------------------------------
FROM operator-with-notices AS operator

COPY --from=licence-check /out/licence-check.json /usr/local/share/vmafx/licence-check.json

# Expose the golusoris operator defaults: Prometheus metrics and health probes.
EXPOSE 8080 8081

# Run as non-root (distroless provides uid 65532 = nonroot).
USER 65532:65532

ENTRYPOINT ["/usr/local/bin/vmafx-operator"]
