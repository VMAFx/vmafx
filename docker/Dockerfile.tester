# SPDX-License-Identifier: EUPL-1.2
# Copyright 2026 Lusoris
#
# docker/Dockerfile.tester -- the VMAFx tester image (ADR-1492)
#
# One CPU-only build of the fork, its SIMD unit tests, the Netflix golden pairs
# and one command that prints a JSON report:
#   docker run --rm --network none --read-only --cap-drop ALL \
#     --security-opt no-new-privileges --tmpfs /tmp <image> > report.json
# Target `final-sycl` is the Intel GPU variant (linux/amd64): the SYCL build with
# the default AOT list plus SPIR-V, its device tests and the parity gate, on the
# oneAPI SYCL runtime and the pinned Intel compute runtime; it runs with the GPU's
# device nodes (docs/usage/tester-image.md, "Intel GPU").
# The report script is tools/rc1-tester/src/vmaf_rc1_tester/hw_report.py. The
# final stage holds no compiler and no package-manager state; it runs as a
# numeric non-root user and needs no network.
#
# Licensing (ADR-1503): /opt/vmafx/licenses/ carries THIRD_PARTY_NOTICES.txt and
# every licence text; the final stage depends on the licence-check stage, which
# fails the build when a file has no recorded licence
# (tools/rc1-tester/image/licensing.json). `--target source-export` builds the
# corresponding source of the copyleft parts, published as <tag>-source.
#
# Built only by .github/workflows/docker-publish-tester.yml.
# See docs/usage/tester-image.md and docs/development/tester-image.md.

# Base images come from build-config.env (single source, ADR-1129).
ARG RELEASE_BUILDER_BASE="debian:13-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a"
ARG RELEASE_PYTHON_BASE="python:3.14-slim@sha256:c3e521df8b2b498a7a682e7e18676771cb80c6b75b8699af886b2d554ce40151"
ARG ONEAPI_BUILDER="debian:13-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a"
ARG ONEAPI_RUNTIME="debian:13-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a"
ARG ROCM_BUILDER="rocm/dev-ubuntu-26.04:10.1.0-full@sha256:4f5ed1bf6532a4b9920400401b0ad0f706af356dae61e40afefbfd6c8073f0ce"

# ---------------------------------------------------------------------------
# fixtures: Netflix test videos, fetched at a pinned commit and SHA-256 checked
# ---------------------------------------------------------------------------
FROM ${RELEASE_BUILDER_BASE} AS fixtures
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG VMAF_RESOURCE_COMMIT=c0ab6adbd7e41bb354f14686ed08500530622bc3
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY tools/rc1-tester/image/fixtures.sha256 /fixtures.sha256
WORKDIR /out
RUN awk '{print $2}' /fixtures.sha256 | xargs -P4 -I{} curl -fsSL --retry 3 --create-dirs \
        -o {} "https://raw.githubusercontent.com/Netflix/vmaf_resource/${VMAF_RESOURCE_COMMIT}/python/test/resource/{}" \
    && sha256sum --check --strict /fixtures.sha256 \
    && chmod -R a+rX /out

# ---------------------------------------------------------------------------
# python-venv: the hash-locked Python test stack of the golden gate
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS python-venv
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc g++ libc6-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /
COPY python/requirements-test-lock.txt python/requirements-test-lock.txt
RUN python -m venv /venv \
    && /venv/bin/pip install --no-cache-dir --require-hashes -r python/requirements-test-lock.txt \
    && /venv/bin/pip uninstall --yes pip h5py pywavelets coverage pytest-cov cython \
    && find /venv -type d -name tests -prune -exec rm -r {} + \
    && find /venv -type d -name sample_data -prune -exec rm -r {} + \
    && find /venv -name '*.so*' -type f -not -path '*.libs/*' -exec strip --strip-unneeded {} + \
    && mkdir -p /extra-libs/lib /extra-libs/doc/libgomp1 \
    && cp -a /usr/lib/*-linux-gnu/libgomp.so.1* /extra-libs/lib/ \
    && cp /usr/share/doc/libgomp1/copyright /extra-libs/doc/libgomp1/copyright \
    && dpkg-query -W -f='${source:Package}=${source:Version}\n' libgomp1 \
        > /extra-libs/doc/libgomp1/SOURCE
# The libraries auditwheel grafted into the wheels (`*.libs/`) are vendor
# binaries and stay unmodified (ADR-1503): the licence check compares them with
# their wheel RECORD, and an LGPL library keeps its corresponding source.

# ---------------------------------------------------------------------------
# vmaf-build: golden build profile (scripts/ci/setup-golden-build.sh) with the
# listed unit tests; GCC, no LTO (GCC 14.2 ICEs on the LTO test links)
# ---------------------------------------------------------------------------
FROM ${RELEASE_BUILDER_BASE} AS vmaf-build
ARG VMAF_BUILD_JOBS=4
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc g++ meson ninja-build nasm pkg-config xxd python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
# Only what the configure step reads: the source, the models and one script a test registers.
COPY core core
COPY model model
COPY REUSE.toml REUSE.toml
COPY scripts/ci/check-msvc-clz-shim.sh scripts/ci/check-msvc-clz-shim.sh
COPY tools/rc1-tester/image tools/rc1-tester/image
COPY tools/rc1-tester/src tools/rc1-tester/src
# hadolint ignore=SC2046
RUN meson setup /build core --buildtype=release --strip -Db_lto=false \
        -Denable_float=true -Denable_cuda=false -Denable_sycl=false -Denable_hip=false \
        -Denable_dnn=disabled -Denable_docs=false -Denable_tests=true \
    && ninja -C /build -j"${VMAF_BUILD_JOBS}" tools/vmaf \
        $(python3 tools/rc1-tester/image/prepare_build.py select /build \
            tools/rc1-tester/image/unit-tests.txt) \
    && mkdir /licence-inputs \
    && python3 tools/rc1-tester/image/licensing.py scan-build --build /build --repo /src \
        --out /licence-inputs/vmafx-sources.json
RUN mkdir -p /opt/vmafx/build/tools /opt/vmafx/build/src \
    && cp /build/tools/vmaf /opt/vmafx/build/tools/ \
    && cp -a /build/src/libvmaf.so* /opt/vmafx/build/src/ \
    && python3 tools/rc1-tester/image/prepare_build.py stage /build \
        tools/rc1-tester/image/unit-tests.txt /opt/vmafx \
    && mkdir -p /opt/vmafx/model \
    && cp -r model/. /opt/vmafx/model/ \
    && rm -r /opt/vmafx/model/tiny \
    && find /opt/vmafx/model -maxdepth 1 -name '*.onnx*' -delete
ARG VMAFX_SOURCE_COMMIT=unknown
ARG VMAFX_SOURCE_REF=unknown
ARG VMAFX_RECIPE_COMMIT=unknown
ARG VMAFX_BUILT_BY_WORKFLOW=false
ARG VMAFX_IMAGE_TAG=unknown
ARG RELEASE_BUILDER_BASE
ENV VMAFX_SOURCE_COMMIT=${VMAFX_SOURCE_COMMIT} VMAFX_SOURCE_REF=${VMAFX_SOURCE_REF} \
    VMAFX_RECIPE_COMMIT=${VMAFX_RECIPE_COMMIT} \
    VMAFX_BUILT_BY_WORKFLOW=${VMAFX_BUILT_BY_WORKFLOW} VMAFX_IMAGE_TAG=${VMAFX_IMAGE_TAG} \
    VMAFX_BASE_IMAGE=${RELEASE_BUILDER_BASE}
RUN python3 tools/rc1-tester/image/prepare_build.py info /opt/vmafx

# ---------------------------------------------------------------------------
# licence-texts: recorded licence texts that are not in the repository
# (CPython's Doc/license.rst of the runtime's version, SHA-256 checked)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS licence-texts
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/licensing \
    python3 /licensing/licensing.py fetch-texts --artifact image \
        --python-version "$(python3 -c 'import platform; print(platform.python_version())')" \
        --out /texts

# ---------------------------------------------------------------------------
# runtime: everything the report reads, without references
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS runtime
ENV LD_LIBRARY_PATH=/opt/vmafx/build/src:/opt/vmafx/lib \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp
COPY --from=vmaf-build /opt/vmafx /opt/vmafx
COPY --from=python-venv /venv /opt/venv
COPY --from=python-venv /extra-libs/lib /opt/vmafx/lib
COPY --from=python-venv /extra-libs/doc/libgomp1 /usr/share/doc/libgomp1
COPY --from=fixtures /out /opt/vmafx/python/test/resource
COPY python /opt/vmafx/python
COPY compat /opt/vmafx/compat
COPY tools/rc1-tester/src /opt/vmafx/tester/src
COPY tools/rc1-tester/vmaf-tester-report /opt/vmafx/tester/vmaf-tester-report
COPY tools/rc1-tester/image/fixtures.json /opt/vmafx/image/fixtures.json
# The notices and licence texts (ADR-1503). The repository inputs are bind
# mounts, so nothing but /opt/vmafx/licenses stays in the image.
ARG VMAFX_SOURCE_COMMIT=unknown
ARG VMAFX_IMAGE_TAG=unknown
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=vmaf-build,source=/licence-inputs,target=/licence-inputs \
    --mount=type=bind,from=licence-texts,source=/texts,target=/texts \
    python3 /repo/tools/rc1-tester/image/licensing.py notices --artifact image --root / \
        --repo /repo --build-scan /licence-inputs/vmafx-sources.json --texts /texts \
        --source-commit "${VMAFX_SOURCE_COMMIT}" --tag "${VMAFX_IMAGE_TAG}"

# ---------------------------------------------------------------------------
# refs-gen: scores of this image's own binary, produced at build time
# ---------------------------------------------------------------------------
FROM runtime AS refs-gen
RUN /opt/venv/bin/python /opt/vmafx/tester/vmaf-tester-report generate-reference /opt/vmafx/reference

# `docker buildx build --target refs-export --output type=local,dest=DIR` on amd64
# exports the x86_64 scalar scores; the arm64 build takes them as the build
# context named xref (informational cross-architecture comparison).
FROM scratch AS refs-export
COPY --from=refs-gen /opt/vmafx/reference/x86_64-scalar.json /

FROM scratch AS xref

# ===========================================================================
# Intel GPU variant: ghcr.io/vmafx/vmafx:<describe>-tester-sycl (linux/amd64).
#   docker build -f docker/Dockerfile.tester --target final-sycl .
# The stages above are shared; `final` at the end stays the default target.
# ===========================================================================

# ---------------------------------------------------------------------------
# sycl-build: the oneAPI release builder of docker/Dockerfile.production-gpu
# (ADR-1368): icpx from Intel's apt repository, ocloc and the Level Zero loader
# from the pinned compute-runtime release, all at build-config.env's versions.
# The compilers stay in this stage. The source sits at /opt/vmafx/src because
# test_sycl_kernel_scratch reads its ratchet list from a path the build bakes in.
# ---------------------------------------------------------------------------
FROM ${ONEAPI_BUILDER} AS sycl-build
ARG DEBIAN_FRONTEND=noninteractive
ARG VMAF_BUILD_JOBS=4
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl gcc g++ gpg meson nasm ninja-build pkg-config python3 xxd zstd \
    && rm -rf /var/lib/apt/lists/*
COPY build-config.env /tmp/vmafx/build-config.env
COPY scripts/ci/install-intel-oneapi.sh scripts/ci/install-intel-ocloc.sh /tmp/vmafx/scripts/ci/
COPY dev/scripts/fetch-intel-neo.py /tmp/vmafx/dev/scripts/fetch-intel-neo.py
# hadolint ignore=DL3008
RUN --mount=type=secret,id=github_token,env=GITHUB_TOKEN,required=false \
    bash /tmp/vmafx/scripts/ci/install-intel-oneapi.sh --mode=builder /tmp/vmafx \
    && bash /tmp/vmafx/scripts/ci/install-intel-ocloc.sh --components build /tmp/vmafx \
    && rm -rf /tmp/vmafx /var/lib/apt/lists/*
ENV ONEAPI_ROOT=/opt/intel/oneapi
ENV PATH="${ONEAPI_ROOT}/compiler/latest/bin:${PATH}"
WORKDIR /opt/vmafx/src
COPY core core
COPY model model
COPY REUSE.toml REUSE.toml
COPY scripts/__init__.py scripts/__init__.py
COPY scripts/lib scripts/lib
COPY scripts/ci/check-msvc-clz-shim.sh scripts/ci/cross_backend_parity_gate.py \
     scripts/ci/cross_backend_calibration.py scripts/ci/
COPY scripts/ci/exact_twins.d scripts/ci/exact_twins.d
COPY docs/adr docs/adr
COPY tools/rc1-tester/image tools/rc1-tester/image
COPY tools/rc1-tester/src tools/rc1-tester/src
# The default sycl_icpx_aot_targets list (19 Intel targets) plus portable SPIR-V.
# hadolint ignore=SC2046
RUN CC=icx CXX=icpx meson setup build core --buildtype=release --strip -Db_lto=false \
        -Denable_float=true -Denable_cuda=false -Denable_sycl=true -Denable_hip=false \
        -Denable_dnn=disabled -Denable_docs=false -Denable_tests=true \
    && nice -n 10 ninja -C build -j"${VMAF_BUILD_JOBS}" tools/vmaf \
        $(python3 tools/rc1-tester/image/prepare_build.py select build \
            tools/rc1-tester/image/unit-tests.txt) \
        $(python3 tools/rc1-tester/image/prepare_build.py select build \
            tools/rc1-tester/image/sycl-tests.txt) \
    && mkdir /licence-inputs \
    && python3 tools/rc1-tester/image/licensing.py scan-build --build build \
        --repo /opt/vmafx/src --out /licence-inputs/vmafx-sources.json
RUN mkdir -p /opt/vmafx/build/tools /opt/vmafx/build/src /opt/vmafx/model \
    && cp build/tools/vmaf /opt/vmafx/build/tools/ \
    && find build/src -maxdepth 1 -name 'libvmaf.so*' -not -type d \
        -exec cp -a {} /opt/vmafx/build/src/ \; \
    && python3 tools/rc1-tester/image/prepare_build.py stage build \
        tools/rc1-tester/image/unit-tests.txt /opt/vmafx \
    && python3 tools/rc1-tester/image/prepare_build.py stage build \
        tools/rc1-tester/image/sycl-tests.txt /opt/vmafx gpu-tests.json \
    && python3 tools/rc1-tester/image/prepare_build.py gate /opt/vmafx/src /opt/vmafx \
    && python3 tools/rc1-tester/image/prepare_build.py twins /opt/vmafx sycl \
    && python3 tools/rc1-tester/image/prepare_build.py intel-runtime \
        tools/rc1-tester/image/sycl-runtime.json /opt/intel/oneapi /opt/vmafx \
    && grep -aq /opt/vmafx/src/core/test/../src/sycl/scratch_ratchet.txt \
        /opt/vmafx/tests/test_sycl_kernel_scratch \
    && cp -r model/. /opt/vmafx/model/ \
    && rm -r /opt/vmafx/model/tiny \
    && find /opt/vmafx/model -maxdepth 1 -name '*.onnx*' -delete
ARG VMAFX_SOURCE_COMMIT=unknown
ARG VMAFX_SOURCE_REF=unknown
ARG VMAFX_RECIPE_COMMIT=unknown
ARG VMAFX_BUILT_BY_WORKFLOW=false
ARG VMAFX_IMAGE_TAG=unknown
ARG ONEAPI_BUILDER
ENV VMAFX_SOURCE_COMMIT=${VMAFX_SOURCE_COMMIT} VMAFX_SOURCE_REF=${VMAFX_SOURCE_REF} \
    VMAFX_RECIPE_COMMIT=${VMAFX_RECIPE_COMMIT} \
    VMAFX_BUILT_BY_WORKFLOW=${VMAFX_BUILT_BY_WORKFLOW} VMAFX_IMAGE_TAG=${VMAFX_IMAGE_TAG} \
    VMAFX_BASE_IMAGE=${ONEAPI_BUILDER} VMAFX_CC=icx VMAFX_GPU_BACKEND=sycl \
    VMAFX_NOT_APPLICABLE='{"golden": "the SYCL image carries no Python test stack; the CPU tester image runs the Netflix golden gate"}'
RUN python3 tools/rc1-tester/image/prepare_build.py info /opt/vmafx

# ---------------------------------------------------------------------------
# sycl-licence-texts: recorded licence texts that are not in the repository
# (the Level Zero loader's and IGC's, which their packages do not install),
# pinned by URL and SHA-256 in licensing.json (fetched_texts)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS sycl-licence-texts
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/licensing \
    python3 /licensing/licensing.py fetch-texts --artifact sycl-image --python-version none \
        --out /texts

# ---------------------------------------------------------------------------
# sycl-runtime: Debian 13, the Intel SYCL runtime files of sycl-runtime.json
# (copied unmodified in sycl-build, credist.txt checked) and the Intel GPU
# user-mode stack of the pinned compute-runtime release: the Level Zero GPU
# driver, IGC, gmmlib and the Level Zero loader, which drive Xe-LP, Xe-HPG,
# Xe-HPC and Xe2. The installer's offline compiler and OpenCL parts are purged
# again: SPIR-V reaches the GPU through Level Zero and IGC alone (measured on
# an Arc A380), and the image ships what the report needs (ADR-1503).
# ---------------------------------------------------------------------------
FROM ${ONEAPI_RUNTIME} AS sycl-runtime
ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
COPY build-config.env /tmp/vmafx/build-config.env
COPY scripts/ci/install-intel-ocloc.sh /tmp/vmafx/scripts/ci/install-intel-ocloc.sh
COPY dev/scripts/fetch-intel-neo.py /tmp/vmafx/dev/scripts/fetch-intel-neo.py
# The installer runs in /tmp/vmafx (its `ocloc query` writes a file into the
# working directory); the byte code Debian's Python compiles at install time is
# a cache the report never writes again (PYTHONDONTWRITEBYTECODE).
# hadolint ignore=DL3003,DL3008
RUN --mount=type=secret,id=github_token,env=GITHUB_TOKEN,required=false \
    apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates python3 \
    && cd /tmp/vmafx \
    && bash scripts/ci/install-intel-ocloc.sh --components runtime /tmp/vmafx \
    && dpkg --purge intel-ocloc intel-opencl-icd intel-igc-opencl-2 ocl-icd-libopencl1 \
    && apt-get purge -y --auto-remove ca-certificates \
    && apt-get clean \
    && find /usr/lib/python3* /usr/share/python3 -name __pycache__ -prune -exec rm -r {} + \
    && cd / \
    && rm -rf /tmp/vmafx /var/lib/apt/lists/*
# Under WSL2 the GPU arrives as /dev/dxg with the host driver's libraries in
# /usr/lib/wsl/lib (a bind mount); the path is empty on a Linux host.
ENV LD_LIBRARY_PATH=/opt/vmafx/build/src:/opt/vmafx/lib/intel:/usr/lib/wsl/lib \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp
COPY --from=sycl-build /opt/vmafx/lib /opt/vmafx/lib
COPY --from=sycl-build /opt/vmafx/licenses /opt/vmafx/licenses
COPY --from=sycl-build /opt/vmafx/build /opt/vmafx/build
COPY --from=sycl-build /opt/vmafx/tests /opt/vmafx/tests
COPY --from=sycl-build /opt/vmafx/image /opt/vmafx/image
COPY --from=sycl-build /opt/vmafx/model /opt/vmafx/model
COPY --from=sycl-build /opt/vmafx/tester/gate /opt/vmafx/tester/gate
COPY --from=sycl-build /opt/vmafx/src/core/src/sycl/scratch_ratchet.txt \
     /opt/vmafx/src/core/src/sycl/scratch_ratchet.txt
COPY --from=fixtures /out /opt/vmafx/python/test/resource
COPY tools/rc1-tester/src /opt/vmafx/tester/src
COPY tools/rc1-tester/vmaf-tester-report /opt/vmafx/tester/vmaf-tester-report
COPY tools/rc1-tester/image/fixtures.json tools/rc1-tester/image/sycl-rows.json /opt/vmafx/image/
# The notices and licence texts (ADR-1503), as for the CPU image; the repository
# inputs are bind mounts, so nothing but /opt/vmafx/licenses stays in the image.
ARG VMAFX_SOURCE_COMMIT=unknown
ARG VMAFX_IMAGE_TAG=unknown
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=sycl-build,source=/licence-inputs,target=/licence-inputs \
    --mount=type=bind,from=sycl-licence-texts,source=/texts,target=/texts \
    python3 /repo/tools/rc1-tester/image/licensing.py notices --artifact sycl-image --root / \
        --repo /repo --build-scan /licence-inputs/vmafx-sources.json --texts /texts \
        --source-commit "${VMAFX_SOURCE_COMMIT}" --tag "${VMAFX_IMAGE_TAG}"
# The licence texts fetched above are those of the installed versions; the
# Unified Runtime adapters and every binary resolve their libraries in the
# image; the scratch audit's baked ratchet path resolves through core/test/..
RUN test -f "/opt/vmafx/licenses/texts/level-zero-$(dpkg-query -W -f='${Version}' libze1)-LICENSE.txt" \
    && test -f "/opt/vmafx/licenses/texts/igc-$(dpkg-query -W -f='${Version}' intel-igc-core-2)-LICENSE.md" \
    && mkdir -p /opt/vmafx/src/core/test \
    && for binary in /opt/vmafx/lib/intel/libur_adapter_*.so.0 /opt/vmafx/build/tools/vmaf /opt/vmafx/tests/*; do \
        if [ "$(head -c 4 "${binary}" | tail -c 3)" = ELF ] && ldd "${binary}" | grep 'not found'; then \
            echo "unresolved dependency in ${binary}" >&2; exit 1; \
        fi; \
    done \
    && /opt/vmafx/build/tools/vmaf --version

# ---------------------------------------------------------------------------
# sycl-refs-gen: CPU scores of this image's own binary, produced at build time
# ---------------------------------------------------------------------------
FROM sycl-runtime AS sycl-refs-gen
RUN python3 /opt/vmafx/tester/vmaf-tester-report generate-reference /opt/vmafx/reference

# ---------------------------------------------------------------------------
# sycl-assembled: the image's content before the licence check
# ---------------------------------------------------------------------------
FROM sycl-runtime AS sycl-assembled
COPY --from=sycl-refs-gen /opt/vmafx/reference /opt/vmafx/reference

# ---------------------------------------------------------------------------
# sycl-licence-check: every file of the assembled image has a recorded licence
# (ADR-1503 rule 3); final-sycl copies its receipt, so it cannot be built
# without passing this
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS sycl-licence-check
RUN --mount=type=bind,from=sycl-assembled,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=sycl-build,source=/licence-inputs,target=/licence-inputs \
    mkdir /out \
    && python3 /repo/tools/rc1-tester/image/licensing.py check --artifact sycl-image \
        --root /rootfs --repo /repo --build-scan /licence-inputs/vmafx-sources.json \
        --python-version none --receipt /out/licence-check.json

# ---------------------------------------------------------------------------
# sycl-source-export: the corresponding source of the Intel GPU image's
# copyleft parts, published as ghcr.io/vmafx/vmafx:<tag>-sycl-source
# (ADR-1503 rule 5)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS sycl-source-fetch
# Only /sources leaves this stage, so its package lists need no cleanup.
# hadolint ignore=DL3009
RUN --mount=type=bind,from=sycl-assembled,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && python3 /repo/tools/rc1-tester/image/licensing.py sources --artifact sycl-image \
        --root /rootfs --repo /repo --out /sources.list \
    && python3 /repo/tools/rc1-tester/image/licensing.py fetch-sources --list /sources.list \
        --out /sources

FROM scratch AS sycl-source-export
COPY --from=sycl-source-fetch /sources /sources

# ---------------------------------------------------------------------------
# final-sycl
# ---------------------------------------------------------------------------
FROM sycl-assembled AS final-sycl
ARG VMAFX_SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.title="vmafx-tester-sycl" \
      org.opencontainers.image.description="VMAFx Intel GPU tester image: SYCL build, SYCL device tests, parity gate, one JSON report. Licences: /opt/vmafx/licenses/THIRD_PARTY_NOTICES.txt" \
      org.opencontainers.image.source="https://github.com/VMAFx/vmafx" \
      org.opencontainers.image.vendor="Lusoris" \
      org.opencontainers.image.revision="${VMAFX_SOURCE_COMMIT}"
COPY --from=sycl-licence-check /out/licence-check.json /opt/vmafx/licence-check.json
USER 10001:10001
ENTRYPOINT ["/usr/bin/python3", "/opt/vmafx/tester/vmaf-tester-report"]

# ===========================================================================
# NVIDIA GPU variant: ghcr.io/vmafx/vmafx:<describe>-tester-cuda (linux/amd64).
#   docker build -f docker/Dockerfile.tester --target final-cuda .
# The image ships no NVIDIA file: libvmaf loads the host driver's libcuda.so.1
# at run time (nv-codec-headers' loader), which the NVIDIA Container Toolkit
# mounts with --gpus all; the kernels are fatbins inside libvmaf.
# ===========================================================================

# ---------------------------------------------------------------------------
# cuda-build: Debian 13, nvcc and cudart from NVIDIA's debian13 repository at
# build-config.env's exact versions (scripts/ci/install-cuda-toolkit.sh), the
# nv-codec-headers commit core/src/meson.build requires. The default gencode
# list of core/src/meson.build: cubins for sm_80, sm_86, sm_89, sm_90, sm_100
# and sm_120, PTX for compute_80 and compute_120. The compilers stay here.
# ---------------------------------------------------------------------------
FROM ${RELEASE_BUILDER_BASE} AS cuda-build
ARG DEBIAN_FRONTEND=noninteractive
ARG VMAF_BUILD_JOBS=4
ARG NV_CODEC_HEADERS_COMMIT=876af32a202d0de83bd1d36fe74ee0f7fcf86b0d
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl gcc g++ git make meson nasm ninja-build pkg-config python3 xxd \
    && rm -rf /var/lib/apt/lists/*
COPY build-config.env scripts/ci/install-cuda-toolkit.sh /tmp/vmafx/
RUN bash /tmp/vmafx/install-cuda-toolkit.sh --mode=builder /tmp/vmafx \
    && rm -rf /tmp/vmafx /var/lib/apt/lists/*
ENV PATH="/usr/local/cuda/bin:${PATH}"
# The headers' own notices travel with the image: libvmaf compiles their loader in.
RUN git init -q /tmp/nv-codec-headers \
    && git -C /tmp/nv-codec-headers fetch -q --depth=1 \
        https://code.ffmpeg.org/FFmpeg/nv-codec-headers.git "${NV_CODEC_HEADERS_COMMIT}" \
    && git -C /tmp/nv-codec-headers checkout -q --detach FETCH_HEAD \
    && test "$(git -C /tmp/nv-codec-headers rev-parse HEAD)" = "${NV_CODEC_HEADERS_COMMIT}" \
    && make -C /tmp/nv-codec-headers install PREFIX=/usr/local \
    && mkdir -p /opt/vmafx/licenses/nv-codec-headers \
    && for header in dynlink_cuda.h dynlink_loader.h; do \
        { echo "include/ffnvcodec/${header} of nv-codec-headers ${NV_CODEC_HEADERS_COMMIT}:"; \
          sed -n '1,/\*\//p' "/tmp/nv-codec-headers/include/ffnvcodec/${header}"; echo; } \
          >> /opt/vmafx/licenses/nv-codec-headers/NOTICE.txt; \
    done \
    && grep -q 'Permission is hereby granted' /opt/vmafx/licenses/nv-codec-headers/NOTICE.txt \
    && rm -rf /tmp/nv-codec-headers
WORKDIR /opt/vmafx/src
COPY core core
COPY model model
COPY REUSE.toml REUSE.toml
COPY scripts/__init__.py scripts/__init__.py
COPY scripts/lib scripts/lib
COPY scripts/ci/check-msvc-clz-shim.sh scripts/ci/cross_backend_parity_gate.py \
     scripts/ci/cross_backend_calibration.py scripts/ci/
COPY scripts/ci/exact_twins.d scripts/ci/exact_twins.d
COPY docs/adr docs/adr
COPY tools/rc1-tester/image tools/rc1-tester/image
COPY tools/rc1-tester/src tools/rc1-tester/src
# hadolint ignore=SC2046
RUN meson setup build core --buildtype=release --strip -Db_lto=false \
        -Denable_float=true -Denable_cuda=true -Denable_nvcc=true -Dnvcc_threads=1 \
        -Denable_sycl=false -Denable_hip=false \
        -Denable_dnn=disabled -Denable_docs=false -Denable_tests=true \
    && nice -n 10 ninja -C build -j"${VMAF_BUILD_JOBS}" tools/vmaf \
        $(python3 tools/rc1-tester/image/prepare_build.py select build \
            tools/rc1-tester/image/unit-tests.txt) \
        $(python3 tools/rc1-tester/image/prepare_build.py select build \
            tools/rc1-tester/image/cuda-tests.txt) \
    && mkdir /licence-inputs \
    && python3 tools/rc1-tester/image/licensing.py scan-build --build build \
        --repo /opt/vmafx/src --out /licence-inputs/vmafx-sources.json
# The NVIDIA parts of the kernels are CUDA headers and the libdevice library
# nvcc links into the fatbins (CUDA EULA 1.1.1(c), Attachment A); the EULA
# text is the copyright file of the package that installs libdevice.10.bc.
RUN mkdir -p /opt/vmafx/build/tools /opt/vmafx/build/src /opt/vmafx/model \
        /opt/vmafx/licenses/nvidia \
    && cp build/tools/vmaf /opt/vmafx/build/tools/ \
    && find build/src -maxdepth 1 -name 'libvmaf.so*' -not -type d \
        -exec cp -a {} /opt/vmafx/build/src/ \; \
    && python3 tools/rc1-tester/image/prepare_build.py stage build \
        tools/rc1-tester/image/unit-tests.txt /opt/vmafx \
    && python3 tools/rc1-tester/image/prepare_build.py stage build \
        tools/rc1-tester/image/cuda-tests.txt /opt/vmafx gpu-tests.json \
    && python3 tools/rc1-tester/image/prepare_build.py gate /opt/vmafx/src /opt/vmafx \
    && python3 tools/rc1-tester/image/prepare_build.py twins /opt/vmafx cuda \
    && python3 tools/rc1-tester/image/prepare_build.py cuda-targets build /opt/vmafx \
    && for binary in /opt/vmafx/build/tools/vmaf /opt/vmafx/build/src/libvmaf.so.* /opt/vmafx/tests/*; do \
        if [ "$(head -c 4 "${binary}" | tail -c 3)" = ELF ] \
            && readelf -d "${binary}" | grep -E 'NEEDED.*lib(cuda|nv)'; then \
            echo "${binary} links an NVIDIA library" >&2; exit 1; \
        fi; \
    done \
    && libdevice_package="$(dpkg -S 'libdevice.10.bc' | head -n 1 | cut -d: -f1)" \
    && cp "/usr/share/doc/${libdevice_package}/copyright" /opt/vmafx/licenses/nvidia/CUDA-EULA.txt \
    && grep -q 'Last updated: January 26, 2026' /opt/vmafx/licenses/nvidia/CUDA-EULA.txt \
    && grep -q 'libdevice.10.bc' /opt/vmafx/licenses/nvidia/CUDA-EULA.txt \
    && cp -r model/. /opt/vmafx/model/ \
    && rm -r /opt/vmafx/model/tiny \
    && find /opt/vmafx/model -maxdepth 1 -name '*.onnx*' -delete
ARG VMAFX_SOURCE_COMMIT=unknown
ARG VMAFX_SOURCE_REF=unknown
ARG VMAFX_RECIPE_COMMIT=unknown
ARG VMAFX_BUILT_BY_WORKFLOW=false
ARG VMAFX_IMAGE_TAG=unknown
ARG RELEASE_BUILDER_BASE
ENV VMAFX_SOURCE_COMMIT=${VMAFX_SOURCE_COMMIT} VMAFX_SOURCE_REF=${VMAFX_SOURCE_REF} \
    VMAFX_RECIPE_COMMIT=${VMAFX_RECIPE_COMMIT} \
    VMAFX_BUILT_BY_WORKFLOW=${VMAFX_BUILT_BY_WORKFLOW} VMAFX_IMAGE_TAG=${VMAFX_IMAGE_TAG} \
    VMAFX_BASE_IMAGE=${RELEASE_BUILDER_BASE} VMAFX_GPU_BACKEND=cuda \
    VMAFX_NOT_APPLICABLE='{"golden": "the CUDA image carries no Python test stack; the CPU tester image runs the Netflix golden gate"}'
RUN python3 tools/rc1-tester/image/prepare_build.py info /opt/vmafx

# ---------------------------------------------------------------------------
# cuda-licence-texts: recorded licence texts that are not in the repository
# (none at present; the stage keeps the notices step the same for every image)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS cuda-licence-texts
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/licensing \
    python3 /licensing/licensing.py fetch-texts --artifact cuda-image --python-version none \
        --out /texts

# ---------------------------------------------------------------------------
# cuda-runtime: Debian 13 with its Python 3 and the VMAFx files. No NVIDIA
# library: the toolkit mounts the host driver's libcuda.so.1 (Linux), Docker
# Desktop mounts /usr/lib/wsl/lib (WSL2); the build fails below if an NVIDIA
# library or a NEEDED entry naming one appears.
# ---------------------------------------------------------------------------
FROM ${RELEASE_BUILDER_BASE} AS cuda-runtime
ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && apt-get clean \
    && find /usr/lib/python3* /usr/share/python3 -name __pycache__ -prune -exec rm -r {} + \
    && rm -rf /var/lib/apt/lists/*
# NVIDIA_DRIVER_CAPABILITIES asks the NVIDIA Container Toolkit for the compute
# libraries (libcuda, the PTX JIT compiler) of the host driver.
ENV LD_LIBRARY_PATH=/opt/vmafx/build/src:/usr/lib/wsl/lib \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp
COPY --from=cuda-build /opt/vmafx/licenses /opt/vmafx/licenses
COPY --from=cuda-build /opt/vmafx/build /opt/vmafx/build
COPY --from=cuda-build /opt/vmafx/tests /opt/vmafx/tests
COPY --from=cuda-build /opt/vmafx/image /opt/vmafx/image
COPY --from=cuda-build /opt/vmafx/model /opt/vmafx/model
COPY --from=cuda-build /opt/vmafx/tester/gate /opt/vmafx/tester/gate
COPY --from=fixtures /out /opt/vmafx/python/test/resource
COPY tools/rc1-tester/src /opt/vmafx/tester/src
COPY tools/rc1-tester/vmaf-tester-report /opt/vmafx/tester/vmaf-tester-report
COPY tools/rc1-tester/image/fixtures.json tools/rc1-tester/image/cuda-rows.json /opt/vmafx/image/
ARG VMAFX_SOURCE_COMMIT=unknown
ARG VMAFX_IMAGE_TAG=unknown
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=cuda-build,source=/licence-inputs,target=/licence-inputs \
    --mount=type=bind,from=cuda-licence-texts,source=/texts,target=/texts \
    python3 /repo/tools/rc1-tester/image/licensing.py notices --artifact cuda-image --root / \
        --repo /repo --build-scan /licence-inputs/vmafx-sources.json --texts /texts \
        --source-commit "${VMAFX_SOURCE_COMMIT}" --tag "${VMAFX_IMAGE_TAG}"
RUN nvidia="$(find / -xdev \( -name 'libcuda*' -o -name 'libcudart*' -o -name 'libnvidia-*' \
            -o -name 'libnvrtc*' -o -name 'libnvJitLink*' -o -name 'libdevice*' \) -print)" \
    && if [ -n "${nvidia}" ]; then echo "NVIDIA files in the image: ${nvidia}" >&2; exit 1; fi \
    && for binary in /opt/vmafx/build/tools/vmaf /opt/vmafx/build/src/libvmaf.so.* /opt/vmafx/tests/*; do \
        if [ "$(head -c 4 "${binary}" | tail -c 3)" = ELF ] && ldd "${binary}" | grep 'not found'; then \
            echo "unresolved dependency in ${binary}" >&2; exit 1; \
        fi; \
    done \
    && /opt/vmafx/build/tools/vmaf --version

# ---------------------------------------------------------------------------
# cuda-refs-gen: CPU scores of this image's own binary, produced at build time
# ---------------------------------------------------------------------------
FROM cuda-runtime AS cuda-refs-gen
RUN python3 /opt/vmafx/tester/vmaf-tester-report generate-reference /opt/vmafx/reference

# ---------------------------------------------------------------------------
# cuda-assembled: the image's content before the licence check
# ---------------------------------------------------------------------------
FROM cuda-runtime AS cuda-assembled
COPY --from=cuda-refs-gen /opt/vmafx/reference /opt/vmafx/reference

# ---------------------------------------------------------------------------
# cuda-licence-check: every file of the assembled image has a recorded licence
# (ADR-1503 rule 3); final-cuda copies its receipt
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS cuda-licence-check
RUN --mount=type=bind,from=cuda-assembled,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=cuda-build,source=/licence-inputs,target=/licence-inputs \
    mkdir /out \
    && python3 /repo/tools/rc1-tester/image/licensing.py check --artifact cuda-image \
        --root /rootfs --repo /repo --build-scan /licence-inputs/vmafx-sources.json \
        --python-version none --receipt /out/licence-check.json

# ---------------------------------------------------------------------------
# cuda-source-export: the corresponding source of the NVIDIA GPU image's
# copyleft parts (its Debian packages), published as
# ghcr.io/vmafx/vmafx:<tag>-cuda-source (ADR-1503 rule 5)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS cuda-source-fetch
# Only /sources leaves this stage, so its package lists need no cleanup.
# hadolint ignore=DL3009
RUN --mount=type=bind,from=cuda-assembled,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && python3 /repo/tools/rc1-tester/image/licensing.py sources --artifact cuda-image \
        --root /rootfs --repo /repo --out /sources.list \
    && python3 /repo/tools/rc1-tester/image/licensing.py fetch-sources --list /sources.list \
        --out /sources

FROM scratch AS cuda-source-export
COPY --from=cuda-source-fetch /sources /sources

# ---------------------------------------------------------------------------
# final-cuda
# ---------------------------------------------------------------------------
FROM cuda-assembled AS final-cuda
ARG VMAFX_SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.title="vmafx-tester-cuda" \
      org.opencontainers.image.description="VMAFx NVIDIA GPU tester image: CUDA build, CUDA device tests, parity gate, one JSON report. Licences: /opt/vmafx/licenses/THIRD_PARTY_NOTICES.txt" \
      org.opencontainers.image.source="https://github.com/VMAFx/vmafx" \
      org.opencontainers.image.vendor="Lusoris" \
      org.opencontainers.image.revision="${VMAFX_SOURCE_COMMIT}"
COPY --from=cuda-licence-check /out/licence-check.json /opt/vmafx/licence-check.json
USER 10001:10001
ENTRYPOINT ["/usr/bin/python3", "/opt/vmafx/tester/vmaf-tester-report"]

# ===========================================================================
# AMD GPU variant: ghcr.io/vmafx/vmafx:<describe>-tester-hip (linux/amd64).
#   docker build -f docker/Dockerfile.tester --target final-hip .
# The HIP runtime comes from the pinned ROCm 10.1.0 image (ROCM_BUILDER of
# build-config.env); the image ships only the files libvmaf loads, unmodified,
# with their licence texts (tools/rc1-tester/image/hip-runtime.json).
# ===========================================================================

# ---------------------------------------------------------------------------
# hip-build: Debian 13 with /opt/rocm streamed out of the ROCm image
# (scripts/ci/install-rocm-from-image.sh, as the CI HIP legs do; share/doc kept
# for the licence texts). The code objects cover HIP_GFX_TARGETS: every target
# ROCm 10.1.0 builds its own libraries for (share/therock/dist_info.json; the
# build checks the two lists agree). The compilers stay in this stage.
# ---------------------------------------------------------------------------
FROM ${RELEASE_BUILDER_BASE} AS hip-build
ARG DEBIAN_FRONTEND=noninteractive
ARG VMAF_BUILD_JOBS=4
ARG ROCM_BUILDER
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl gcc g++ jq meson nasm ninja-build pkg-config python3 xxd zstd \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/ci/install-rocm-from-image.sh /tmp/vmafx/install-rocm-from-image.sh
RUN bash /tmp/vmafx/install-rocm-from-image.sh --image "${ROCM_BUILDER}" --dest /opt/rocm --keep-docs \
    && rm -rf /tmp/vmafx
ENV PATH="/opt/rocm/bin:${PATH}" ROCM_PATH=/opt/rocm HIP_PATH=/opt/rocm
WORKDIR /opt/vmafx/src
COPY core core
COPY model model
COPY REUSE.toml REUSE.toml
COPY scripts/__init__.py scripts/__init__.py
COPY scripts/lib scripts/lib
COPY scripts/ci/check-msvc-clz-shim.sh scripts/ci/cross_backend_parity_gate.py \
     scripts/ci/cross_backend_calibration.py scripts/ci/
COPY scripts/ci/exact_twins.d scripts/ci/exact_twins.d
COPY docs/adr docs/adr
COPY tools/rc1-tester/image tools/rc1-tester/image
COPY tools/rc1-tester/src tools/rc1-tester/src
# Declared here, not at the top of the stage, so a change of the list does not
# invalidate the cached ROCm download above.
ARG HIP_GFX_TARGETS=gfx908,gfx90a,gfx942,gfx950,gfx1010,gfx1011,gfx1012,gfx1030,gfx1031,gfx1032,gfx1033,gfx1034,gfx1035,gfx1036,gfx1100,gfx1101,gfx1102,gfx1103,gfx1150,gfx1151,gfx1152,gfx1153,gfx1200,gfx1201,gfx1250
# hadolint ignore=SC2046
RUN python3 -c 'import json, sys; dist = json.load(open(sys.argv[1]))["dist_amdgpu_targets"]; \
            missing = set(dist.split(";")) ^ set(sys.argv[2].split(",")); \
            sys.exit(f"HIP_GFX_TARGETS differs from ROCm dist targets: {sorted(missing)}" if missing else 0)' \
        /opt/rocm/share/therock/dist_info.json "${HIP_GFX_TARGETS}" \
    && meson setup build core --buildtype=release --strip -Db_lto=false \
        -Denable_float=true -Denable_cuda=false -Denable_sycl=false \
        -Denable_hip=true -Denable_hipcc=true -Dhip_gfx_targets="${HIP_GFX_TARGETS}" \
        -Denable_dnn=disabled -Denable_docs=false -Denable_tests=true \
    && nice -n 10 ninja -C build -j"${VMAF_BUILD_JOBS}" tools/vmaf \
        $(python3 tools/rc1-tester/image/prepare_build.py select build \
            tools/rc1-tester/image/unit-tests.txt) \
        $(python3 tools/rc1-tester/image/prepare_build.py select build \
            tools/rc1-tester/image/hip-tests.txt) \
    && mkdir /licence-inputs \
    && python3 tools/rc1-tester/image/licensing.py scan-build --build build \
        --repo /opt/vmafx/src --out /licence-inputs/vmafx-sources.json
# The ROCm runtime files go next to each other as in /opt/rocm/lib, so their
# RPATHs ($ORIGIN/llvm/lib, $ORIGIN/rocm_sysdeps/lib) resolve without patching.
RUN mkdir -p /opt/vmafx/build/tools /opt/vmafx/build/src /opt/vmafx/model \
    && cp build/tools/vmaf /opt/vmafx/build/tools/ \
    && find build/src -maxdepth 1 -name 'libvmaf.so*' -not -type d \
        -exec cp -a {} /opt/vmafx/build/src/ \; \
    && python3 tools/rc1-tester/image/prepare_build.py stage build \
        tools/rc1-tester/image/unit-tests.txt /opt/vmafx \
    && python3 tools/rc1-tester/image/prepare_build.py stage build \
        tools/rc1-tester/image/hip-tests.txt /opt/vmafx gpu-tests.json \
    && python3 tools/rc1-tester/image/prepare_build.py gate /opt/vmafx/src /opt/vmafx \
    && python3 tools/rc1-tester/image/prepare_build.py twins /opt/vmafx hip \
    && python3 tools/rc1-tester/image/prepare_build.py hip-targets build /opt/rocm /opt/vmafx \
    && python3 tools/rc1-tester/image/prepare_build.py rocm-runtime \
        tools/rc1-tester/image/hip-runtime.json /opt/rocm /opt/vmafx \
    && cp -r model/. /opt/vmafx/model/ \
    && rm -r /opt/vmafx/model/tiny \
    && find /opt/vmafx/model -maxdepth 1 -name '*.onnx*' -delete
ARG VMAFX_SOURCE_COMMIT=unknown
ARG VMAFX_SOURCE_REF=unknown
ARG VMAFX_RECIPE_COMMIT=unknown
ARG VMAFX_BUILT_BY_WORKFLOW=false
ARG VMAFX_IMAGE_TAG=unknown
ARG RELEASE_BUILDER_BASE
ENV VMAFX_SOURCE_COMMIT=${VMAFX_SOURCE_COMMIT} VMAFX_SOURCE_REF=${VMAFX_SOURCE_REF} \
    VMAFX_RECIPE_COMMIT=${VMAFX_RECIPE_COMMIT} \
    VMAFX_BUILT_BY_WORKFLOW=${VMAFX_BUILT_BY_WORKFLOW} VMAFX_IMAGE_TAG=${VMAFX_IMAGE_TAG} \
    VMAFX_BASE_IMAGE=${RELEASE_BUILDER_BASE} VMAFX_GPU_BACKEND=hip \
    VMAFX_NOT_APPLICABLE='{"golden": "the HIP image carries no Python test stack; the CPU tester image runs the Netflix golden gate"}'
RUN python3 tools/rc1-tester/image/prepare_build.py info /opt/vmafx

# ---------------------------------------------------------------------------
# hip-licence-texts: the licence texts ROCm does not install (kpack, LLVM, the
# system libraries its runtime bundles), pinned by URL and SHA-256 in
# licensing.json (fetched_texts)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS hip-licence-texts
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/licensing \
    python3 /licensing/licensing.py fetch-texts --artifact hip-image --python-version none \
        --out /texts

# ---------------------------------------------------------------------------
# hip-runtime: Debian 13 with its Python 3, the VMAFx files and the ROCm runtime
# files of hip-runtime.json. The GPU kernel driver (amdgpu, /dev/kfd) is the
# host's; every binary must resolve its libraries in the image.
# ---------------------------------------------------------------------------
FROM ${RELEASE_BUILDER_BASE} AS hip-runtime
ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && apt-get clean \
    && find /usr/lib/python3* /usr/share/python3 -name __pycache__ -prune -exec rm -r {} + \
    && rm -rf /var/lib/apt/lists/*
ENV LD_LIBRARY_PATH=/opt/vmafx/build/src:/opt/vmafx/lib/rocm \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp
COPY --from=hip-build /opt/vmafx/lib /opt/vmafx/lib
COPY --from=hip-build /opt/vmafx/licenses /opt/vmafx/licenses
COPY --from=hip-build /opt/vmafx/build /opt/vmafx/build
COPY --from=hip-build /opt/vmafx/tests /opt/vmafx/tests
COPY --from=hip-build /opt/vmafx/image /opt/vmafx/image
COPY --from=hip-build /opt/vmafx/model /opt/vmafx/model
COPY --from=hip-build /opt/vmafx/tester/gate /opt/vmafx/tester/gate
COPY --from=fixtures /out /opt/vmafx/python/test/resource
COPY tools/rc1-tester/src /opt/vmafx/tester/src
COPY tools/rc1-tester/vmaf-tester-report /opt/vmafx/tester/vmaf-tester-report
COPY tools/rc1-tester/image/fixtures.json tools/rc1-tester/image/hip-rows.json /opt/vmafx/image/
ARG VMAFX_SOURCE_COMMIT=unknown
ARG VMAFX_IMAGE_TAG=unknown
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=hip-build,source=/licence-inputs,target=/licence-inputs \
    --mount=type=bind,from=hip-licence-texts,source=/texts,target=/texts \
    python3 /repo/tools/rc1-tester/image/licensing.py notices --artifact hip-image --root / \
        --repo /repo --build-scan /licence-inputs/vmafx-sources.json --texts /texts \
        --source-commit "${VMAFX_SOURCE_COMMIT}" --tag "${VMAFX_IMAGE_TAG}"
RUN for binary in /opt/vmafx/build/tools/vmaf /opt/vmafx/build/src/libvmaf.so.* /opt/vmafx/tests/* \
        /opt/vmafx/lib/rocm/*.so.* /opt/vmafx/lib/rocm/llvm/lib/*.so.* \
        /opt/vmafx/lib/rocm/rocm_sysdeps/lib/*.so*; do \
        if [ "$(head -c 4 "${binary}" | tail -c 3)" = ELF ] && ldd "${binary}" | grep 'not found'; then \
            echo "unresolved dependency in ${binary}" >&2; exit 1; \
        fi; \
    done \
    && /opt/vmafx/build/tools/vmaf --version

# ---------------------------------------------------------------------------
# hip-refs-gen: CPU scores of this image's own binary, produced at build time
# ---------------------------------------------------------------------------
FROM hip-runtime AS hip-refs-gen
RUN python3 /opt/vmafx/tester/vmaf-tester-report generate-reference /opt/vmafx/reference

# ---------------------------------------------------------------------------
# hip-assembled: the image's content before the licence check
# ---------------------------------------------------------------------------
FROM hip-runtime AS hip-assembled
COPY --from=hip-refs-gen /opt/vmafx/reference /opt/vmafx/reference

# ---------------------------------------------------------------------------
# hip-licence-check: every file of the assembled image has a recorded licence
# (ADR-1503 rule 3); final-hip copies its receipt
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS hip-licence-check
RUN --mount=type=bind,from=hip-assembled,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=hip-build,source=/licence-inputs,target=/licence-inputs \
    mkdir /out \
    && python3 /repo/tools/rc1-tester/image/licensing.py check --artifact hip-image \
        --root /rootfs --repo /repo --build-scan /licence-inputs/vmafx-sources.json \
        --python-version none --receipt /out/licence-check.json

# ---------------------------------------------------------------------------
# hip-source-export: the corresponding source of the AMD GPU image's copyleft
# parts (its Debian packages, and the upstream archives and the TheRock tree of
# the LGPL libraries the ROCm runtime bundles), published as
# ghcr.io/vmafx/vmafx:<tag>-hip-source (ADR-1503 rule 5)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS hip-source-fetch
# Only /sources leaves this stage, so its package lists need no cleanup. git
# fetches the TheRock tree by its commit (licensing.json source_archives).
# hadolint ignore=DL3008,DL3009
RUN --mount=type=bind,from=hip-assembled,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends git \
    && python3 /repo/tools/rc1-tester/image/licensing.py sources --artifact hip-image \
        --root /rootfs --repo /repo --out /sources.list \
    && python3 /repo/tools/rc1-tester/image/licensing.py fetch-sources --list /sources.list \
        --out /sources

FROM scratch AS hip-source-export
COPY --from=hip-source-fetch /sources /sources

# ---------------------------------------------------------------------------
# final-hip
# ---------------------------------------------------------------------------
FROM hip-assembled AS final-hip
ARG VMAFX_SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.title="vmafx-tester-hip" \
      org.opencontainers.image.description="VMAFx AMD GPU tester image: HIP build, HIP device tests, parity gate, one JSON report. Licences: /opt/vmafx/licenses/THIRD_PARTY_NOTICES.txt" \
      org.opencontainers.image.source="https://github.com/VMAFx/vmafx" \
      org.opencontainers.image.vendor="Lusoris" \
      org.opencontainers.image.revision="${VMAFX_SOURCE_COMMIT}"
COPY --from=hip-licence-check /out/licence-check.json /opt/vmafx/licence-check.json
USER 10001:10001
ENTRYPOINT ["/usr/bin/python3", "/opt/vmafx/tester/vmaf-tester-report"]

# ---------------------------------------------------------------------------
# assembled: the image's content before the licence check
# ---------------------------------------------------------------------------
FROM runtime AS assembled
COPY --from=refs-gen /opt/vmafx/reference /opt/vmafx/reference
COPY --from=xref / /opt/vmafx/reference/

# ---------------------------------------------------------------------------
# licence-check: every file of the assembled image has a recorded licence
# (ADR-1503 rule 3); the final stage copies its receipt, so it cannot be built
# without passing this
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS licence-check
RUN --mount=type=bind,from=assembled,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=vmaf-build,source=/licence-inputs,target=/licence-inputs \
    mkdir /out \
    && python3 /repo/tools/rc1-tester/image/licensing.py check --artifact image --root /rootfs \
        --repo /repo --build-scan /licence-inputs/vmafx-sources.json \
        --python-version "$(python3 -c 'import platform; print(platform.python_version())')" \
        --receipt /out/licence-check.json

# ---------------------------------------------------------------------------
# source-export: the corresponding source of the image's copyleft parts,
# published as ghcr.io/vmafx/vmafx:<tag>-source (ADR-1503 rule 5)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS source-fetch
# Only /sources leaves this stage, so its package lists need no cleanup.
# hadolint ignore=DL3009
RUN --mount=type=bind,from=assembled,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && python3 /repo/tools/rc1-tester/image/licensing.py sources --artifact image --root /rootfs \
        --repo /repo --out /sources.list \
    && python3 /repo/tools/rc1-tester/image/licensing.py fetch-sources --list /sources.list \
        --out /sources

FROM scratch AS source-export
COPY --from=source-fetch /sources /sources

# ---------------------------------------------------------------------------
# final
# ---------------------------------------------------------------------------
FROM assembled AS final
ARG VMAFX_SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.title="vmafx-tester" \
      org.opencontainers.image.description="VMAFx tester image: CPU build, SIMD unit tests, Netflix golden gate, one JSON report. Licences: /opt/vmafx/licenses/THIRD_PARTY_NOTICES.txt" \
      org.opencontainers.image.source="https://github.com/VMAFx/vmafx" \
      org.opencontainers.image.licenses="EUPL-1.2 AND BSD-2-Clause-Patent AND BSD-3-Clause AND BSD-3-Clause-Clear AND BSD-2-Clause AND ISC AND MIT AND Unlicense AND LicenseRef-LIVE-BRISQUE" \
      org.opencontainers.image.vendor="Lusoris" \
      org.opencontainers.image.revision="${VMAFX_SOURCE_COMMIT}"
COPY --from=licence-check /out/licence-check.json /opt/vmafx/licence-check.json
USER 10001:10001
ENTRYPOINT ["/opt/venv/bin/python", "/opt/vmafx/tester/vmaf-tester-report"]
