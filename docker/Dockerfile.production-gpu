# ---------------------------------------------------------------------------
FROM oneapi2026-with-notices AS final-oneapi2026
COPY --from=oneapi2026-licence-check /out/licence-check.json /usr/local/share/vmafx/licence-check.json
# Drop privileges. Intel GPU access via /dev/dri/renderD* needs the host's
