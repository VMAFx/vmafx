#
# docker/Dockerfile.production-gpu — VMAFX production GPU images
#
# Targets (the CPU image is docker/Dockerfile.production):
#   final-cuda13     — CUDA build of libvmaf; no NVIDIA library in the image
#   final-rocm10     — HIP build with the ROCm 10.1.0 runtime files it loads
#   final-oneapi2026 — SYCL build with the Intel SYCL runtime files it loads
#                      and the compute-runtime (NEO) GPU stack (ADR-1368)
#   final-oneapi2025 — alias of final-oneapi2026, kept for existing callers
# and the corresponding source of each image's copyleft parts (ADR-1503):
#   cuda13-source-export, rocm10-source-export, oneapi2026-source-export
#
# Every builder and runtime is the release track's Debian 13 (ADR-1517). The
# CUDA and ROCm builders take the toolchains of the GPU tester images
# (docker/Dockerfile.tester): nvcc from NVIDIA's debian13 repository, /opt/rocm
# streamed out of the pinned ROCm image. A runtime carries only the vendor files
# libvmaf loads, copied unmodified with their licence texts
# (tools/rc1-tester/image/hip-runtime.json, sycl-runtime.json), and none of the
# toolchain.
#
# Licences (ADR-1513, ADR-1517): each image carries
# /usr/local/share/vmafx/licenses/ (THIRD_PARTY_NOTICES.txt and every licence
# text, written by tools/rc1-tester/image/licensing.py from licensing.json) and
# cannot be built without passing the licence check of its artifact kind
# (production-cuda-image, production-rocm-image, production-oneapi-image).
#
# Tag matrix (built by CI):
#   ghcr.io/vmafx/vmafx:<tag>-cuda13       (and <tag>-cuda13-source)
#   ghcr.io/vmafx/vmafx:<tag>-rocm10       (and <tag>-rocm10-source)
#   ghcr.io/vmafx/vmafx:<tag>-oneapi2026   (also tagged -oneapi2025, ADR-1368;
#                                           and <tag>-oneapi2026-source)
#
# Build args (all optional):
#   VMAF_BUILD_JOBS     — ninja parallelism (default: 4)
#   VMAFX_SOURCE_COMMIT — commit the notices name as the VMAFx source (EUPL-1.2 Art. 5)
#   VMAFX_IMAGE_TAG     — image tag the notices and the source offer name
#
# ADR-0698: vmafx-production-dockerfile
# ADR-1129: release-container-runtime-alignment
# ADR-1368: oneapi-release-image-debian13
# ADR-1517: gpu-image-licensing

# Base images come from build-config.env -- the single source of truth for
# every container base in this repository. These defaults are mirrors kept in
# sync by scripts/ci/check-base-image-single-source.sh; edit the config, not
# these lines, then run `make base-images-sync`.
ARG RELEASE_BUILDER_BASE="debian:13-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f"
ARG RELEASE_PYTHON_BASE="python:3.14-slim@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170"
ARG ROCM_BUILDER="rocm/dev-ubuntu-26.04:10.1.0-full@sha256:4f5ed1bf6532a4b9920400401b0ad0f706af356dae61e40afefbfd6c8073f0ce"
ARG ONEAPI_BUILDER="debian:13-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f"
ARG ONEAPI_RUNTIME="debian:13-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f"

# The oneAPI builder installs one immutable, checksum-verified Meson wheel
# rather than floating on PyPI.
FROM scratch AS meson-wheel
ADD --checksum=sha256:71f133147fa0fcfe8f4df49fa1045771064947834538409e5d97b3613aac8b4e \
    https://files.pythonhosted.org/packages/07/68/b0117422eb0a46d9d8d9e328f0c5b5c835179bfc058688bca35c90c89eba/meson-1.12.0-py3-none-any.whl \
    /meson-1.12.0-py3-none-any.whl

# ===========================================================================
# Builders: libvmaf and vmaf in /dist, the licence scan in /licence-inputs,
# the vendor files and texts the image ships in /stage
# ===========================================================================

# --- CUDA 13.4.2 build (ADR-1306, ADR-1517) ---
# Debian 13 with nvcc from NVIDIA's debian13 repository at build-config.env's
# exact versions (scripts/ci/install-cuda-toolkit.sh) and the nv-codec-headers
# commit core/src/meson.build requires. The default gencode list of
# core/src/meson.build: cubins for sm_80, sm_86, sm_89, sm_90, sm_100 and
# sm_120, PTX for compute_80 and compute_120.
FROM ${RELEASE_BUILDER_BASE} AS builder-cuda13
ARG DEBIAN_FRONTEND=noninteractive
ARG VMAF_BUILD_JOBS=4
ARG NV_CODEC_HEADERS_COMMIT=876af32a202d0de83bd1d36fe74ee0f7fcf86b0d
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gcc \
        g++ \
        git \
        make \
        meson \
        nasm \
        ninja-build \
        pkg-config \
        python3 \
        xxd \
    && rm -rf /var/lib/apt/lists/*
COPY build-config.env scripts/ci/install-cuda-toolkit.sh /tmp/vmafx/
RUN bash /tmp/vmafx/install-cuda-toolkit.sh --mode=builder /tmp/vmafx \
    && rm -rf /tmp/vmafx /var/lib/apt/lists/*
ENV PATH="/usr/local/cuda/bin:${PATH}"
# libvmaf compiles the headers' CUDA loader in, so their notices travel with
# the image.
RUN git init -q /tmp/nv-codec-headers \
    && git -C /tmp/nv-codec-headers fetch -q --depth=1 \
        https://code.ffmpeg.org/FFmpeg/nv-codec-headers.git "${NV_CODEC_HEADERS_COMMIT}" \
    && git -C /tmp/nv-codec-headers checkout -q --detach FETCH_HEAD \
    && test "$(git -C /tmp/nv-codec-headers rev-parse HEAD)" = "${NV_CODEC_HEADERS_COMMIT}" \
    && make -C /tmp/nv-codec-headers install PREFIX=/usr/local \
    && mkdir -p /stage/licenses/nv-codec-headers \
    && for header in dynlink_cuda.h dynlink_loader.h; do \
        { echo "include/ffnvcodec/${header} of nv-codec-headers ${NV_CODEC_HEADERS_COMMIT}:"; \
          sed -n '1,/\*\//p' "/tmp/nv-codec-headers/include/ffnvcodec/${header}"; echo; } \
          >> /stage/licenses/nv-codec-headers/NOTICE.txt; \
    done \
    && grep -q 'Permission is hereby granted' /stage/licenses/nv-codec-headers/NOTICE.txt \
    && rm -rf /tmp/nv-codec-headers
WORKDIR /src
COPY . .
RUN meson setup build core --buildtype=release --strip -Db_lto=false \
        -Denable_cuda=true -Denable_nvcc=true -Dnvcc_threads=1 \
        -Denable_sycl=false -Denable_hip=false -Denable_dnn=disabled \
        -Denable_docs=false -Denable_tests=false \
    && nice -n 10 ninja -C build -j"${VMAF_BUILD_JOBS}"
# The NVIDIA parts of the kernels are CUDA headers and the libdevice library
# nvcc links into the fatbins (CUDA EULA 1.1.1(c), Attachment A); the EULA text
# is the copyright file of the package that installs libdevice.10.bc. No binary
# may link an NVIDIA library: the headers' loader opens the host driver's
# libcuda.so.1 at run time.
RUN mkdir -p /dist/lib /dist/bin /dist/model /stage/licenses/nvidia /licence-inputs \
    && find build/src -maxdepth 1 \( -name 'libvmaf.so*' -o -name 'libvmafx.so*' \) -not -type d -exec cp -a {} /dist/lib/ \; \
    && cp build/tools/vmaf /dist/bin/ \
    && cp -r model/. /dist/model/ \
    && for binary in /dist/bin/vmaf /dist/lib/libvmaf.so.* /dist/lib/libvmafx.so.*; do \
        if readelf -d "${binary}" | grep -E 'NEEDED.*lib(cuda|nv)'; then \
            echo "${binary} links an NVIDIA library" >&2; exit 1; \
        fi; \
    done \
    && libdevice_package="$(dpkg -S 'libdevice.10.bc' | head -n 1 | cut -d: -f1)" \
    && cp "/usr/share/doc/${libdevice_package}/copyright" /stage/licenses/nvidia/CUDA-EULA.txt \
    && grep -q 'Last updated: January 26, 2026' /stage/licenses/nvidia/CUDA-EULA.txt \
    && grep -q 'libdevice.10.bc' /stage/licenses/nvidia/CUDA-EULA.txt \
    && python3 tools/rc1-tester/image/licensing.py scan-build --build build --repo /src \
        --out /licence-inputs/vmafx-sources.json

# --- ROCm 10.1.0 build (ADR-1225, ADR-1517) ---
# ROCm 10.1.0 ships only as a container image (TheRock; the apt channel at
# repo.radeon.com/rocm/apt/ tops out at 7.2.4). Debian 13 with /opt/rocm
# streamed out of that image by scripts/ci/install-rocm-from-image.sh, as the CI
# HIP legs and the AMD GPU tester image do; share/doc is kept for the licence
# texts. The code objects cover every target ROCm 10.1.0 builds its own
# libraries for (share/therock/dist_info.json).
FROM ${RELEASE_BUILDER_BASE} AS builder-rocm10
ARG DEBIAN_FRONTEND=noninteractive
ARG VMAF_BUILD_JOBS=4
ARG ROCM_BUILDER
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# The lines up to the stream of /opt/rocm are those of hip-build in
# docker/Dockerfile.tester, so both builds share its 5.8 GB layer.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl gcc g++ jq meson nasm ninja-build pkg-config python3 xxd zstd \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/ci/install-rocm-from-image.sh /tmp/vmafx/install-rocm-from-image.sh
RUN bash /tmp/vmafx/install-rocm-from-image.sh --image "${ROCM_BUILDER}" --dest /opt/rocm --keep-docs \
    && rm -rf /tmp/vmafx
ENV PATH="/opt/rocm/bin:${PATH}" ROCM_PATH=/opt/rocm HIP_PATH=/opt/rocm
WORKDIR /src
COPY . .
RUN gfx_targets="$(jq -r '.dist_amdgpu_targets' /opt/rocm/share/therock/dist_info.json | tr ';' ',')" \
    && test -n "${gfx_targets}" \
    && meson setup build core --buildtype=release --strip -Db_lto=false \
        -Denable_cuda=false -Denable_sycl=false \
        -Denable_hip=true -Denable_hipcc=true -Dhip_gfx_targets="${gfx_targets}" \
        -Denable_dnn=disabled -Denable_docs=false -Denable_tests=false \
    && nice -n 10 ninja -C build -j"${VMAF_BUILD_JOBS}"
# The ROCm runtime files go next to each other as in /opt/rocm/lib, so their
# RPATHs ($ORIGIN/llvm/lib, $ORIGIN/rocm_sysdeps/lib) resolve without patching.
RUN mkdir -p /dist/lib /dist/bin /dist/model /licence-inputs \
    && find build/src -maxdepth 1 \( -name 'libvmaf.so*' -o -name 'libvmafx.so*' \) -not -type d -exec cp -a {} /dist/lib/ \; \
    && cp build/tools/vmaf /dist/bin/ \
    && cp -r model/. /dist/model/ \
    && python3 tools/rc1-tester/image/prepare_build.py rocm-runtime \
        tools/rc1-tester/image/hip-runtime.json /opt/rocm /stage \
    && python3 tools/rc1-tester/image/licensing.py scan-build --build build --repo /src \
        --out /licence-inputs/vmafx-sources.json

# --- oneAPI 2026.1 build (ADR-1368, ADR-1517) ---
# The release track's Debian 13 plus Intel's oneAPI compiler from its apt
# repository at the exact build build-config.env pins. The image takes its SYCL
# runtime files from this same installation, so both sides agree on
# libsycl.so.9 and on Debian 13's glibc; Intel's own images could not supply
# that pair.
FROM ${ONEAPI_BUILDER} AS builder-oneapi2026

ARG DEBIAN_FRONTEND=noninteractive
ARG VMAF_BUILD_JOBS=4
ARG MESON_VERSION=1.12.0

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# hadolint ignore=DL3008,DL3009
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ccache \
        curl \
        gcc \
        g++ \
        gpg \
        nasm \
        ninja-build \
        pkg-config \
        python3-pip \
        xxd \
        zstd

RUN --mount=type=bind,from=meson-wheel,source=/meson-1.12.0-py3-none-any.whl,target=/tmp/meson-1.12.0-py3-none-any.whl \
    python3 -m pip install --break-system-packages --ignore-installed --no-cache-dir --no-deps \
        /tmp/meson-1.12.0-py3-none-any.whl \
    && test "$(meson --version)" = "${MESON_VERSION}"

# icpx from Intel's apt repository (scripts/ci/install-intel-oneapi.sh), then
# the build set of the pinned Intel GPU stack (scripts/ci/install-intel-ocloc.sh):
# ocloc, which compiles the SYCL ahead-of-time images (sycl_icpx_aot_targets,
# ADR-1360) and which the Linux compiler does not ship, and the Level Zero
# loader libvmaf links (libze1 + libze-dev at LEVEL_ZERO_VERSION). zstd above
# lets the build-time AOT image check read the compressed images under Debian
# 13's Python 3.13. The optional `github_token` secret lifts the anonymous
# GitHub API limit for the NEO and Level Zero release lookups.
COPY build-config.env /tmp/vmafx/build-config.env
COPY scripts/ci/install-intel-oneapi.sh scripts/ci/install-intel-ocloc.sh /tmp/vmafx/scripts/ci/
COPY dev/scripts/fetch-intel-neo.py /tmp/vmafx/dev/scripts/fetch-intel-neo.py
# hadolint ignore=DL3008
RUN --mount=type=secret,id=github_token,env=GITHUB_TOKEN,required=false \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    bash /tmp/vmafx/scripts/ci/install-intel-oneapi.sh --mode=builder /tmp/vmafx \
    && bash /tmp/vmafx/scripts/ci/install-intel-ocloc.sh --components build /tmp/vmafx \
    && rm -rf /tmp/vmafx

ENV ONEAPI_ROOT=/opt/intel/oneapi
ENV PATH="${ONEAPI_ROOT}/compiler/latest/bin:${PATH}"

WORKDIR /src
COPY . .

# The SYCL runtime files libvmaf loads, from this compiler's installation and
# its credist.txt (the Redistributables of the Intel EULA for Developer Tools,
# 2.1.D), go to the image with their licence texts; the compiler stays here.
RUN CC=icx CXX=icpx meson setup build core --buildtype=release --strip -Db_lto=false \
        -Denable_cuda=false -Denable_sycl=true -Denable_hip=false \
        -Denable_dnn=disabled -Denable_docs=false -Denable_tests=false \
    && nice -n 10 ninja -C build -j"${VMAF_BUILD_JOBS}"
RUN mkdir -p /dist/lib /dist/bin /dist/model /licence-inputs \
    && find build/src -maxdepth 1 \( -name 'libvmaf.so*' -o -name 'libvmafx.so*' \) -not -type d -exec cp -a {} /dist/lib/ \; \
    && cp build/tools/vmaf /dist/bin/ \
    && cp -r model/. /dist/model/ \
    && python3 tools/rc1-tester/image/prepare_build.py intel-runtime \
        tools/rc1-tester/image/sycl-runtime.json /opt/intel/oneapi /stage \
    && python3 tools/rc1-tester/image/licensing.py scan-build --build build --repo /src \
        --out /licence-inputs/vmafx-sources.json

# (ADR-0726: Vulkan backend removed; builder-vulkan stage deleted)

# ===========================================================================
# NVIDIA GPU image: ghcr.io/vmafx/vmafx:<tag>-cuda13
# No NVIDIA library: libvmaf loads the host driver's libcuda.so.1 at run time,
# which the NVIDIA Container Toolkit mounts with --gpus all (Docker Desktop:
# /usr/lib/wsl/lib); the kernels are fatbins inside libvmaf.
# ===========================================================================
FROM ${RELEASE_BUILDER_BASE} AS cuda13-assembled
LABEL org.opencontainers.image.title="vmafx"
LABEL org.opencontainers.image.description="VMAFX production CUDA 13.4.2 runtime (the host driver provides libcuda). Licences: /usr/local/share/vmafx/licenses/THIRD_PARTY_NOTICES.txt"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"
LABEL org.opencontainers.image.licenses="EUPL-1.2 AND BSD-2-Clause-Patent AND BSD-3-Clause AND BSD-2-Clause AND ISC AND MIT AND Unlicense AND LicenseRef-LIVE-BRISQUE"
LABEL org.opencontainers.image.vendor="Lusoris"
# NVIDIA_DRIVER_CAPABILITIES asks the NVIDIA Container Toolkit for the compute
# libraries (libcuda, the PTX JIT compiler) of the host driver.
ENV LD_LIBRARY_PATH="/usr/local/lib:/usr/lib/wsl/lib" \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    VMAF_MODEL_PATH="/usr/local/share/vmafx/model"
COPY --from=builder-cuda13 /dist/lib/   /usr/local/lib/
COPY --from=builder-cuda13 /dist/bin/   /usr/local/bin/
COPY --from=builder-cuda13 /dist/model/ /usr/local/share/vmafx/model/
COPY --from=builder-cuda13 /stage/licenses/ /usr/local/share/vmafx/licenses/

# ---------------------------------------------------------------------------
# cuda13-licence-texts: the recorded licence texts that are not in the
# repository, pinned by URL and SHA-256 in licensing.json (fetched_texts)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS cuda13-licence-texts
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/licensing \
    python3 /licensing/licensing.py fetch-texts --artifact production-cuda-image --python-version none \
        --out /texts

# ---------------------------------------------------------------------------
# cuda13-notices: the runtime has no interpreter, so its notices and licence
# texts are written on a copy of its tree (ADR-1503 rule 4)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS cuda13-notices
COPY --from=cuda13-assembled / /rootfs
ARG VMAFX_SOURCE_COMMIT=unknown
ARG VMAFX_IMAGE_TAG=unknown
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=builder-cuda13,source=/licence-inputs,target=/licence-inputs \
    --mount=type=bind,from=cuda13-licence-texts,source=/texts,target=/texts \
    python3 /repo/tools/rc1-tester/image/licensing.py notices --artifact production-cuda-image \
        --root /rootfs --repo /repo --build-scan /licence-inputs/vmafx-sources.json \
        --texts /texts --source-commit "${VMAFX_SOURCE_COMMIT}" --tag "${VMAFX_IMAGE_TAG}"

FROM cuda13-assembled AS cuda13-with-notices
COPY --from=cuda13-notices /rootfs/usr/local/share/vmafx/licenses /usr/local/share/vmafx/licenses
# No NVIDIA file may be in the image, and every binary resolves its libraries.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN nvidia="$(find / -xdev \( -name 'libcuda*' -o -name 'libcudart*' -o -name 'libnvidia-*' \
            -o -name 'libnvrtc*' -o -name 'libnvJitLink*' -o -name 'libdevice*' \) -print)" \
    && if [ -n "${nvidia}" ]; then echo "NVIDIA files in the image: ${nvidia}" >&2; exit 1; fi \
    && for binary in /usr/local/bin/vmaf /usr/local/lib/libvmaf.so.* /usr/local/lib/libvmafx.so.*; do \
        if ldd "${binary}" | grep 'not found'; then \
            echo "unresolved dependency in ${binary}" >&2; exit 1; \
        fi; \
    done \
    && /usr/local/bin/vmaf --version

# ---------------------------------------------------------------------------
# cuda13-licence-check: every file of the image has a recorded licence
# (ADR-1503 rule 3); final-cuda13 copies its receipt, so it cannot be built
# without passing it
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS cuda13-licence-check
RUN --mount=type=bind,from=cuda13-with-notices,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=builder-cuda13,source=/licence-inputs,target=/licence-inputs \
    mkdir /out \
    && python3 /repo/tools/rc1-tester/image/licensing.py check --artifact production-cuda-image \
        --root /rootfs --repo /repo --build-scan /licence-inputs/vmafx-sources.json \
        --python-version none --receipt /out/licence-check.json

# ---------------------------------------------------------------------------
# cuda13-source-export: the corresponding source of the image's copyleft parts,
# published as ghcr.io/vmafx/vmafx:<tag>-cuda13-source (ADR-1503 rule 5)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS cuda13-source-fetch
# Only /sources leaves this stage, so its package lists need no cleanup.
# hadolint ignore=DL3009
RUN --mount=type=bind,from=cuda13-with-notices,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && python3 /repo/tools/rc1-tester/image/licensing.py sources --artifact production-cuda-image \
        --root /rootfs --repo /repo --out /sources.list \
    && python3 /repo/tools/rc1-tester/image/licensing.py fetch-sources --list /sources.list \
        --out /sources

FROM scratch AS cuda13-source-export
COPY --from=cuda13-source-fetch /sources /sources

# ---------------------------------------------------------------------------
# final-cuda13: the published image
# ---------------------------------------------------------------------------
FROM cuda13-with-notices AS final-cuda13
COPY --from=cuda13-licence-check /out/licence-check.json /usr/local/share/vmafx/licence-check.json
# Drop privileges. CUDA device access (/dev/nvidia*) is granted via the
# NVIDIA Container Toolkit; UID 65532 still gets device access when the runtime
# injects /dev nodes with mode 0666.
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/vmaf"]

# ===========================================================================
# AMD GPU image: ghcr.io/vmafx/vmafx:<tag>-rocm10
# The ROCm runtime files of hip-runtime.json in /usr/local/lib/rocm; the GPU
# kernel driver (amdgpu, /dev/kfd) is the host's.
# ===========================================================================
FROM ${RELEASE_BUILDER_BASE} AS rocm10-assembled
LABEL org.opencontainers.image.title="vmafx"
LABEL org.opencontainers.image.description="VMAFX production ROCm 10.1.0 HIP runtime. Licences: /usr/local/share/vmafx/licenses/THIRD_PARTY_NOTICES.txt"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"
LABEL org.opencontainers.image.licenses="EUPL-1.2 AND BSD-2-Clause-Patent AND BSD-3-Clause AND BSD-2-Clause AND ISC AND MIT AND Unlicense AND LicenseRef-LIVE-BRISQUE"
LABEL org.opencontainers.image.vendor="Lusoris"
ENV LD_LIBRARY_PATH="/usr/local/lib:/usr/local/lib/rocm" \
    VMAF_MODEL_PATH="/usr/local/share/vmafx/model"
COPY --from=builder-rocm10 /dist/lib/   /usr/local/lib/
COPY --from=builder-rocm10 /dist/bin/   /usr/local/bin/
COPY --from=builder-rocm10 /dist/model/ /usr/local/share/vmafx/model/
COPY --from=builder-rocm10 /stage/lib/rocm/ /usr/local/lib/rocm/
COPY --from=builder-rocm10 /stage/licenses/ /usr/local/share/vmafx/licenses/

# ---------------------------------------------------------------------------
# rocm10-licence-texts: the recorded licence texts that are not in the
# repository, pinned by URL and SHA-256 in licensing.json (fetched_texts)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS rocm10-licence-texts
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/licensing \
    python3 /licensing/licensing.py fetch-texts --artifact production-rocm-image --python-version none \
        --out /texts

# ---------------------------------------------------------------------------
# rocm10-notices: the runtime has no interpreter, so its notices and licence
# texts are written on a copy of its tree (ADR-1503 rule 4)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS rocm10-notices
COPY --from=rocm10-assembled / /rootfs
ARG VMAFX_SOURCE_COMMIT=unknown
ARG VMAFX_IMAGE_TAG=unknown
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=builder-rocm10,source=/licence-inputs,target=/licence-inputs \
    --mount=type=bind,from=rocm10-licence-texts,source=/texts,target=/texts \
    python3 /repo/tools/rc1-tester/image/licensing.py notices --artifact production-rocm-image \
        --root /rootfs --repo /repo --build-scan /licence-inputs/vmafx-sources.json \
        --texts /texts --source-commit "${VMAFX_SOURCE_COMMIT}" --tag "${VMAFX_IMAGE_TAG}"

FROM rocm10-assembled AS rocm10-with-notices
COPY --from=rocm10-notices /rootfs/usr/local/share/vmafx/licenses /usr/local/share/vmafx/licenses
# Every binary and every ROCm runtime file resolves its libraries in the image.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN for binary in /usr/local/bin/vmaf /usr/local/lib/libvmaf.so.* /usr/local/lib/libvmafx.so.* \
        /usr/local/lib/rocm/*.so.* /usr/local/lib/rocm/llvm/lib/*.so.* \
        /usr/local/lib/rocm/rocm_sysdeps/lib/*.so*; do \
        if ldd "${binary}" | grep 'not found'; then \
            echo "unresolved dependency in ${binary}" >&2; exit 1; \
        fi; \
    done \
    && /usr/local/bin/vmaf --version

# ---------------------------------------------------------------------------
# rocm10-licence-check: every file of the image has a recorded licence
# (ADR-1503 rule 3); final-rocm10 copies its receipt, so it cannot be built
# without passing it
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS rocm10-licence-check
RUN --mount=type=bind,from=rocm10-with-notices,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=builder-rocm10,source=/licence-inputs,target=/licence-inputs \
    mkdir /out \
    && python3 /repo/tools/rc1-tester/image/licensing.py check --artifact production-rocm-image \
        --root /rootfs --repo /repo --build-scan /licence-inputs/vmafx-sources.json \
        --python-version none --receipt /out/licence-check.json

# ---------------------------------------------------------------------------
# rocm10-source-export: the corresponding source of the image's copyleft parts,
# published as ghcr.io/vmafx/vmafx:<tag>-rocm10-source (ADR-1503 rule 5)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS rocm10-source-fetch
# Only /sources leaves this stage, so its package lists need no cleanup. git fetches the
# TheRock tree by its commit (licensing.json source_archives).
# hadolint ignore=DL3008,DL3009
RUN --mount=type=bind,from=rocm10-with-notices,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends git \
    && python3 /repo/tools/rc1-tester/image/licensing.py sources --artifact production-rocm-image \
        --root /rootfs --repo /repo --out /sources.list \
    && python3 /repo/tools/rc1-tester/image/licensing.py fetch-sources --list /sources.list \
        --out /sources

FROM scratch AS rocm10-source-export
COPY --from=rocm10-source-fetch /sources /sources

# ---------------------------------------------------------------------------
# final-rocm10: the published image
# ---------------------------------------------------------------------------
FROM rocm10-with-notices AS final-rocm10
COPY --from=rocm10-licence-check /out/licence-check.json /usr/local/share/vmafx/licence-check.json
# Drop privileges. ROCm needs the host's `render` and `video` groups, passed by
# numeric ID with --group-add (docs/development/docker-production.md).
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/vmaf"]

# ===========================================================================
# Intel GPU image: ghcr.io/vmafx/vmafx:<tag>-oneapi2026 (ADR-1368, ADR-1517)
# Debian 13, the Intel SYCL runtime files of sycl-runtime.json in
# /usr/local/lib/intel, and the Intel GPU user-mode stack of the pinned
# compute-runtime release (scripts/ci/install-intel-ocloc.sh): the Level Zero
# GPU driver, IGC, gmmlib and the Level Zero loader at the build-config.env
# pins. The installer's offline compiler and OpenCL parts are purged again:
# SPIR-V reaches the GPU through Level Zero and IGC alone, as in the Intel GPU
# tester image. The GPU driver is load-bearing: with the 25.18 one that Intel's
# oneapi-runtime:2025.3.1 image carried, every SYCL run segfaulted on an Arc
# B580. ca-certificates and python3 serve only the installer and leave with it.
# ===========================================================================
FROM ${ONEAPI_RUNTIME} AS oneapi2026-assembled
ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
LABEL org.opencontainers.image.title="vmafx"
LABEL org.opencontainers.image.description="VMAFX production oneAPI 2026.1 SYCL runtime with the Intel compute-runtime GPU stack. Licences: /usr/local/share/vmafx/licenses/THIRD_PARTY_NOTICES.txt"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"
LABEL org.opencontainers.image.licenses="EUPL-1.2 AND BSD-2-Clause-Patent AND BSD-3-Clause AND BSD-2-Clause AND ISC AND MIT AND Unlicense AND LicenseRef-LIVE-BRISQUE"
LABEL org.opencontainers.image.vendor="Lusoris"
COPY build-config.env /tmp/vmafx/build-config.env
COPY scripts/ci/install-intel-ocloc.sh /tmp/vmafx/scripts/ci/install-intel-ocloc.sh
COPY dev/scripts/fetch-intel-neo.py /tmp/vmafx/dev/scripts/fetch-intel-neo.py
# The installer runs in /tmp/vmafx: its `ocloc query` writes a file into the
# working directory.
# hadolint ignore=DL3003,DL3008
RUN --mount=type=secret,id=github_token,env=GITHUB_TOKEN,required=false \
    apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates python3 \
    && cd /tmp/vmafx \
    && bash /tmp/vmafx/scripts/ci/install-intel-ocloc.sh --components runtime /tmp/vmafx \
    && dpkg --purge intel-ocloc intel-opencl-icd intel-igc-opencl-2 ocl-icd-libopencl1 \
    && apt-get purge -y --auto-remove ca-certificates python3 \
    && apt-get clean \
    && cd / \
    && rm -rf /tmp/vmafx /var/lib/apt/lists/*
# Under WSL2 the GPU arrives as /dev/dxg with the host driver's libraries in
# /usr/lib/wsl/lib (a bind mount); the path is empty on a Linux host.
ENV LD_LIBRARY_PATH="/usr/local/lib:/usr/local/lib/intel:/usr/lib/wsl/lib" \
    VMAF_MODEL_PATH="/usr/local/share/vmafx/model"
COPY --from=builder-oneapi2026 /dist/lib/   /usr/local/lib/
COPY --from=builder-oneapi2026 /dist/bin/   /usr/local/bin/
COPY --from=builder-oneapi2026 /dist/model/ /usr/local/share/vmafx/model/
COPY --from=builder-oneapi2026 /stage/lib/intel/ /usr/local/lib/intel/
COPY --from=builder-oneapi2026 /stage/licenses/ /usr/local/share/vmafx/licenses/

# ---------------------------------------------------------------------------
# oneapi2026-licence-texts: the recorded licence texts that are not in the
# repository, pinned by URL and SHA-256 in licensing.json (fetched_texts)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS oneapi2026-licence-texts
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/licensing \
    python3 /licensing/licensing.py fetch-texts --artifact production-oneapi-image --python-version none \
        --out /texts

# ---------------------------------------------------------------------------
# oneapi2026-notices: the runtime has no interpreter, so its notices and licence
# texts are written on a copy of its tree (ADR-1503 rule 4)
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS oneapi2026-notices
COPY --from=oneapi2026-assembled / /rootfs
ARG VMAFX_SOURCE_COMMIT=unknown
ARG VMAFX_IMAGE_TAG=unknown
RUN --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=builder-oneapi2026,source=/licence-inputs,target=/licence-inputs \
    --mount=type=bind,from=oneapi2026-licence-texts,source=/texts,target=/texts \
    python3 /repo/tools/rc1-tester/image/licensing.py notices --artifact production-oneapi-image \
        --root /rootfs --repo /repo --build-scan /licence-inputs/vmafx-sources.json \
        --texts /texts --source-commit "${VMAFX_SOURCE_COMMIT}" --tag "${VMAFX_IMAGE_TAG}"

FROM oneapi2026-assembled AS oneapi2026-with-notices
COPY --from=oneapi2026-notices /rootfs/usr/local/share/vmafx/licenses /usr/local/share/vmafx/licenses
# The licence texts fetched for the GPU stack are those of the installed
# versions. The Unified Runtime adapters SYCL dlopen()s at device discovery need
# libumf.so.1, which libvmaf does not link: without it every adapter fails to
# load and SYCL reports no device while `vmaf --version` still passes, so the
# build fails on any unresolved adapter dependency.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN test -f "/usr/local/share/vmafx/licenses/texts/level-zero-$(dpkg-query -W -f='${Version}' libze1)-LICENSE.txt" \
    && test -f "/usr/local/share/vmafx/licenses/texts/igc-$(dpkg-query -W -f='${Version}' intel-igc-core-2)-LICENSE.md" \
    && for adapter in /usr/local/lib/intel/libur_adapter_*.so.0; do \
        if ldd "${adapter}" | grep 'not found'; then \
            echo "unresolved dependency in ${adapter}" >&2; exit 1; \
        fi; \
    done \
    && for binary in /usr/local/bin/vmaf /usr/local/lib/libvmaf.so.* /usr/local/lib/libvmafx.so.*; do \
        if ldd "${binary}" | grep 'not found'; then \
            echo "unresolved dependency in ${binary}" >&2; exit 1; \
        fi; \
    done \
    && /usr/local/bin/vmaf --version

# ---------------------------------------------------------------------------
# oneapi2026-licence-check: every file of the image has a recorded licence
# (ADR-1503 rule 3); final-oneapi2026 copies its receipt, so it cannot be built
# without passing it
# ---------------------------------------------------------------------------
FROM ${RELEASE_PYTHON_BASE} AS oneapi2026-licence-check
RUN --mount=type=bind,from=oneapi2026-with-notices,target=/rootfs \
    --mount=type=bind,source=tools/rc1-tester/image,target=/repo/tools/rc1-tester/image \
    --mount=type=bind,source=REUSE.toml,target=/repo/REUSE.toml \
    --mount=type=bind,source=NOTICE,target=/repo/NOTICE \
    --mount=type=bind,source=LICENSES,target=/repo/LICENSES \
    --mount=type=bind,source=model/other_models/NOTICE-brisque,target=/repo/model/other_models/NOTICE-brisque \
    --mount=type=bind,from=builder-oneapi2026,source=/licence-inputs,target=/licence-inputs \
    mkdir /out \
    && python3 /repo/tools/rc1-tester/image/licensing.py check --artifact production-oneapi-image \
        --root /rootfs --repo /repo --build-scan /licence-inputs/vmafx-sources.json \
        --python-version none --receipt /out/licence-check.json

