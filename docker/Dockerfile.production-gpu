# docker/Dockerfile.production-gpu — VMAFX production GPU-augmented runtime image
#
# Targets use matching, digest-pinned build/runtime families:
#   final-cpu        — Debian 13 builder + distroless Debian 13 runtime
#   final-cuda13     — Ubuntu 26.04 + explicit pinned CUDA builder/runtime packages
#   final-rocm10      — AMD ROCm 10.0.0 dev/application image
#   final-oneapi2026 — Debian 13 + Intel oneAPI 2026.1 apt compiler/runtime
#                      + compute-runtime (NEO) GPU stack (ADR-1368)
#   final-oneapi2025 — alias of final-oneapi2026, kept for existing callers
#
# Tag matrix (built by CI):
#   ghcr.io/vmafx/vmafx:<tag>          (cpu default, same as Dockerfile.production)
#   ghcr.io/vmafx/vmafx:<tag>-cuda13
#   ghcr.io/vmafx/vmafx:<tag>-rocm10
#   ghcr.io/vmafx/vmafx:<tag>-oneapi2026  (also tagged -oneapi2025, ADR-1368)
#
# ADR-0698: vmafx-production-dockerfile
# ADR-1129: release-container-runtime-alignment
# ADR-1368: oneapi-release-image-debian13

# Ubuntu 24.04's Meson 1.3.2 is below the source tree's >=1.4.0 floor.
# Fetch one immutable, checksum-verified wheel and install it in each vendor
# builder rather than floating on PyPI or duplicating unverified downloads.
# Base images come from build-config.env -- the single source of truth for
# every container base in this repository. These defaults are mirrors kept in
# sync by scripts/ci/check-base-image-single-source.sh; edit the config, not
# these lines, then run `make base-images-sync`.
ARG RELEASE_BUILDER_BASE="debian:13-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a"
ARG RELEASE_RUNTIME_CC="gcr.io/distroless/cc-debian13:nonroot@sha256:54df941ed0d06a1bd95ef5e0ce391fd8d9f94b64782dc9a60062727849ee3f97"
ARG CUDA_BUILDER="ubuntu:26.04@sha256:da6fc2be547864451aa253836dd926da33623312df4a9a243e35dc877c378a78"
ARG CUDA_RUNTIME="ubuntu:26.04@sha256:da6fc2be547864451aa253836dd926da33623312df4a9a243e35dc877c378a78"
ARG ROCM_BUILDER="rocm/dev-ubuntu-26.04:10.0.0-full@sha256:8ebc02ee1aefb6b7c0e952b4088542133bad8805d19730db92cc61be673421d1"
ARG ROCM_RUNTIME="rocm/dev-ubuntu-26.04:10.0.0-full@sha256:8ebc02ee1aefb6b7c0e952b4088542133bad8805d19730db92cc61be673421d1"
ARG ONEAPI_BUILDER="debian:13-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a"
ARG ONEAPI_RUNTIME="debian:13-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a"

FROM scratch AS meson-wheel
ADD --checksum=sha256:71f133147fa0fcfe8f4df49fa1045771064947834538409e5d97b3613aac8b4e \
    https://files.pythonhosted.org/packages/07/68/b0117422eb0a46d9d8d9e328f0c5b5c835179bfc058688bca35c90c89eba/meson-1.12.0-py3-none-any.whl \
    /meson-1.12.0-py3-none-any.whl

# ---------------------------------------------------------------------------
# Stage 1 — CPU builder plus one vendor-native builder per GPU backend
# ---------------------------------------------------------------------------
# CPU builder and runtime share the Debian 13 ABI floor. The CUDA and ROCm
# builders below use their vendors' distro arrangements; the oneAPI builder is
# Debian 13 plus Intel's apt packages (ADR-1368).
FROM ${RELEASE_BUILDER_BASE} AS builder-base

ARG DEBIAN_FRONTEND=noninteractive
ARG VMAF_BUILD_JOBS=4

# BuildKit cache mounts on the apt caches preserve the .deb downloads and
# index files across builds; subsequent rebuilds skip the network fetch.
# `sharing=locked` serialises concurrent BuildKit jobs against the same cache.
# hadolint ignore=DL3008,DL3009
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        ccache \
        gcc \
        g++ \
        meson \
        ninja-build \
        nasm \
        pkg-config \
        ca-certificates \
        xxd

WORKDIR /src
COPY . .

# --- cpu build (default, no GPU SDK needed) ---
FROM builder-base AS builder-cpu

# ccache cache mount accelerates incremental rebuilds across the per-variant
# builder stages; each variant gets its own cache scope via the target path.
RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked,id=ccache-cpu \
    CCACHE_DIR=/root/.cache/ccache \
    meson setup /build core \
        --buildtype=release \
        --strip \
        -Denable_cuda=false \
        -Denable_sycl=false \
        -Denable_dnn=disabled \
        -Denable_avx512=true \
    && ninja -C /build -j"${VMAF_BUILD_JOBS}" \
    && mkdir -p /dist/lib /dist/bin /dist/model \
    && find /build/src -maxdepth 1 -name 'libvmaf.so*' -not -type d -exec cp {} /dist/lib/ \; \
    && cp /build/tools/vmaf /dist/bin/ \
    && cp -r model/. /dist/model/

# --- CUDA 13.4.2 build (ADR-1306) ---
FROM ${CUDA_BUILDER} AS builder-cuda13

ARG DEBIAN_FRONTEND=noninteractive
ARG VMAF_BUILD_JOBS=4
ARG NV_CODEC_HEADERS_COMMIT=876af32a202d0de83bd1d36fe74ee0f7fcf86b0d
ARG MESON_VERSION=1.12.0

COPY build-config.env scripts/ci/install-cuda-toolkit.sh /tmp/
# hadolint ignore=DL3008,DL3009
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    /tmp/install-cuda-toolkit.sh --mode=builder /tmp \
    && rm -f /tmp/install-cuda-toolkit.sh /tmp/build-config.env

ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64

# hadolint ignore=DL3008,DL3009
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ccache \
        gcc \
        g++ \
        git \
        make \
        nasm \
        ninja-build \
        pkg-config \
        python3-pip \
        xxd

RUN --mount=type=bind,from=meson-wheel,source=/meson-1.12.0-py3-none-any.whl,target=/tmp/meson-1.12.0-py3-none-any.whl \
    python3 -m pip install --break-system-packages --no-cache-dir --no-deps \
        /tmp/meson-1.12.0-py3-none-any.whl \
    && test "$(meson --version)" = "${MESON_VERSION}"

# libvmaf's CUDA loader requires symbols newer than Ubuntu 24.04's packaged
# headers. Install the exact minimum compatible upstream commit named by the
# Meson configure check instead of floating on the distro snapshot.
RUN git init /tmp/nv-codec-headers \
    && git -C /tmp/nv-codec-headers remote add origin \
        https://code.ffmpeg.org/FFmpeg/nv-codec-headers.git \
    && git -C /tmp/nv-codec-headers fetch --depth=1 origin "${NV_CODEC_HEADERS_COMMIT}" \
    && git -C /tmp/nv-codec-headers checkout --detach FETCH_HEAD \
    && test "$(git -C /tmp/nv-codec-headers rev-parse HEAD)" = "${NV_CODEC_HEADERS_COMMIT}" \
    && make -C /tmp/nv-codec-headers install \
    && rm -rf /tmp/nv-codec-headers

WORKDIR /src
COPY . .

# Keep the vendor compiler's accepted C23 spelling `c2x` instead of inheriting
# the project's equivalent `c23` default.
# GPU custom targets also use source-relative include paths, so their build
# directories stay under `/src/core` instead of an external `/build`.
RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked,id=ccache-cuda13 \
    CCACHE_DIR=/root/.cache/ccache \
    meson setup /src/core/build core \
        --buildtype=release \
        --strip \
        -Denable_cuda=true \
        -Denable_nvcc=true \
        -Denable_sycl=false \
        -Denable_dnn=disabled \
        -Dc_std=c2x \
        -Dcpp_std=c++23 \
        -Denable_avx512=true \
    && ninja -C /src/core/build -j"${VMAF_BUILD_JOBS}" \
    && mkdir -p /dist/lib /dist/bin /dist/model \
    && find /src/core/build/src -maxdepth 1 -name 'libvmaf.so*' -not -type d -exec cp {} /dist/lib/ \; \
    && cp /src/core/build/tools/vmaf /dist/bin/ \
    && cp -r model/. /dist/model/

# --- ROCm 10.0.0 build (ADR-1225) ---
# ROCm 10.0.0 ships only as a container image: since ROCm 7.14 AMD builds and
# releases through "TheRock", and the legacy apt channel at
# repo.radeon.com/rocm/apt/ tops out at 7.2.4 (its own `latest` resolves there).
# Note the image reports HIP 7.15.26333 and installs under /opt/rocm/core-10.0,
# with /opt/rocm/lib a Debian-alternatives symlink onto it -- so
# LD_LIBRARY_PATH=/opt/rocm/lib keeps working unchanged.
FROM ${ROCM_BUILDER} AS builder-rocm10

ARG DEBIAN_FRONTEND=noninteractive
ARG VMAF_BUILD_JOBS=4
ARG MESON_VERSION=1.12.0

# hadolint ignore=DL3008,DL3009
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ccache \
        gcc \
        g++ \
        nasm \
        ninja-build \
        pkg-config \
        python3-pip \
        xxd

RUN --mount=type=bind,from=meson-wheel,source=/meson-1.12.0-py3-none-any.whl,target=/tmp/meson-1.12.0-py3-none-any.whl \
    python3 -m pip install --break-system-packages --no-cache-dir --no-deps \
        /tmp/meson-1.12.0-py3-none-any.whl \
    && test "$(meson --version)" = "${MESON_VERSION}"

WORKDIR /src
COPY . .

RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked,id=ccache-rocm10 \
    CCACHE_DIR=/root/.cache/ccache \
    meson setup /src/core/build core \
        --buildtype=release \
        --strip \
        -Denable_cuda=false \
        -Denable_hip=true \
        -Denable_hipcc=true \
        -Denable_sycl=false \
        -Denable_dnn=disabled \
        -Db_lto=false \
        -Dc_std=c2x \
        -Dcpp_std=c++23 \
        -Denable_avx512=true \
    && ninja -C /src/core/build -j"${VMAF_BUILD_JOBS}" \
    && mkdir -p /dist/lib /dist/bin /dist/model \
    && find /src/core/build/src -maxdepth 1 -name 'libvmaf.so*' -not -type d -exec cp {} /dist/lib/ \; \
    && cp /src/core/build/tools/vmaf /dist/bin/ \
    && cp -r model/. /dist/model/

# --- oneAPI 2026.1 build (ADR-1368) ---
# The release track's Debian 13 plus Intel's oneAPI compiler from its apt
# repository at the exact build build-config.env pins. The final stage installs
# the runtime of that same build, so both sides agree on libsycl.so.9 and on
# Debian 13's glibc; Intel's own images could not supply that pair.
FROM ${ONEAPI_BUILDER} AS builder-oneapi2026

ARG DEBIAN_FRONTEND=noninteractive
ARG VMAF_BUILD_JOBS=4
ARG MESON_VERSION=1.12.0

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# hadolint ignore=DL3008,DL3009
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ccache \
        curl \
        gcc \
        g++ \
        gpg \
        nasm \
        ninja-build \
        pkg-config \
        python3-pip \
        xxd \
        zstd

RUN --mount=type=bind,from=meson-wheel,source=/meson-1.12.0-py3-none-any.whl,target=/tmp/meson-1.12.0-py3-none-any.whl \
    python3 -m pip install --break-system-packages --no-cache-dir --no-deps \
        /tmp/meson-1.12.0-py3-none-any.whl \
    && test "$(meson --version)" = "${MESON_VERSION}"

# icpx from Intel's apt repository (scripts/ci/install-intel-oneapi.sh), then
# the build set of the pinned Intel GPU stack (scripts/ci/install-intel-ocloc.sh):
# ocloc, which compiles the SYCL ahead-of-time images (sycl_icpx_aot_targets,
# ADR-1360) and which the Linux compiler does not ship, and the Level Zero
# loader libvmaf links (libze1 + libze-dev at LEVEL_ZERO_VERSION). zstd above
# lets the build-time AOT image check read the compressed images under Debian
# 13's Python 3.13. The optional `github_token` secret lifts the anonymous
# GitHub API limit for the NEO and Level Zero release lookups.
COPY build-config.env /tmp/vmafx/build-config.env
COPY scripts/ci/install-intel-oneapi.sh scripts/ci/install-intel-ocloc.sh /tmp/vmafx/scripts/ci/
COPY dev/scripts/fetch-intel-neo.py /tmp/vmafx/dev/scripts/fetch-intel-neo.py
# hadolint ignore=DL3008
RUN --mount=type=secret,id=github_token,env=GITHUB_TOKEN,required=false \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    bash /tmp/vmafx/scripts/ci/install-intel-oneapi.sh --mode=builder /tmp/vmafx \
    && bash /tmp/vmafx/scripts/ci/install-intel-ocloc.sh --components build /tmp/vmafx \
    && rm -rf /tmp/vmafx

ENV ONEAPI_ROOT=/opt/intel/oneapi
ENV PATH="${ONEAPI_ROOT}/compiler/latest/bin:${PATH}"

WORKDIR /src
COPY . .

RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked,id=ccache-oneapi2026 \
    CCACHE_DIR=/root/.cache/ccache \
    CC=icx CXX=icpx meson setup /src/core/build core \
        --buildtype=release \
        --strip \
        -Denable_cuda=false \
        -Denable_sycl=true \
        -Denable_dnn=disabled \
        -Db_lto=false \
        -Dc_std=c2x \
        -Denable_avx512=true \
    && ninja -C /src/core/build -j"${VMAF_BUILD_JOBS}" \
    && mkdir -p /dist/lib /dist/bin /dist/model \
    && find /src/core/build/src -maxdepth 1 -name 'libvmaf.so*' -not -type d -exec cp {} /dist/lib/ \; \
    && cp /src/core/build/tools/vmaf /dist/bin/ \
    && cp -r model/. /dist/model/

# (ADR-0726: Vulkan backend removed; builder-vulkan stage deleted)

# ---------------------------------------------------------------------------
# CPU runtime base — distroless Debian 13
# ---------------------------------------------------------------------------
FROM ${RELEASE_RUNTIME_CC} AS runtime-base

LABEL org.opencontainers.image.title="vmafx"
LABEL org.opencontainers.image.description="VMAFX production GPU runtime"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"
LABEL org.opencontainers.image.licenses="BSD-2-Clause-Patent"
LABEL org.opencontainers.image.vendor="Lusoris"

ENV LD_LIBRARY_PATH="/usr/local/lib"
ENV VMAF_MODEL_PATH="/usr/local/share/vmafx/model"

# ---------------------------------------------------------------------------
# Final targets — one per GPU variant
# The CI workflow builds the appropriate target based on the tag suffix.
# ---------------------------------------------------------------------------

FROM runtime-base AS final-cpu
COPY --from=builder-cpu /dist/lib/   /usr/local/lib/
COPY --from=builder-cpu /dist/bin/   /usr/local/bin/
COPY --from=builder-cpu /dist/model/ /usr/local/share/vmafx/model/
# Drop privileges — distroless `nonroot` user (UID:GID 65532). Trivy DS-0002.
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/vmaf"]

FROM ${CUDA_RUNTIME} AS final-cuda13
LABEL org.opencontainers.image.title="vmafx"
LABEL org.opencontainers.image.description="VMAFX production CUDA 13.4.2 runtime"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"
LABEL org.opencontainers.image.licenses="BSD-2-Clause-Patent"
LABEL org.opencontainers.image.vendor="Lusoris"
COPY build-config.env scripts/ci/install-cuda-toolkit.sh /tmp/
RUN /tmp/install-cuda-toolkit.sh --mode=runtime /tmp \
    && rm -rf /tmp/install-cuda-toolkit.sh /tmp/build-config.env /var/lib/apt/lists/*
ENV CUDA_HOME=/usr/local/cuda
ENV PATH="${CUDA_HOME}/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/lib:/usr/local/cuda/lib64:/usr/local/nvidia/lib:/usr/local/nvidia/lib64"
ENV VMAF_MODEL_PATH="/usr/local/share/vmafx/model"
COPY --from=builder-cuda13 /dist/lib/   /usr/local/lib/
COPY --from=builder-cuda13 /dist/bin/   /usr/local/bin/
COPY --from=builder-cuda13 /dist/model/ /usr/local/share/vmafx/model/
# Drop privileges. CUDA device access (/dev/nvidia*) is granted via the
# NVIDIA Container Toolkit — `nonroot` UID 65532 still gets device access
# when the runtime injects /dev nodes with mode 0666.
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/vmaf"]

FROM ${ROCM_RUNTIME} AS final-rocm10
LABEL org.opencontainers.image.title="vmafx"
LABEL org.opencontainers.image.description="VMAFX production ROCm 10.0.0 runtime"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"
LABEL org.opencontainers.image.licenses="BSD-2-Clause-Patent"
LABEL org.opencontainers.image.vendor="Lusoris"
ENV LD_LIBRARY_PATH="/usr/local/lib:/opt/rocm/lib:/opt/rocm/lib64"
ENV VMAF_MODEL_PATH="/usr/local/share/vmafx/model"
COPY --from=builder-rocm10 /dist/lib/   /usr/local/lib/
COPY --from=builder-rocm10 /dist/bin/   /usr/local/bin/
COPY --from=builder-rocm10 /dist/model/ /usr/local/share/vmafx/model/
# Drop privileges. ROCm requires the host user to be a member of the
# `render` and `video` groups; the runtime image inherits this from the
# host group-mapping when `--group-add video,render` is passed.
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/vmaf"]

# oneAPI 2026.1 runtime (ADR-1368): Debian 13 with the pinned inputs from
# build-config.env. Intel's SYCL runtime and UMF come at the compiler's exact apt
# build (scripts/ci/install-intel-oneapi.sh). The runtime set of the Intel GPU
# stack (scripts/ci/install-intel-ocloc.sh) adds the compute-runtime (NEO) Level
# Zero GPU driver, OpenCL ICD, gmmlib and IGC at INTEL_NEO_VERSION -- the package
# set dev/Containerfile installs -- and the Level Zero loader at
# LEVEL_ZERO_VERSION. The GPU driver is load-bearing: with the 25.18 one that
# Intel's oneapi-runtime:2025.3.1 image carried, every SYCL run segfaulted on an
# Arc B580. curl, gpg and python3 serve only the installers and leave with them.
FROM ${ONEAPI_RUNTIME} AS final-oneapi2026
ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
LABEL org.opencontainers.image.title="vmafx"
LABEL org.opencontainers.image.description="VMAFX production oneAPI 2026.1 SYCL runtime with the Intel compute-runtime GPU stack"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"
LABEL org.opencontainers.image.licenses="BSD-2-Clause-Patent"
LABEL org.opencontainers.image.vendor="Lusoris"
COPY build-config.env /tmp/vmafx/build-config.env
COPY scripts/ci/install-intel-oneapi.sh scripts/ci/install-intel-ocloc.sh /tmp/vmafx/scripts/ci/
COPY dev/scripts/fetch-intel-neo.py /tmp/vmafx/dev/scripts/fetch-intel-neo.py
# hadolint ignore=DL3008
RUN --mount=type=secret,id=github_token,env=GITHUB_TOKEN,required=false \
    apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gpg python3 \
    && bash /tmp/vmafx/scripts/ci/install-intel-oneapi.sh --mode=runtime /tmp/vmafx \
    && bash /tmp/vmafx/scripts/ci/install-intel-ocloc.sh --components runtime /tmp/vmafx \
    && apt-get purge -y --auto-remove curl gpg python3 \
    && apt-get clean \
    && rm -rf /tmp/vmafx /var/lib/apt/lists/*
# The Unified Runtime adapters SYCL dlopen()s at device discovery need
# libumf.so.1, which the SYCL runtime package does not depend on (hence UMF in
# ONEAPI_RUNTIME_APT_PACKAGES). Without it every adapter fails to load and SYCL
# reports no device while `vmaf --version` still passes, so the stage fails the
# build on any unresolved adapter dependency.
ENV LD_LIBRARY_PATH="/usr/local/lib:/opt/intel/oneapi/redist/lib:/opt/intel/oneapi/umf/latest/lib"
RUN for adapter in /opt/intel/oneapi/redist/lib/libur_adapter_*.so.0; do \
        if ldd "${adapter}" | grep 'not found'; then \
            echo "unresolved dependency in ${adapter}" >&2; exit 1; \
        fi; \
    done
ENV VMAF_MODEL_PATH="/usr/local/share/vmafx/model"
COPY --from=builder-oneapi2026 /dist/lib/   /usr/local/lib/
COPY --from=builder-oneapi2026 /dist/bin/   /usr/local/bin/
COPY --from=builder-oneapi2026 /dist/model/ /usr/local/share/vmafx/model/
# libvmaf links libsycl, the Level Zero loader and Intel's math runtime; fail
# the build, not the first run, if the runtime above does not provide them.
RUN if ldd /usr/local/bin/vmaf | grep 'not found'; then exit 1; fi \
    && /usr/local/bin/vmaf --version
# Drop privileges. Intel GPU access via /dev/dri/renderD* — group `render`
# (GID 110/993 on Debian) needs to be passed via `--group-add` on `docker run`.
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/vmaf"]

# HISS-14: `final-oneapi2025` and the `-oneapi2025` tag suffix predate the move
# to oneAPI 2026.1. Both stay working as aliases of the accurate name until a
# breaking release retires them (ADR-1368).
FROM final-oneapi2026 AS final-oneapi2025

# (ADR-0726: final-vulkan stage removed)
