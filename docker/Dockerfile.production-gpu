# docker/Dockerfile.production-gpu — VMAFX production GPU-augmented runtime image
#
# Targets use matching, digest-pinned build/runtime families:
#   final-cpu        — Debian 13 builder + distroless Debian 13 runtime
#   final-cuda13     — NVIDIA CUDA 13.3.1 devel + runtime images
#   final-rocm7      — AMD ROCm 7.2.4 dev/application image
#   final-oneapi2026 — Intel oneAPI 2026.1 (apt) on Debian 13 + NEO driver
#
# Tag matrix (built by CI):
#   ghcr.io/vmafx/vmafx:<tag>          (cpu default, same as Dockerfile.production)
#   ghcr.io/vmafx/vmafx:<tag>-cuda13
#   ghcr.io/vmafx/vmafx:<tag>-rocm7
#   ghcr.io/vmafx/vmafx:<tag>-oneapi2026
#
# ADR-0698: vmafx-production-dockerfile
# ADR-1129: release-container-runtime-alignment

# Ubuntu 24.04's Meson 1.3.2 is below the source tree's >=1.4.0 floor.
# Fetch one immutable, checksum-verified wheel and install it in each vendor
# builder rather than floating on PyPI or duplicating unverified downloads.
# Base images come from build-config.env -- the single source of truth for
# every container base in this repository. These defaults are mirrors kept in
# sync by scripts/ci/check-base-image-single-source.sh; edit the config, not
# these lines, then run that script with --write.
ARG RELEASE_BUILDER_BASE="debian:13-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132"
ARG CUDA_BUILDER="nvidia/cuda:13.3.1-devel-ubuntu26.04@sha256:8cf42b8dc4c34d47fb42ffb0923f8a5e363469a7149181c094da336d311bb466"
ARG ROCM_BUILDER="rocm/dev-ubuntu-24.04:7.2.4@sha256:bdc8e61026cbb844ede93d44d2c50055f51ebb2041906b60182bf3bee3139054"
ARG RELEASE_RUNTIME_CC="gcr.io/distroless/cc-debian13:nonroot@sha256:c31ff9abcb1910f3ab25c7957bdaf0bfe12a01eb546e8df2282f1c8f682b606c"
ARG CUDA_RUNTIME="nvidia/cuda:13.3.1-runtime-ubuntu26.04@sha256:71b55b93449973f2ee6d8024d6dd34853d338a1f007fe07adaaf9a35fd591794"
ARG ROCM_RUNTIME="rocm/dev-ubuntu-24.04:7.2.4@sha256:bdc8e61026cbb844ede93d44d2c50055f51ebb2041906b60182bf3bee3139054"
ARG ONEAPI_VERSION="2026.1.1-325"
ARG ONEAPI_APT_REPO="https://apt.repos.intel.com/oneapi"
ARG ONEAPI_APT_GPG_URL="https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB"
ARG INTEL_NEO_VERSION="26.31.39395.13"

FROM scratch AS meson-wheel
ADD --checksum=sha256:71f133147fa0fcfe8f4df49fa1045771064947834538409e5d97b3613aac8b4e \
    https://files.pythonhosted.org/packages/07/68/b0117422eb0a46d9d8d9e328f0c5b5c835179bfc058688bca35c90c89eba/meson-1.12.0-py3-none-any.whl \
    /meson-1.12.0-py3-none-any.whl

# ---------------------------------------------------------------------------
# Stage 1 — CPU builder plus one vendor-native builder per GPU backend
# ---------------------------------------------------------------------------
# CPU builder and runtime share the Debian 13 ABI floor. GPU builders below use
# their vendors' official devel images instead of apt-installing from repos that
# are absent from a plain Debian base.
FROM ${RELEASE_BUILDER_BASE} AS builder-base

ARG DEBIAN_FRONTEND=noninteractive
ARG VMAF_BUILD_JOBS=4

# BuildKit cache mounts on the apt caches preserve the .deb downloads and
# index files across builds; subsequent rebuilds skip the network fetch.
# `sharing=locked` serialises concurrent BuildKit jobs against the same cache.
# hadolint ignore=DL3008,DL3009
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        ccache \
        gcc \
        g++ \
        meson \
        ninja-build \
        nasm \
        pkg-config \
        ca-certificates

WORKDIR /src
COPY . .

# --- cpu build (default, no GPU SDK needed) ---
FROM builder-base AS builder-cpu

# ccache cache mount accelerates incremental rebuilds across the per-variant
# builder stages; each variant gets its own cache scope via the target path.
RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked,id=ccache-cpu \
    CCACHE_DIR=/root/.cache/ccache \
    meson setup /build core \
        --buildtype=release \
        --strip \
        -Denable_cuda=false \
        -Denable_sycl=false \
        -Denable_dnn=disabled \
        -Denable_avx512=true \
    && ninja -C /build -j"${VMAF_BUILD_JOBS}" \
    && mkdir -p /dist/lib /dist/bin /dist/model \
    && find /build/src -maxdepth 1 -name 'libvmaf.so*' -not -type d -exec cp {} /dist/lib/ \; \
    && cp /build/tools/vmaf /dist/bin/ \
    && cp -r model/. /dist/model/

# --- CUDA 13.3.1 build ---
FROM ${CUDA_BUILDER} AS builder-cuda13

ARG DEBIAN_FRONTEND=noninteractive
ARG VMAF_BUILD_JOBS=4
ARG NV_CODEC_HEADERS_COMMIT=876af32a202d0de83bd1d36fe74ee0f7fcf86b0d
ARG MESON_VERSION=1.12.0

# hadolint ignore=DL3008,DL3009
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ccache \
        gcc \
        g++ \
        git \
        make \
        nasm \
        ninja-build \
        pkg-config \
        python3-pip

RUN --mount=type=bind,from=meson-wheel,source=/meson-1.12.0-py3-none-any.whl,\
target=/tmp/meson-1.12.0-py3-none-any.whl \
    python3 -m pip install --break-system-packages --no-cache-dir --no-deps \
        /tmp/meson-1.12.0-py3-none-any.whl \
    && test "$(meson --version)" = "${MESON_VERSION}"

# libvmaf's CUDA loader requires symbols newer than Ubuntu 24.04's packaged
# headers. Install the exact minimum compatible upstream commit named by the
# Meson configure check instead of floating on the distro snapshot.
RUN git init /tmp/nv-codec-headers \
    && git -C /tmp/nv-codec-headers remote add origin \
        https://code.ffmpeg.org/FFmpeg/nv-codec-headers.git \
    && git -C /tmp/nv-codec-headers fetch --depth=1 origin "${NV_CODEC_HEADERS_COMMIT}" \
    && git -C /tmp/nv-codec-headers checkout --detach FETCH_HEAD \
    && test "$(git -C /tmp/nv-codec-headers rev-parse HEAD)" = "${NV_CODEC_HEADERS_COMMIT}" \
    && make -C /tmp/nv-codec-headers install \
    && rm -rf /tmp/nv-codec-headers

WORKDIR /src
COPY . .

# Keep the vendor compiler's accepted C23 spelling `c2x` instead of inheriting
# the project's equivalent `c23` default.
# GPU custom targets also use source-relative include paths, so their build
# directories stay under `/src/core` instead of an external `/build`.
RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked,id=ccache-cuda13 \
    CCACHE_DIR=/root/.cache/ccache \
    meson setup /src/core/build core \
        --buildtype=release \
        --strip \
        -Denable_cuda=true \
        -Denable_nvcc=true \
        -Denable_sycl=false \
        -Denable_dnn=disabled \
        -Dc_std=c2x \
        -Dcpp_std=c++23 \
        -Denable_avx512=true \
    && ninja -C /src/core/build -j"${VMAF_BUILD_JOBS}" \
    && mkdir -p /dist/lib /dist/bin /dist/model \
    && find /src/core/build/src -maxdepth 1 -name 'libvmaf.so*' -not -type d -exec cp {} /dist/lib/ \; \
    && cp /src/core/build/tools/vmaf /dist/bin/ \
    && cp -r model/. /dist/model/

# --- ROCm 7.2.4 build ---
FROM ${ROCM_BUILDER} AS builder-rocm7

ARG DEBIAN_FRONTEND=noninteractive
ARG VMAF_BUILD_JOBS=4
ARG MESON_VERSION=1.12.0

# hadolint ignore=DL3008,DL3009
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ccache \
        gcc \
        g++ \
        nasm \
        ninja-build \
        pkg-config \
        python3-pip \
        xxd

RUN --mount=type=bind,from=meson-wheel,source=/meson-1.12.0-py3-none-any.whl,\
target=/tmp/meson-1.12.0-py3-none-any.whl \
    python3 -m pip install --break-system-packages --no-cache-dir --no-deps \
        /tmp/meson-1.12.0-py3-none-any.whl \
    && test "$(meson --version)" = "${MESON_VERSION}"

WORKDIR /src
COPY . .

RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked,id=ccache-rocm7 \
    CCACHE_DIR=/root/.cache/ccache \
    meson setup /src/core/build core \
        --buildtype=release \
        --strip \
        -Denable_cuda=false \
        -Denable_hip=true \
        -Denable_hipcc=true \
        -Denable_sycl=false \
        -Denable_dnn=disabled \
        -Db_lto=false \
        -Dc_std=c2x \
        -Dcpp_std=c++23 \
        -Denable_avx512=true \
    && ninja -C /src/core/build -j"${VMAF_BUILD_JOBS}" \
    && mkdir -p /dist/lib /dist/bin /dist/model \
    && find /src/core/build/src -maxdepth 1 -name 'libvmaf.so*' -not -type d -exec cp {} /dist/lib/ \; \
    && cp /src/core/build/tools/vmaf /dist/bin/ \
    && cp -r model/. /dist/model/

# --- oneAPI 2026.1 build ---
# Built on the same Debian 13 base as every other release stage, with the
# compiler installed from Intel's apt repo rather than from an Intel image.
# That is a hard requirement, not a preference: Intel publishes for Ubuntu only,
# Ubuntu 26.04 carries glibc 2.43 and Debian 13 carries 2.41, so a binary
# compiled inside Intel's image cannot load on the runtime stage below.
# Compiler and runtime are pinned to the SAME ONEAPI_VERSION because the SYCL
# soname moved (libsycl.so.8 -> .so.9 across the 2025/2026 boundary), which is a
# hard ABI break rather than the usual backward-compatible runtime >= compiler
# case. See build-config.env and docs/research/1231-base-image-single-source.md.
FROM builder-base AS builder-oneapi2026

ARG DEBIAN_FRONTEND=noninteractive
ARG VMAF_BUILD_JOBS=4
ARG ONEAPI_VERSION
ARG ONEAPI_APT_REPO
ARG ONEAPI_APT_GPG_URL

# hadolint ignore=DL3008,DL3009
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends curl gpg \
    && curl -fsSL "${ONEAPI_APT_GPG_URL}" | gpg --dearmor \
         > /usr/share/keyrings/intel-sw-products.gpg \
    && printf 'deb [signed-by=/usr/share/keyrings/intel-sw-products.gpg] %s all main\n' \
         "${ONEAPI_APT_REPO}" > /etc/apt/sources.list.d/intel-oneapi.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
         "intel-oneapi-compiler-dpcpp-cpp=${ONEAPI_VERSION}" \
         libze-dev libze1 \
         libva-dev libva-drm2

# `ze_loader` is a hard requirement of the SYCL backend (core/src/meson.build:
# common.cpp calls zeMemFree / get_native<ext_oneapi_level_zero>), and VA-API
# is what enables the zero-copy DMA-BUF import path. Intel's oneAPI apt repo
# ships neither, and Intel's basekit image -- which this stage replaced --
# carried ze_loader but NOT libva, so every published oneAPI image until now had
# HAVE_SYCL_DMABUF undefined and the zero-copy path compiled out to its stub.
# Assert both, so the capability cannot silently disappear again.
RUN pkg-config --exists libva libva-drm \
    && test -e /usr/lib/x86_64-linux-gnu/libze_loader.so

ENV ONEAPI_ROOT=/opt/intel/oneapi
ENV PATH="${ONEAPI_ROOT}/compiler/latest/bin:${PATH}"

WORKDIR /src

RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked,id=ccache-oneapi2026 \
    CCACHE_DIR=/root/.cache/ccache \
    CC=icx CXX=icpx meson setup /src/core/build core \
        --buildtype=release \
        --strip \
        -Denable_cuda=false \
        -Denable_sycl=true \
        -Denable_dnn=disabled \
        -Db_lto=false \
        -Dc_std=c2x \
        -Denable_avx512=true \
    && ninja -C /src/core/build -j"${VMAF_BUILD_JOBS}" \
    && mkdir -p /dist/lib /dist/bin /dist/model \
    && find /src/core/build/src -maxdepth 1 -name 'libvmaf.so*' -not -type d -exec cp {} /dist/lib/ \; \
    && cp /src/core/build/tools/vmaf /dist/bin/ \
    && cp -r model/. /dist/model/

# (ADR-0726: Vulkan backend removed; builder-vulkan stage deleted)

# ---------------------------------------------------------------------------
# CPU runtime base — distroless Debian 13
# ---------------------------------------------------------------------------
FROM ${RELEASE_RUNTIME_CC} AS runtime-base

LABEL org.opencontainers.image.title="vmafx"
LABEL org.opencontainers.image.description="VMAFX production GPU runtime"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"
LABEL org.opencontainers.image.licenses="BSD-3-Clause-Plus-Patent"
LABEL org.opencontainers.image.vendor="Lusoris"

ENV LD_LIBRARY_PATH="/usr/local/lib"
ENV VMAF_MODEL_PATH="/usr/local/share/vmafx/model"

# ---------------------------------------------------------------------------
# Final targets — one per GPU variant
# The CI workflow builds the appropriate target based on the tag suffix.
# ---------------------------------------------------------------------------

FROM runtime-base AS final-cpu
COPY --from=builder-cpu /dist/lib/   /usr/local/lib/
COPY --from=builder-cpu /dist/bin/   /usr/local/bin/
COPY --from=builder-cpu /dist/model/ /usr/local/share/vmafx/model/
# Drop privileges — distroless `nonroot` user (UID:GID 65532). Trivy DS-0002.
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/vmaf"]

FROM ${CUDA_RUNTIME} AS final-cuda13
LABEL org.opencontainers.image.title="vmafx"
LABEL org.opencontainers.image.description="VMAFX production CUDA 13.3.1 runtime"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"
LABEL org.opencontainers.image.licenses="BSD-3-Clause-Plus-Patent"
LABEL org.opencontainers.image.vendor="Lusoris"
ENV LD_LIBRARY_PATH="/usr/local/lib:/usr/local/cuda/lib64:/usr/local/nvidia/lib:/usr/local/nvidia/lib64"
ENV VMAF_MODEL_PATH="/usr/local/share/vmafx/model"
COPY --from=builder-cuda13 /dist/lib/   /usr/local/lib/
COPY --from=builder-cuda13 /dist/bin/   /usr/local/bin/
COPY --from=builder-cuda13 /dist/model/ /usr/local/share/vmafx/model/
# Drop privileges. CUDA device access (/dev/nvidia*) is granted via the
# NVIDIA Container Toolkit — `nonroot` UID 65532 still gets device access
# when the runtime injects /dev nodes with mode 0666.
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/vmaf"]

FROM ${ROCM_RUNTIME} AS final-rocm7
LABEL org.opencontainers.image.title="vmafx"
LABEL org.opencontainers.image.description="VMAFX production ROCm 7.2.4 runtime"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"
LABEL org.opencontainers.image.licenses="BSD-3-Clause-Plus-Patent"
LABEL org.opencontainers.image.vendor="Lusoris"
ENV LD_LIBRARY_PATH="/usr/local/lib:/opt/rocm/lib:/opt/rocm/lib64"
ENV VMAF_MODEL_PATH="/usr/local/share/vmafx/model"
COPY --from=builder-rocm7 /dist/lib/   /usr/local/lib/
COPY --from=builder-rocm7 /dist/bin/   /usr/local/bin/
COPY --from=builder-rocm7 /dist/model/ /usr/local/share/vmafx/model/
# Drop privileges. ROCm requires the host user to be a member of the
# `render` and `video` groups; the runtime image inherits this from the
# host group-mapping when `--group-add video,render` is passed.
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/vmaf"]

# Intel oneAPI 2026.1 runtime on the same Debian 13 base as every other release
# image, rather than intel/oneapi-runtime. Two measured reasons: Intel's runtime
# image stops at 2026.0.0, which is OLDER than the 2026.1 compiler above and so
# inverts the runtime >= compiler rule, and it is Ubuntu-only with a newer glibc
# than the binaries built above target.
#
# The NEO compute stack must be installed explicitly here. Intel's own runtime
# image bundles it; Debian does not package it. Without it libsycl loads
# perfectly and every device query then fails with "No device of requested type
# available" -- a silent fall off the GPU. ADR-1145 / ADR-1232.
FROM ${RELEASE_BUILDER_BASE} AS final-oneapi2026

ARG DEBIAN_FRONTEND=noninteractive
ARG ONEAPI_VERSION
ARG ONEAPI_APT_REPO
ARG ONEAPI_APT_GPG_URL
ARG INTEL_NEO_VERSION

LABEL org.opencontainers.image.title="vmafx"
LABEL org.opencontainers.image.description="VMAFX oneAPI 2026.1 runtime on Debian 13"
LABEL org.opencontainers.image.source="https://github.com/VMAFx/vmafx"
LABEL org.opencontainers.image.licenses="BSD-3-Clause-Plus-Patent"
LABEL org.opencontainers.image.vendor="Lusoris"

COPY dev/scripts/fetch-intel-neo.py /tmp/fetch-intel-neo.py
# The GitHub token is optional and only raises the anonymous API rate limit for
# the NEO release lookup. It arrives as a BuildKit secret rather than an ARG so
# it never lands in the image metadata.
# hadolint ignore=DL3003,DL3008,DL3009
RUN --mount=type=secret,id=github_token \
    apt-get update \
    && apt-get install -y --no-install-recommends curl gpg python3 ca-certificates \
    && curl -fsSL "${ONEAPI_APT_GPG_URL}" | gpg --dearmor \
         > /usr/share/keyrings/intel-sw-products.gpg \
    && printf 'deb [signed-by=/usr/share/keyrings/intel-sw-products.gpg] %s all main\n' \
         "${ONEAPI_APT_REPO}" > /etc/apt/sources.list.d/intel-oneapi.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
         "intel-oneapi-runtime-dpcpp-cpp=${ONEAPI_VERSION}" \
         intel-oneapi-umf \
         libze1 libva2 libva-drm2 intel-media-va-driver \
    && mkdir -p /tmp/neo && cd /tmp/neo \
    && GH_TOK="$(cat /run/secrets/github_token 2>/dev/null || true)" \
    && python3 /tmp/fetch-intel-neo.py --neo-ver "${INTEL_NEO_VERSION}" \
         ${GH_TOK:+--github-token "${GH_TOK}"} \
    && apt-get install -y --no-install-recommends ./*.deb \
    && cd / \
    && find /opt/intel/oneapi/umf -maxdepth 2 -type d -name lib \
         > /etc/ld.so.conf.d/intel-oneapi-umf.conf \
    && ldconfig \
    && apt-get purge -y curl gpg python3 && apt-get autoremove -y \
    && rm -rf "/tmp/neo" "/tmp/fetch-intel-neo.py" "/var/lib/apt/lists"

# Fail the build rather than ship an image that silently falls back to CPU.
#
# The package checks alone are not enough. `intel-oneapi-runtime-dpcpp-cpp` does
# NOT depend on `intel-oneapi-umf`, so libumf.so.1 goes missing and the Level
# Zero UR adapter fails to load -- with every NEO package correctly installed
# and every file present. The only symptom at runtime is "No device of requested
# type available", which reads like a driver or permissions problem and is not.
#
# The adapter-load check below reproduces that failure without a GPU: loading
# the adapter is what needs libumf, and it happens before any device is
# enumerated. `--version` is enough to trigger it.
COPY --from=builder-oneapi2026 /dist/bin/vmaf /tmp/vmaf-probe
RUN for pkg in intel-opencl-icd libze-intel-gpu1 intel-oneapi-umf; do \
        dpkg -l "${pkg}" 2>/dev/null | grep -q "^ii" \
            || (echo "FATAL: ${pkg} was not installed" && exit 1); \
    done \
    && test -e /opt/intel/oneapi/redist/lib/libsycl.so.9 \
    && ldconfig -p | grep -q libumf.so.1 \
    && SYCL_UR_TRACE=1 /tmp/vmaf-probe --version 2>&1 \
         | tee /tmp/ur.log | head -1 \
    && if grep -q "failed to load adapter" /tmp/ur.log; then \
           echo "FATAL: a SYCL adapter failed to load:"; \
           grep "failed to load adapter" /tmp/ur.log; \
           exit 1; \
       fi \
    && rm -f /tmp/vmaf-probe /tmp/ur.log

ENV LD_LIBRARY_PATH="/usr/local/lib:/opt/intel/oneapi/redist/lib"
ENV VMAF_MODEL_PATH="/usr/local/share/vmafx/model"
COPY --from=builder-oneapi2026 /dist/lib/   /usr/local/lib/
COPY --from=builder-oneapi2026 /dist/bin/   /usr/local/bin/
COPY --from=builder-oneapi2026 /dist/model/ /usr/local/share/vmafx/model/
# Drop privileges. Intel GPU access via /dev/dri/renderD* — group `render`
# needs to be passed via `--group-add` on `docker run`.
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/vmaf"]

# (ADR-0726: final-vulkan stage removed)
