# docker/Dockerfile.node-cpu — vmafx-node CPU-only runtime.
# Convenience wrapper around Dockerfile.node with GPU_RUNTIME=cpu.
#
# ADR-0713: vmafx-node Go worker binary.

FROM docker/Dockerfile.node AS node-cpu
ARG GPU_RUNTIME=cpu
