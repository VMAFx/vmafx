      ],
      "out": "/tmp/vmafx-smoke-second-opinion/smoke_table_a.jsonl",
      "audit_json": "/tmp/vmafx-smoke-second-opinion/smoke_table_a.audit.json"
    },
    {
      "id": "smoke_table_b",
      "features": "ai/testdata/smoke-second-opinion-batch/fixtures/features_b.jsonl",
      "scores": [
        "fork-nr=ai/testdata/smoke-second-opinion-batch/fixtures/scores_fork_nr_b.jsonl"
      ],
      "out": "/tmp/vmafx-smoke-second-opinion/smoke_table_b.jsonl"
    }
  ]
