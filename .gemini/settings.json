{
  "mcpServers": {
    "asdecided": {
      "args": [
        "decisions",
        "serve"
      ],
      "command": "praetorctl"
    },
    "vmafx-dev": {
      "args": [
        "exec",
        "-i",
        "vmaf-dev-mcp",
        "vmafx-mcp"
      ],
      "command": "docker"
    }
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "^run_shell_command$",
        "hooks": [
          {
            "type": "command",
            "command": "praetorctl hook gemini pre-tool",
            "timeout": 15000
          }
        ]
      }
    ]
  }
}
