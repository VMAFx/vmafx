{
  "//": "Disable MS C/C++ IntelliSense — clangd is the source of truth.",
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.autocomplete": "disabled",
  "C_Cpp.errorSquiggles": "disabled",
  "C_Cpp.formatting": "disabled",
  "C_Cpp.autoAddFileAssociations": false,

  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build",
    "--background-index",
    "--clang-tidy",
    "--clang-tidy-checks=-*,bugprone-*,cert-*,clang-analyzer-*,performance-*,portability-*",
    "--header-insertion=never",
    "--completion-style=detailed",
    "--function-arg-placeholders=true",
    "--pch-storage=memory",
    "-j=8"
  ],
  "clangd.path": "clangd",
  "clangd.fallbackFlags": [
    "-std=c11",
    "-I${workspaceFolder}/core/include",
    "-I${workspaceFolder}/core/src"
  ],
  "clangd.onConfigChanged": "restart",
  "clangd.checkUpdates": false,

  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[cuda-cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  "ruff.enable": true,
  "ruff.organizeImports": true,
  "python.analysis.typeCheckingMode": "basic",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["python/test", "ai/tests"],

  "editor.rulers": [100],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",

  "files.associations": {
    "*.cu": "cuda-cpp",
    "*.cuh": "cuda-cpp",
    "*.hip": "cuda-cpp",
    "*.metal": "cpp",
    "*.proto": "proto3",
    "*.tmpl": "helm",
    "meson.build": "meson",
    "meson_options.txt": "meson"
  },

  "files.watcherExclude": {
    "**/build/**": true,
    "**/build-san/**": true,
    "**/build-cpu/**": true,
    "**/build-cuda/**": true,
    "**/build-sycl/**": true,
    "**/build-all/**": true,
    "**/subprojects/*/**": true,
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/target/**": true,
    "${workspaceFolder}/bindings/rust/*/target/**": true
  },
  "search.exclude": {
    "**/build": true,
    "**/build-san": true,
    "**/build-cpu": true,
    "**/build-cuda": true,
    "**/build-sycl": true,
    "**/build-all": true,
    "**/subprojects": true,
    "**/.venv": true,
    "**/target": true
  },

  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": false
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[proto3]": {
    "editor.defaultFormatter": "zxh404.vscode-proto3",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  "go.lintTool": "golangci-lint",
  "go.lintFlags": ["--fast"],
  "go.formatTool": "gofmt",
  "go.toolsManagement.autoUpdate": false,

  "rust-analyzer.cargo.allTargets": true,
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.extraArgs": ["-D", "warnings"],

  "cmake.configureOnOpen": false,
  "cmake.sourceDirectory": "",
  "C_Cpp.default.compileCommands": "/home/kilian/dev/vmaf/core/builddir/compile_commands.json",
  "C_Cpp.default.configurationProvider": "mesonbuild.mesonbuild"
}
