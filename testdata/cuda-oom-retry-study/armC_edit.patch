# Arm C of the #3320 CUDA OOM retry study (PR #3336): variant of
# check_oom_and_memory_return() in the CUDA OOM test, kept as a patch so the
# variant is reproducible after a clean build (the campaign ran it reverted).
#
# Apply from the repository root of the build worktree (as-landed source at
# master b38635f63), rebuild and run testdata/cuda-oom-retry-study/run_armC.sh:
#   git apply testdata/cuda-oom-retry-study/armC_edit.patch
#   ninja -C build
#   bash testdata/cuda-oom-retry-study/run_armC.sh <build-worktree> <results-root>
# Revert the source afterwards: git checkout -- core/test/test_cuda_oom_pictures_released.c
diff --git a/core/test/test_cuda_oom_pictures_released.c b/core/test/test_cuda_oom_pictures_released.c
index c9f8031..c5998ae 100644
--- a/core/test/test_cuda_oom_pictures_released.c
+++ b/core/test/test_cuda_oom_pictures_released.c
@@ -28,11 +28,18 @@
 #include <errno.h>
 #include <stdio.h>
 #include <stdlib.h>
+#include <time.h>
 
 #ifndef _WIN32
 #include <unistd.h>
 #endif
 
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#endif
+
 #include "mu_table.h"
 #include "test.h"
 
@@ -51,6 +58,11 @@
 #define PROBE_BYTES ((size_t)FRAME_W * FRAME_H)
-#define WATCHDOG_SECONDS 60u
+/* Arm C adds a poll of up to ARM_C_BOUND_MS after the watched work; the POSIX
+ * watchdog keeps its 60 s for that work and adds the bound. */
+#define WATCHDOG_SECONDS (60u + ARM_C_BOUND_MS / 1000u)
 #define MAX_CHUNKS 4096u
+/* #3277 probe-perturbation A/B, arm C: bounded memory-return poll. */
+#define ARM_C_POLL_MS 20u
+#define ARM_C_BOUND_MS 60000u
 /* Chunk sizes, largest first; the driver keeps less than the smallest free. */
 static const size_t CHUNK_BYTES[] = {(size_t)1 << 30, (size_t)64 << 20, (size_t)4 << 20,
                                      (size_t)256 << 10};
@@ -61,6 +73,30 @@ typedef struct {
     size_t bytes;
 } Hog;
 
+static void sleep_ms(unsigned ms)
+{
+#ifdef _WIN32
+    Sleep(ms);
+#else
+    const struct timespec ts = {.tv_sec = ms / 1000u, .tv_nsec = (long)(ms % 1000u) * 1000000L};
+    (void)nanosleep(&ts, NULL);
+#endif
+}
+
+static long long now_ms(void)
+{
+#ifdef _WIN32
+    /* Monotonic since boot; mingw-w64's msvcrt time.h only offers
+     * timespec_get on UCRT builds, and the clock must not jump with it. */
+    return (long long)GetTickCount64();
+#else
+    struct timespec ts;
+    if (timespec_get(&ts, TIME_UTC) != TIME_UTC)
+        return 0;
+    return (long long)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+#endif
+}
+
 static int probe_alloc(const VmafCudaState *state, size_t bytes)
 {
     if (state->f->cuCtxPushCurrent(state->ctx) != CUDA_SUCCESS) {
@@ -155,16 +191,29 @@ static char *check_oom_and_memory_return(VmafCudaState *state, Hog *hog, int oom
                                          int probe_hogged)
 {
     hog_release(state, hog);
-    const int probe_back = probe_alloc(state, PROBE_BYTES);
-    (void)fprintf(stderr, "[hog %zu MiB, luma probe under hog %d, first rc %d, memory back %d] ",
-                  hog->bytes >> 20, probe_hogged, oom_err, probe_back);
+    /* #3277 probe-perturbation A/B, arm C: bounded poll for the memory return
+     * (local experiment, not for commit). The first probe counts as probe 0;
+     * the wait is measured, so a fast window reports "after 0.0 ms (0 probes)". */
+    const long long start_ms = now_ms();
+    int probe_back = probe_alloc(state, PROBE_BYTES);
+    unsigned probes = 0;
+    while (probe_back < 1 && now_ms() - start_ms < (long long)ARM_C_BOUND_MS) {
+        sleep_ms(ARM_C_POLL_MS);
+        probe_back = probe_alloc(state, PROBE_BYTES);
+        probes++;
+    }
+    (void)fprintf(stderr,
+                  "[hog %zu MiB, luma probe under hog %d, first rc %d, memory back %d after "
+                  "%.1f ms (%u probes)] ",
+                  hog->bytes >> 20, probe_hogged, oom_err, probe_back,
+                  (double)(now_ms() - start_ms), probes);
     mu_assert("a frame was scored with the device's memory taken", oom_err != 0);
     (void)fprintf(stderr, "[first frame with no memory left: %d] ", oom_err);
 
     /* The pair of the failed call is back in the pool, and the ring that could
      * not be built is built now. */
     mu_assert("allocation probe failed", probe_back >= 0);
-    mu_assert("device memory not yet returned after the hog was freed", probe_back == 1);
+    mu_assert("device memory not returned within the 60 s bound", probe_back == 1);
     return NULL;
 }
 
