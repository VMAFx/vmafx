{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "_comment_bootstrap_sha": "ONE-SHOT (ADR-1151). The fork has never released, so release-please has no previous tag to walk back to; this pins the commit-scan floor for the first cut only. scripts/release/rollover-changelog-fragments.sh deletes it in the release-merge PR, and the release-script-contract gate refuses to let it return once the manifest reaches 1.0.0.",
  "bootstrap-sha": "98dc0b2b830ab39a9fe724def9e8cd7a7f73fa29",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "package-name": "vmafx",
      "release-type": "simple",
      "_comment_release_as": "ONE-SHOT (ADR-1151). Forces the fork's FIRST release onto a fresh 1.0.0 number line; every vX.Y.Z tag currently reachable belongs to Netflix upstream history. release-as is a persistent, DEPRECATED override applied after commit analysis, so leaving it in place would pin every future release: scripts/release/rollover-changelog-fragments.sh deletes it in the release-merge PR and the release-script-contract gate refuses to let it return once the manifest reaches 1.0.0. Use a `Release-As: X.Y.Z` commit footer for any later forced version.",
      "release-as": "1.0.0",
      "skip-changelog": true,
      "versioning": "default",
      "prerelease": false,
      "bump-minor-pre-major": false,
      "bump-patch-for-minor-pre-major": false,
      "draft": true,
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "refactor", "section": "Refactors" },
        { "type": "docs", "section": "Documentation" },
        { "type": "test", "section": "Tests" },
        { "type": "build", "section": "Build System" },
        { "type": "ci", "section": "CI / Infrastructure" },
        { "type": "chore", "section": "Miscellaneous", "hidden": false },
        { "type": "revert", "section": "Reverts" },
        { "type": "security", "section": "Security" },
        { "type": "style", "section": "Style" },
        { "type": "port", "section": "Ports from upstream Netflix/vmaf" },
        { "type": "sycl", "section": "SYCL Backend" },
        { "type": "cuda", "section": "CUDA Backend" },
        { "type": "simd", "section": "SIMD" }
      ],
      "extra-files": [
        { "type": "generic", "path": "core/meson.build" },
        { "type": "generic", "path": "compat/python-vmaf/__init__.py" },
        { "type": "generic", "path": "ai/pyproject.toml" },
        { "type": "generic", "path": "ai/src/vmaf_train/__init__.py" },
        { "type": "generic", "path": "dev-llm/pyproject.toml" },
        { "type": "generic", "path": "dev-llm/src/vmaf_dev_llm/__init__.py" },
        { "type": "generic", "path": "mcp-server/vmaf-mcp/pyproject.toml" },
        { "type": "generic", "path": "mcp-server/vmaf-mcp/src/vmaf_mcp/__init__.py" },
        { "type": "generic", "path": "deploy/helm/vmafx/Chart.yaml" }
      ]
    }
  },
  "plugins": ["sentence-case"]
}
